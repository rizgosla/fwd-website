---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  /** Path under /public to a 1200x630 share image. Defaults to /og/default.jpg. */
  ogImage?: string;
}

const {
  title = "Web Design in Orange County | Forward Design Consulting",
  description = "Forward Design Consulting builds clean, fast websites for Orange County businesses. A small studio, flat fee, no retainers.",
  /* Every page gets a share image whether or not it asks for one. Left
     undefined, a link pasted into LinkedIn or iMessage renders as a bare
     text card, which reads as an unfinished site regardless of the copy. */
  ogImage = "/og/default.jpg",
} = Astro.props;

/* Self-referencing canonical. Without this, www/non-www and trailing-slash
   variants of the same page split their ranking signal between each other. */
const canonical = new URL(Astro.url.pathname, Astro.site).href;
/* og:image must be an absolute URL — the spec requires it and most scrapers
   will not resolve a root-relative path against the page they fetched. */
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined;
/* Constant rather than derived from `title`: the alt describes the artwork in
   the card, which is the same picture on every page, not the page's subject. */
const ogImageAlt =
  "Forward Design Consulting — web design studio serving Orange County, California";

/* Declared once and reused by both the Organization and the LocalBusiness.
   These two entities describe the same real company, so a profile URL that
   drifted between them would look like two different businesses to a
   crawler — the same inconsistent-NAP failure that breaks local ranking. */
const sameAs = [
  "https://www.linkedin.com/company/forward-design-consulting-llc",
];

/* Structured data as a single @graph rather than a lone business node.
   Three separate concerns are being asserted and Google reads them from
   different entity types:
     - Organization  — who the company is, for the Knowledge Panel and for
       anything that needs a stable publisher to point at.
     - WebSite       — what this *site* is called. The site name Google
       prints above the URL in a result comes from here, not from <title>.
     - LocalBusiness — the Orange County web design studio, which is what
       distinguishes this "Forward Design Consulting" from the architecture
       practice in Kansas City with nearly the same name.
   They are wired together by @id so Google treats them as one company with
   three facets instead of three unrelated things that happen to share a name.

   ProfessionalService was used here before. schema.org has since deprecated
   it as a vague catch-all and Google's LocalBusiness documentation no longer
   references it, so the concrete LocalBusiness type replaces it.

   NAP values below must stay identical to the Google Business Profile
   listing — inconsistent name/address/phone data is what breaks local
   ranking, and it breaks it silently.

   Three properties are omitted on purpose, not by oversight:
     - openingHoursSpecification — we have no verified, published hours.
       Invented hours are a factual claim we would have to honour.
     - geo — there is no public office. A lat/long would assert a physical
       location that a customer could show up to, and none exists.
     - aggregateRating / review — Google prohibits self-serving review
       markup on your own business, and there are no real reviews to cite. */
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://fwddesignconsulting.com/#organization",
      name: "Forward Design Consulting",
      url: "https://fwddesignconsulting.com",
      /* Logo as a full ImageObject with explicit dimensions: Google requires
         a logo it can fetch and measure, and the bare-URL shorthand leaves
         it guessing at the aspect ratio. */
      logo: {
        "@type": "ImageObject",
        url: "https://fwddesignconsulting.com/icon-512.png",
        width: 512,
        height: 512,
      },
      image: "https://fwddesignconsulting.com/og/default.jpg",
      sameAs,
      contactPoint: {
        "@type": "ContactPoint",
        telephone: "+1-949-529-6035",
        contactType: "customer service",
        areaServed: "US",
        availableLanguage: "English",
      },
    },
    {
      "@type": "WebSite",
      "@id": "https://fwddesignconsulting.com/#website",
      url: "https://fwddesignconsulting.com",
      name: "Forward Design Consulting",
      publisher: { "@id": "https://fwddesignconsulting.com/#organization" },
      /* No potentialAction/SearchAction here. Google retired the sitelinks
         searchbox on 2024-11-21, so that markup is now inert weight. */
    },
    {
      "@type": "LocalBusiness",
      "@id": "https://fwddesignconsulting.com/#localbusiness",
      name: "Forward Design Consulting",
      description:
        "Web design studio serving Orange County, California. Flat-fee websites for small businesses and practices.",
      url: "https://fwddesignconsulting.com",
      telephone: "+1-949-529-6035",
      email: "fwddesignconsulting@gmail.com",
      priceRange: "$$",
      image: "https://fwddesignconsulting.com/og/default.jpg",
      /* LocalBusiness requires an address, so this is the service area only —
         no street line, because there is no walk-in office. Deliberately the
         county rather than a city: every visible mention on the site says
         "Orange County", and the one thing that reliably breaks local ranking
         is the markup disagreeing with the copy or the Business Profile. */
      address: {
        "@type": "PostalAddress",
        addressLocality: "Orange County",
        addressRegion: "CA",
        addressCountry: "US",
      },
      sameAs,
      parentOrganization: {
        "@id": "https://fwddesignconsulting.com/#organization",
      },
      /* The county is an AdministrativeArea, not a City — it was typed as one
         alongside the cities before, which asserts a place that doesn't
         exist. The cities stay City. */
      areaServed: [
        ...[
          "Irvine",
          "Newport Beach",
          "Costa Mesa",
          "Tustin",
          "Santa Ana",
          "Anaheim",
          "Huntington Beach",
        ].map((name) => ({ "@type": "City", name })),
        { "@type": "AdministrativeArea", name: "Orange County" },
      ],
      knowsAbout: [
        "Web design",
        "Website redesign",
        "Small business websites",
        "Responsive web design",
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0D2F45" />
    <link rel="canonical" href={canonical} />

    {/* Open Graph / Twitter — without these, a link shared to LinkedIn, Slack
        or iMessage renders as a bare URL with no title, blurb or image. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Forward Design Consulting" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    {/* Guards kept even though ogImage now defaults: a page can still opt out
        by passing ogImage={undefined} explicitly, and an og:image tag with an
        empty content attribute is worse than no tag at all. */}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}
    {ogImageUrl && <meta property="og:image:alt" content={ogImageAlt} />}
    {ogImageUrl && <meta property="og:image:type" content="image/jpeg" />}
    <meta
      name="twitter:card"
      content={ogImageUrl ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    {/* Organization + WebSite + LocalBusiness graph. Sitewide rather than
        homepage-only so the entity is reinforced on whichever page Google
        crawls first. */}
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />

    {/* Favicons as real files. The previous mark was an inline data: URI,
        which renders fine in a browser tab but has no URL for Googlebot to
        fetch — so it could never appear beside the result in search. These
        paths must exist under /public.
        .ico covers legacy browsers and is what Google prefers to crawl,
        .svg scales and can respond to dark mode, the apple-touch-icon is
        used when the site is saved to an iOS home screen, and the manifest
        supplies the name and larger icons for Android install prompts. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Fonts: Fraunces (display serif) + Inter Tight (body).
        Oswald + Lora are loaded too — the hero showcase renders shipped sites
        in their *own* type (e.g. Burnt Crumbs uses Oswald display + Lora serif)
        so each preview reads like the real, live site. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Loaded non-render-blocking: on slow/mobile connections a plain
        <link rel="stylesheet"> to a third-party origin holds first paint
        until it resolves, which can leave the page blank for seconds.
        The preload+media swap trick fetches it without blocking, applies it
        once ready, and the fallback stacks above keep text visible either way. */}
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..700,0..100;1,9..144,300..700,0..100&family=Inter+Tight:ital,wght@0,300..700;1,300..700&family=Oswald:wght@400;500;600;700&family=Lora:ital,wght@0,400;0,500;0,700;1,400;1,500;1,700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..700,0..100;1,9..144,300..700,0..100&family=Inter+Tight:ital,wght@0,300..700;1,300..700&family=Oswald:wght@400;500;600;700&family=Lora:ital,wght@0,400;0,500;0,700;1,400;1,500;1,700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..700,0..100;1,9..144,300..700,0..100&family=Inter+Tight:ital,wght@0,300..700;1,300..700&family=Oswald:wght@400;500;600;700&family=Lora:ital,wght@0,400;0,500;0,700;1,400;1,500;1,700&display=swap"
      />
    </noscript>
    {/* [data-mv-watch] holds elements at opacity:0 until the observer below
        releases them. Without this, a failed or disabled script would leave
        most of the site's content invisible rather than merely unanimated. */}
    <noscript><style>[data-mv-watch]{opacity:1!important}</style></noscript>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>

    <Nav />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer />

    {/* Tiny inline scripts — small enough that bundling and shipping a separate
        file would cost more than just inlining. is:inline keeps them out of the
        Astro build pipeline. */}
    <script is:inline>
      // === Mobile nav toggle =================================================
      const toggle = document.getElementById("navToggle");
      const links = document.getElementById("navLinks");
      if (toggle && links) {
        const setMenu = (open) => {
          links.classList.toggle("is-open", open);
          toggle.classList.toggle("is-open", open);
          toggle.setAttribute("aria-expanded", String(open));
          // The icon animates into an X, so its accessible name has to follow.
          toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
        };
        const close = () => setMenu(false);

        toggle.addEventListener("click", () => setMenu(!links.classList.contains("is-open")));

        // Same-page anchors and client-side navigation both leave the panel
        // open otherwise, which reads as a menu that will not close.
        links.querySelectorAll("a").forEach((a) => a.addEventListener("click", close));

        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && links.classList.contains("is-open")) {
            close();
            toggle.focus();
          }
        });
        document.addEventListener("click", (e) => {
          if (!links.classList.contains("is-open")) return;
          if (links.contains(e.target) || toggle.contains(e.target)) return;
          close();
        });
        // Crossing back above the breakpoint restores the inline row; a
        // leftover .is-open would keep announcing an expanded disclosure.
        window.addEventListener("resize", () => {
          if (window.innerWidth > 820) close();
        }, { passive: true });
      }

      // === Sticky-nav scrolled state =========================================
      const navEl = document.getElementById("nav");
      const setNavScrolled = () => {
        navEl?.classList.toggle("is-scrolled", window.scrollY > 8);
      };
      window.addEventListener("scroll", setNavScrolled, { passive: true });
      setNavScrolled();

      // === Card mouse-spotlight effect =======================================
      // Any element marked [data-tilt] gets --mx/--my as percentages, used by
      // the radial-gradient hover sheen, plus --tiltx/--tilty as unitless
      // -1..1 values. The second pair exists because CSS cannot convert a
      // percentage into deg inside calc(), so a rotation needs a raw number.
      document.querySelectorAll("[data-tilt]").forEach((card) => {
        card.addEventListener("mousemove", (e) => {
          const rect = card.getBoundingClientRect();
          const x = (e.clientX - rect.left) / rect.width;
          const y = (e.clientY - rect.top) / rect.height;
          card.style.setProperty("--mx", x * 100 + "%");
          card.style.setProperty("--my", y * 100 + "%");
          card.style.setProperty("--tiltx", (x - 0.5) * 2);
          card.style.setProperty("--tilty", (y - 0.5) * 2);
        });
        card.addEventListener("mouseleave", () => {
          card.style.setProperty("--tiltx", 0);
          card.style.setProperty("--tilty", 0);
        });
      });

      // === Scroll-driven motion ==============================================
      // Elements marked [data-mv-watch] are held at opacity:0 until they enter
      // the viewport, then their .mv-* class runs. One observer for the whole
      // page — motion stays inside the shared vocabulary in global.css.
      const mvTargets = document.querySelectorAll("[data-mv-watch]");
      if (mvTargets.length && "IntersectionObserver" in window) {
        const mvIo = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-inview");
                mvIo.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.15 }
        );
        mvTargets.forEach((el) => mvIo.observe(el));
      }
    </script>
  </body>
</html>
