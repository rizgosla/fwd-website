---
// Auto-generated from site/index.html — round 4 design.
// Edit page-level markup here; shared components live in src/components.
import BaseLayout from "../layouts/BaseLayout.astro";
import Marquee from "../components/Marquee.astro";
import HeroShowcase from "../components/HeroShowcase.astro";
import CtaClose from "../components/CtaClose.astro";
import BrandMark from "../components/BrandMark.astro";
import BrandWall from "../components/BrandWall.astro";
import { Image } from "astro:assets";

/* eager so the parsed list is available at build time rather than as promises.
   Astro processes each one — the 1.4MB source PNGs ship as ~90KB WebP. */
const modules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/work-shots/*.{png,jpg,jpeg,webp,avif}",
  { eager: true },
);

const BADGES: Record<string, string> = {
  mockup: "Mockup",
  "in-progress": "In progress",
};

/* What each shot actually covered. On a phone the card is a disclosure and
   this is what a tap reveals, so the band says something about the work
   rather than just showing a picture of it. Keyed by the filename's slug. */
const WORK_DETAIL: Record<string, { kind: string; tags: string[] }> = {
  "oasis-dental": {
    kind: "Client site · Dental practice",
    tags: ["Full site", "Design system", "Photography direction", "Booking flow", "Local SEO"],
  },
  "burnt-crumbs": {
    kind: "Self-directed redesign · Restaurant",
    tags: ["Brand-led art direction", "Menu architecture", "Ordering flow", "Mobile-first layout"],
  },
};

/* Filename carries everything: "02-burnt-crumbs--mockup.jpg" is the second
   shot, captioned "Burnt Crumbs", badged "Mockup". A numeric prefix orders the
   set and is stripped from the caption; a `--suffix` marks work that is not a
   launched client site. */
const shots = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => {
    const stem = path.split("/").pop()!.replace(/\.[^.]+$/, "");
    const [name, flag] = stem.replace(/^\d+[-_]?/, "").split("--");
    return {
      src: mod.default,
      slug: name,
      detail: WORK_DETAIL[name],
      caption: name
        .split("-")
        .filter(Boolean)
        .map((w) => w[0].toUpperCase() + w.slice(1))
        .join(" "),
      badge: flag ? BADGES[flag] : undefined,
    };
  });

/* Fixed, so the tilt of a given shot never changes between builds. */
const TILTS = [-3.5, 2.5, -1.5, 3, -2.5, 1.5, -4, 2];
/* Chip order is the reading order from the current markup. `slug` used to be
   the join key between a chip and its map pin; the pins are gone now that the
   map is drawn at state scale, so it survives only as a stable hook. */
const cities = [
  { name: "Newport Beach", slug: "newport-beach" },
  { name: "Costa Mesa", slug: "costa-mesa" },
  { name: "Irvine", slug: "irvine" },
  { name: "Tustin", slug: "tustin" },
  { name: "Santa Ana", slug: "santa-ana" },
  { name: "Orange", slug: "orange" },
  { name: "Anaheim", slug: "anaheim" },
  { name: "Huntington Beach", slug: "huntington-beach" },
];
---

<BaseLayout
  title="Web Design in Orange County | Forward Design Consulting"
  description="A small web design studio in Orange County building fast, flat-fee websites for local businesses. One price, about four weeks, and you own everything."
  ogImage="/og/home.jpg"
>
<!-- ============ HERO with idle motion baked in ============ -->
  <section class="hero-outer">
    {/* The hero's field lives INSIDE the showcase panel now (see
        HeroShowcase.astro), the same way the work band's lives inside its
        stage. A second wall out here would put the mark in two places in one
        hero, and behind the headline at that. */}
    <div class="hero">
      <div class="hero-left">
        <h1 class="display hero-title">
          Your Website is The New<br />
          <span class="hero-swap">
            <span class="hero-swap-item"><em>Storefront</em>.</span>
            <span class="hero-swap-item" aria-hidden="true"><em>Business Card</em>.</span>
            <span class="hero-swap-item" aria-hidden="true"><em>Firm Handshake</em>.</span>
            <span class="hero-swap-item" aria-hidden="true"><em>Fancy Suit</em>.</span>
          </span>
        </h1>
        <p class="lede hero-lede">Make the best <em>first impression</em>.</p>
        <div class="hero-actions">
          <a href="/services" class="btn btn-primary">See services <span class="arrow">→</span></a>
          <a href="/contact" class="btn btn-ghost">Start a project</a>
        </div>
      </div>

      <div class="hero-right">
        <HeroShowcase />
      </div>
    </div>
  </section>

  <!-- ============ MARQUEE (reverted to original phrase Marquee component) ============ -->
  <Marquee />

  <!-- ============ HERO META STRIP ============ -->
  <section class="meta-strip">
    <div class="full">
      <div class="meta-strip-grid mv-stagger" data-mv-watch>
        <div class="meta-cell">
          <span class="meta-key">Studio size</span>
          <strong class="meta-val">Agency Style: Personalized team for every need</strong>
        </div>
        <div class="meta-cell">
          <span class="meta-key">Typical turnaround</span>
          <strong class="meta-val">About 4 weeks</strong>
        </div>
        <div class="meta-cell">
          <span class="meta-key">Pricing model</span>
          <strong class="meta-val">Flat fee, no retainers</strong>
        </div>
        <div class="meta-cell">
          <span class="meta-key">Hosting &amp; domain</span>
          <strong class="meta-val">Set up &amp; included</strong>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SERVICES preview — bento spec sheet ============ -->
  <section id="services" class="section section-offer">
    <div class="full">
      <div class="section-head mv-rise" data-mv-watch>
        <h2 class="display section-title">A whole website, <em>one number</em>.</h2>
        <p class="section-sub">No retainers, no scope creep, no hidden hourlies. You bring the brand and the words — we design, build, and ship it.</p>
      </div>

      <div class="offer-bento mv-stagger" data-mv-watch>
        <!-- Centerpiece: the offer + price + CTA -->
        <article class="bento-card bento-headline" data-tilt>
          <span class="tier-sheen" aria-hidden="true"></span>
          <div class="bh-top">
            <span class="bh-eyebrow"><span class="live-dot" aria-hidden="true"></span>The offer</span>
            <span class="bh-meta">~3–4 weeks · up to 8 pages</span>
          </div>
          <div class="bh-body">
            <h3 class="bh-title">Full <em>Site</em></h3>
            <div class="bh-price">
              <span class="bh-dollar">$</span><span class="bh-amount" id="bhAmount" data-target="6000">6,000</span>
            </div>
            <p class="bh-note">Flat fee. Three rounds of revisions. You own everything when we're done.</p>
          </div>
          <div class="bh-foot">
            <a href="/services" class="bh-cta">
              <span>See the full scope</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
            <div class="bh-ticker" aria-hidden="true">
              <div class="bh-ticker-track">
                <span>Flat fee</span><span class="dot">●</span>
                <span>No retainers</span><span class="dot">●</span>
                <span>3 revision rounds</span><span class="dot">●</span>
                <span>You own it all</span><span class="dot">●</span>
                <span>Flat fee</span><span class="dot">●</span>
                <span>No retainers</span><span class="dot">●</span>
                <span>3 revision rounds</span><span class="dot">●</span>
                <span>You own it all</span><span class="dot">●</span>
              </div>
            </div>
          </div>
        </article>

        <!-- Feature tiles — each its own spotlight -->
        <article class="bento-card bento-feature" data-tilt>
          <span class="tier-sheen" aria-hidden="true"></span>
          <span class="bf-num">i.</span>
          <h4 class="bf-title">Up to <em>8 pages</em></h4>
          <p class="bf-body">Designed cohesively around your brand and content.</p>
        </article>

        <article class="bento-card bento-feature" data-tilt>
          <span class="tier-sheen" aria-hidden="true"></span>
          <span class="bf-num">ii.</span>
          <h4 class="bf-title">Design <em>system</em></h4>
          <p class="bf-body">Type, color, and components — built to last past launch.</p>
        </article>

        <article class="bento-card bento-feature" data-tilt>
          <span class="tier-sheen" aria-hidden="true"></span>
          <span class="bf-num">iii.</span>
          <h4 class="bf-title">Lead <em>capture</em></h4>
          <p class="bf-body">Forms wired to your inbox the day the site goes live.</p>
        </article>

        <article class="bento-card bento-feature" data-tilt>
          <span class="tier-sheen" aria-hidden="true"></span>
          <span class="bf-num">iv.</span>
          <h4 class="bf-title">Mobile + <em>SEO</em></h4>
          <p class="bf-body">Optimized at every breakpoint, on-page SEO baked in.</p>
        </article>

        <article class="bento-card bento-feature" data-tilt>
          <span class="tier-sheen" aria-hidden="true"></span>
          <span class="bf-num">v.</span>
          <h4 class="bf-title">Hosting + <em>domain</em></h4>
          <p class="bf-body">Set up, connected, and included from launch day.</p>
        </article>

        <article class="bento-card bento-feature" data-tilt>
          <span class="tier-sheen" aria-hidden="true"></span>
          <span class="bf-num">vi.</span>
          <h4 class="bf-title">Handoff <em>doc</em></h4>
          <p class="bf-body">So anyone on your team can update content later.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ SELECTED WORK — cursor gallery ============ -->
  <section class="section wk-band">
    <div class="full">
      <div class="section-head mv-rise" data-mv-watch>
        <div class="section-head-lead">
          <span class="section-eyebrow"><span class="section-eyebrow-bar"></span>Selected work</span>
          <h2 class="display section-title">The work <em>so far</em>.</h2>
        </div>
        <p class="section-sub">
          Client sites, a build still in progress, and a redesign we made on our own
          time. Each one labeled, so you can tell which is which.
        </p>
      </div>

      {shots.length === 0 ? (
        /* The folder is empty. Says so plainly rather than rendering a dead
           band — and names the fix, since the fix is dropping in a file. */
        <p class="wk-empty">
          No shots yet. Drop an image into <code>src/assets/work-shots</code> and it
          appears here.
        </p>
      ) : (
        /* The entrance animates the STAGE, never the shots. .mv-stagger puts
            `animation: mvRise ... forwards` on each child, and a filled
            animation outranks normal declarations — so it would pin every
            shot's opacity and transform at the animation's end state and the
            cursor effect below could never move them. */
        <div class="wk-stage mv-rise" data-mv-watch data-wk-stage>
          {/* The drifting mark lives INSIDE the stage, and it is what the
              stage's blueprint grid used to be. The grid was a third copy of
              a texture the hero panel and the closing CTA already carry; the
              wall says the studio's name instead, and it stays within the
              stage's rounded border rather than washing across the whole
              band — so the field reads as the surface the work is dropped
              onto, and the ink around it stays flat.

              .bw is absolutely positioned and aria-hidden. The prompt, the
              trail and the shots all sit above it on their own z-index. */}
          <BrandWall tone="ink" mask="full" opacity={0.55} rows={16} angle={-12} />

          <div class="wk-prompt" aria-hidden="true">
            <span class="wk-prompt-line"></span>
            <span class="wk-prompt-text">Move your cursor</span>
          </div>

          {/* The trail layer. Empty in the markup on purpose: it is pure
              decoration, built by the script only once the stage arms, and
              never carries content a reader or a no-JS visitor needs — that
              lives in the real list below. */}
          <div class="wk-trail" aria-hidden="true" data-wk-trail></div>

          {/* A real list, always. On a pointer device at desktop widths the CSS
              lifts it out of flow and the script swaps shots under the cursor;
              everywhere else it stays a plain grid of captioned images. The
              markup does not change between the two — only the layout does, so
              a screen reader and a no-JS visitor get the same complete set. */}
          <ul class="wk-shots">
            {shots.map((shot, i) => (
              <li class="wk-shot" style={`--r: ${TILTS[i % TILTS.length]}deg`}>
                <span class="wk-shot-frame">
                  <Image
                    class="wk-shot-img"
                    src={shot.src}
                    alt={shot.caption}
                    widths={[320, 640, 960]}
                    sizes="(min-width: 900px) 340px, 92vw"
                    loading="lazy"
                    decoding="async"
                  />
                </span>
                {/* On a phone the caption is the disclosure's button and the
                    panel below it carries what the work covered. Above the
                    touch breakpoint the button is styled flat and the panel is
                    always open, so nothing is hidden behind a tap on desktop. */}
                <button class="wk-shot-cap" type="button" aria-expanded="false" data-wk-toggle>
                  <span class="wk-shot-name">
                    {shot.caption}
                    {shot.badge && <span class="wk-pill">{shot.badge}</span>}
                  </span>
                  <span class="wk-shot-cue" aria-hidden="true">
                    <span class="wk-shot-cue-open">Tap to see the work</span>
                    <span class="wk-shot-cue-close">Tap to close</span>
                    <span class="wk-shot-chev">→</span>
                  </span>
                </button>
                {shot.detail && (
                  <div class="wk-shot-detail">
                    <div class="wk-shot-detail-inner">
                      <span class="wk-shot-kind">{shot.detail.kind}</span>
                      <ul class="wk-tags">
                        {shot.detail.tags.map((tag) => <li class="wk-tag">{tag}</li>)}
                      </ul>
                    </div>
                  </div>
                )}
              </li>
            ))}
          </ul>
        </div>
      )}

      <p class="wk-foot mv-rise" data-mv-watch>
        <a class="link-arrow" href="/work">See all work<span class="arrow" aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <!-- ============ PROCESS — 4-up grid, one card expands at a time ============ -->
  <section class="section section-process">
    <div class="full">
      {/* Wrapped so this head sits on the same two-column .section-head grid as
          the offer and service-area heads — eyebrow + title in column one, the
          sub in column two. It used to be a full-width flex column, which put
          three section heads on the page with three different measures. */}
      <div class="section-head mv-rise" data-mv-watch>
        <div class="section-head-lead">
          <span class="section-eyebrow"><span class="section-eyebrow-bar"></span>The process</span>
          <h2 class="display section-title">A simple, <em>honest</em> process.</h2>
        </div>
        <p class="section-sub">Four steps. About a month, start to live. No long discovery, no kickoff deck, no signed contract for a chat.</p>
      </div>

      {/* Four cards in one row that trade space with each other.

          At rest each card IS its step's mockup: numeral, step, title, then the
          graphic filling everything below them. Hover or focus brings the words
          — summary, detail and caption — up over the graphic on an ink panel.
          The graphic is the card's identity; the copy is what you get for
          asking.

          Each card's head is a real link, so the reveal is reachable with Tab
          (:focus-within, not :hover alone). The copy is *clipped* by the
          window's overflow, never hidden — no display:none, no
          visibility:hidden — so a screen reader reads all four cards in full
          whatever the visual state. Below 1040px, and under reduced motion at
          any width, the panel is a plain block in the flow and every card
          stands open. */}
      <ol class="process-grid mv-rise" data-mv-watch>
        <li class="process-card">
          <a class="pc-head" href="/services">
            <span class="pc-glyph" aria-hidden="true">i.</span>
            <span class="pc-step">Step 01<span class="pc-cue" aria-hidden="true">→</span></span>
            <h3 class="pc-title">A short call.</h3>
            <span class="pc-hint" aria-hidden="true">
              <span class="pc-hint-open">Tap to learn more</span>
              <span class="pc-hint-close">Tap to close</span>
            </span>
          </a>
          <div class="pc-window">
            <div class="pc-reveal">
              <p class="pc-body">15 minutes. We learn about your work, who you serve, and what you'd like the site to do for you.</p>
              <p class="pc-more">No deck, no discovery phase, no contract to have a conversation. If we're not the right fit, we'll say so on the call.</p>
              <span class="pc-meta">— No prep required</span>
              <a class="pc-link-out" href="/services">See the full scope <span class="arrow" aria-hidden="true">→</span></a>
            </div>
          <div class="pc-visual" aria-hidden="true">
            <div class="pc-stage">
              <div class="ps-visual-frame ps-frame-call">
                <div class="ps-cal">
                  <div class="ps-cal-head">
                    <div class="ps-cal-head-l">
                      <span class="ps-cal-eyebrow">Pick a time that works</span>
                      <h4 class="ps-cal-month">May 2026</h4>
                    </div>
                    <span class="ps-cal-pill">15 MIN · INTRO</span>
                  </div>
                  <div class="ps-cal-dow"><span>S</span><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span></div>
                  <div class="ps-cal-grid">
                    <span class="off">26</span><span class="off">27</span><span class="off">28</span><span class="off">29</span><span class="off">30</span><span>1</span><span>2</span>
                    <span>3</span><span class="avail">4</span><span class="avail">5</span><span>6</span><span class="avail">7</span><span class="avail">8</span><span>9</span>
                    <span>10</span><span class="avail">11</span><span>12</span><span class="avail">13</span><span class="avail picked">14</span><span class="avail">15</span><span>16</span>
                    <span>17</span><span>18</span><span class="avail">19</span><span class="avail">20</span><span class="avail">21</span><span>22</span><span>23</span>
                    <span>24</span><span class="avail">25</span><span class="avail">26</span><span>27</span><span class="avail">28</span><span class="avail">29</span><span>30</span>
                  </div>
                  <div class="ps-cal-foot">
                    <div class="ps-cal-slot">
                      <span class="ps-cal-slot-dot"></span>
                      <div class="ps-cal-slot-meta">
                        <span class="ps-cal-slot-day">Thursday, May 14</span>
                        <span class="ps-cal-slot-time">2:00 PM EST</span>
                      </div>
                      <span class="ps-cal-slot-cta">Confirmed →</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          </div>
        </li>

        <li class="process-card">
          <a class="pc-head" href="/services">
            <span class="pc-glyph" aria-hidden="true">ii.</span>
            <span class="pc-step">Step 02<span class="pc-cue" aria-hidden="true">→</span></span>
            <h3 class="pc-title">Design draft <em>in your browser</em>.</h3>
            <span class="pc-hint" aria-hidden="true">
              <span class="pc-hint-open">Tap to learn more</span>
              <span class="pc-hint-close">Tap to close</span>
            </span>
          </a>
          <div class="pc-window">
            <div class="pc-reveal">
              <p class="pc-body">A first version, built around your brand and content. You see real layouts in a real browser — not Figma squiggles, not mockup screenshots.</p>
              <p class="pc-more">It arrives as a live draft URL. Open it on your phone, send it to a business partner, click every link. What you're looking at is the site that ships.</p>
              <span class="pc-meta">— Delivered in week one</span>
              <a class="pc-link-out" href="/services">See the full scope <span class="arrow" aria-hidden="true">→</span></a>
            </div>
          <div class="pc-visual" aria-hidden="true">
            <div class="pc-stage">
              <div class="ps-visual-frame ps-frame-draft">
                <div class="ps-draft">
                  <div class="ps-draft-chrome">
                    <div class="ps-draft-dots"><span></span><span></span><span></span></div>
                    <div class="ps-draft-url"><span class="ps-draft-lock"></span>draft.fwddesignconsulting.com</div>
                    <span class="ps-draft-tag">DRAFT · V1</span>
                  </div>
                  <div class="ps-draft-body">
                    <div class="ps-draft-nav">
                      <div class="ps-draft-logo"></div>
                      <div class="ps-draft-links"><span></span><span></span><span></span><span></span></div>
                      <div class="ps-draft-navcta"></div>
                    </div>
                    <div class="ps-draft-hero">
                      <div class="ps-draft-eye"></div>
                      <div class="ps-draft-h1"></div>
                      <div class="ps-draft-h1 w2"></div>
                      <div class="ps-draft-lede"></div>
                      <div class="ps-draft-lede short"></div>
                      <div class="ps-draft-cta mv-sweep"></div>
                    </div>
                    <div class="ps-draft-cards">
                      <div class="ps-draft-card"><span></span><span class="sm"></span></div>
                      <div class="ps-draft-card"><span></span><span class="sm"></span></div>
                      <div class="ps-draft-card"><span></span><span class="sm"></span></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          </div>
        </li>

        <li class="process-card">
          <a class="pc-head" href="/services">
            <span class="pc-glyph" aria-hidden="true">iii.</span>
            <span class="pc-step">Step 03<span class="pc-cue" aria-hidden="true">→</span></span>
            <h3 class="pc-title">Three rounds of <em>revisions</em>.</h3>
            <span class="pc-hint" aria-hidden="true">
              <span class="pc-hint-open">Tap to learn more</span>
              <span class="pc-hint-close">Tap to close</span>
            </span>
          </a>
          <div class="pc-window">
            <div class="pc-reveal">
              <p class="pc-body">Comments in the margin, edits the same week. Three rounds are included — we adjust until it feels right, then lock it.</p>
              <p class="pc-more">Leave notes whenever it suits you. We work through them in batches instead of chasing you for approvals, and nothing here is billed by the hour.</p>
              <span class="pc-meta">— Async, on your time</span>
              <a class="pc-link-out" href="/services">See the full scope <span class="arrow" aria-hidden="true">→</span></a>
            </div>
          <div class="pc-visual" aria-hidden="true">
            <div class="pc-stage">
              <div class="ps-visual-frame ps-frame-rev">
                <div class="ps-rev">
                  <div class="ps-rev-doc">
                    <div class="ps-rev-doc-head">
                      <span class="ps-rev-doc-tab">draft.fwddesignconsulting.com</span>
                      <span class="ps-rev-doc-saved">Saved · 2m ago</span>
                    </div>
                    <div class="ps-rev-doc-body">
                      <div class="ps-rev-eye"></div>
                      <div class="ps-rev-h"></div>
                      <div class="ps-rev-line" style="width:98%"></div>
                      <div class="ps-rev-line edit" style="width:92%"><span class="ps-rev-caret"></span></div>
                      <div class="ps-rev-line struck" style="width:82%"></div>
                      <div class="ps-rev-line added" style="width:95%"></div>
                      <div class="ps-rev-line" style="width:88%"></div>
                      <div class="ps-rev-line" style="width:73%"></div>
                      <div class="ps-rev-h sub" style="width:44%"></div>
                      <div class="ps-rev-line" style="width:96%"></div>
                      <div class="ps-rev-line" style="width:99%"></div>
                      <div class="ps-rev-line" style="width:90%"></div>
                      <div class="ps-rev-line" style="width:97%"></div>
                      <div class="ps-rev-line" style="width:64%"></div>
                    </div>
                  </div>
                  <div class="ps-rev-comments">
                    <div class="ps-rev-comment">
                      <div class="ps-rev-avatar">J</div>
                      <div class="ps-rev-bubble">
                        <div class="ps-rev-meta"><span class="ps-rev-name">Jess</span><span class="ps-rev-time">2m</span></div>
                        <div class="ps-rev-text">Punchier headline?</div>
                      </div>
                    </div>
