    tone="light"
    eyebrow="Ready when you are"
    lead="Got a practice, a product, or a"
    swap={["side project?", "small business?", "local shop?", "studio?"]}
    lede="Tell us about it. We reply to every inquiry — usually within a day."
    note="Replies within a day, every day"
  />
  <script is:inline>
    // SELECTED WORK — cursor image trail (the 222.place idiom).
    //
    // Moving the pointer across the stage drops a shot at the cursor and leaves
    // it behind; the ones before it recede and fade, so a sweep paints a trail
    // of the folder instead of swapping one image in place. Distance-driven,
    // never time-driven: a still pointer emits nothing.
    //
    // The trail nodes are cloned from the real <li> images, so the source of
    // truth stays the accessible list in the markup. Every node is removed on
    // its own timer, so the layer never grows without bound.
    (() => {
      const stage = document.querySelector("[data-wk-stage]");
      const trail = document.querySelector("[data-wk-trail]");
      if (!stage || !trail) return;
      const shots = Array.from(stage.querySelectorAll(".wk-shot"));
      if (!shots.length) return;

      // Matches the CSS breakpoint. A coarse pointer never gets the effect —
      // there the grid IS the section.
      const canHover = window.matchMedia("(hover: hover) and (min-width: 900px)");
      const still = window.matchMedia("(prefers-reduced-motion: reduce)");

      const STEP = 130;   // px of travel between drops
      const LIFE = 380;   // ms a dropped shot holds before it starts leaving
      const OUT = 420;    // ms the exit animation runs before the node is cut
      const MAX = 9;      // hard cap on live nodes
      const TILTS = [-4, 3, -2, 5, -3.5, 2.5];

      // Cloned once: each drop is a cheap clone of a prepared node rather than
      // a fresh parse of the markup.
      const sources = shots.map((li, i) => {
        const node = document.createElement("div");
        node.className = "wk-trail-item";
        const frame = li.querySelector(".wk-shot-frame").cloneNode(true);
        frame.querySelectorAll("img").forEach((img) => {
          img.removeAttribute("loading");
          img.setAttribute("aria-hidden", "true");
        });
        node.appendChild(frame);
        node.style.setProperty("--r", TILTS[i % TILTS.length] + "deg");
        return node;
      });

      let idx = 0;
      let lastX = null;
      let lastY = null;
      let travelled = 0;
      let live = [];

      const drop = (x, y, dx, dy) => {
        const node = sources[idx % sources.length].cloneNode(true);
        idx += 1;
        node.style.left = x + "px";
        node.style.top = y + "px";
        // A touch of variation so a straight sweep does not read as a ruler.
        node.style.setProperty("--jx", (Math.random() * 26 - 13).toFixed(1) + "px");

        // The vector the shot flies IN from: back along the direction of
        // travel, so it appears to be thrown off the cursor and caught. The
        // move delta is normalised to a fixed nudge — otherwise a fast sweep
        // would fling shots in from off-stage and a slow one would barely
        // move them. Straight down when there is no direction yet (the first
        // drop on entry).
        const len = Math.hypot(dx, dy);
        const NUDGE = 34;
        const ix = len > 0.5 ? (-dx / len) * NUDGE : 0;
        const iy = len > 0.5 ? (-dy / len) * NUDGE : NUDGE * 0.6;
        node.style.setProperty("--ix", ix.toFixed(1) + "px");
        node.style.setProperty("--iy", iy.toFixed(1) + "px");

        trail.appendChild(node);
        // Next frame, so the entrance animation actually runs.
        requestAnimationFrame(() => node.classList.add("is-in"));
        live.push(node);

        const kill = () => {
          node.classList.remove("is-in");
          node.classList.add("is-out");
          setTimeout(() => {
            node.remove();
            live = live.filter((n) => n !== node);
          }, OUT);
        };
        setTimeout(kill, LIFE);

        // Over the cap, retire the oldest early rather than letting the stack
        // deepen — the trail should read as a few frames, not a collage.
        while (live.length > MAX) {
          const oldest = live.shift();
          if (oldest && oldest.isConnected) {
            oldest.classList.remove("is-in");
            oldest.classList.add("is-out");
          }
          setTimeout(() => oldest && oldest.remove(), OUT);
        }
      };

      const onMove = (e) => {
        const box = stage.getBoundingClientRect();
        const x = e.clientX - box.left;
        const y = e.clientY - box.top;
        stage.classList.add("is-live");

        if (lastX === null) {
          drop(x, y, 0, 0);
        } else {
          const dx = x - lastX;
          const dy = y - lastY;
          travelled += Math.hypot(dx, dy);
          if (travelled > STEP) {
            travelled = 0;
            drop(x, y, dx, dy);
          }
        }
        lastX = x;
        lastY = y;
      };

      // Leaving does not wipe the trail — each node is already on its own
      // timer, so it drains naturally and the prompt returns behind it.
      const onLeave = () => {
        stage.classList.remove("is-live");
        lastX = lastY = null;
        travelled = 0;
      };

      const clear = () => {
        live.forEach((n) => n.remove());
        live = [];
        trail.replaceChildren();
      };

      const bind = () => {
        const on = canHover.matches && !still.matches;
        stage.classList.toggle("is-armed", on);
        if (on) {
          stage.addEventListener("mousemove", onMove);
          stage.addEventListener("mouseleave", onLeave);
        } else {
          onLeave();
          clear();
          stage.removeEventListener("mousemove", onMove);
          stage.removeEventListener("mouseleave", onLeave);
        }
      };

      bind();
      // Re-evaluate if the window crosses the breakpoint or the OS motion
      // preference changes, so the section is never left half-armed.
      canHover.addEventListener("change", bind);
      still.addEventListener("change", bind);
    })();
  </script>
</BaseLayout>

<style>
/* isolation + overflow stay: the showcase panel inside runs its own field and
   this is the boundary it is clipped against. */
.hero-outer { position: relative; isolation: isolate; overflow: hidden; min-height: calc(100vh - 100px); display: flex; align-items: stretch; }
  .hero { display: grid; grid-template-columns: 1fr 1.15fr; width: 100%; align-items: stretch; gap: clamp(2rem, 4vw, 4rem); }
  /* Padding lives on the text column so the showcase column (with its grid
     background) can run flush to the section's top and bottom edges. */
  .hero-left { display: flex; flex-direction: column; gap: 1.75rem; padding-left: var(--pad-x); padding-block: clamp(2rem, 5vh, 4rem) clamp(3rem, 7vh, 5rem); justify-content: center; }
  .hero-eyebrow { display: inline-flex; align-items: center; gap: 12px; font-family: var(--font-mono); font-size: var(--text-step--2); letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-fg-muted); }
  .hero-eyebrow .bar { width: 24px; height: 1px; background: var(--color-periwinkle); }
  .hero-title { font-size: var(--text-step-6); margin: 0; max-width: 16ch; }

  /* Rotating word in the headline. Items are stacked in one grid cell so the
     line never reflows as they swap; the row is sized by the longest phrase. */
  .hero-swap { display: inline-grid; align-items: start; max-width: 100%; vertical-align: top; }
  .hero-swap-item {
    grid-area: 1 / 1;
    justify-self: start;
    white-space: nowrap;
    opacity: 0;
    animation: heroSwap 12s var(--ease-soft) infinite;
  }
  .hero-swap-item:nth-child(1) { animation-delay: 0s; }
  .hero-swap-item:nth-child(2) { animation-delay: 3s; }
  .hero-swap-item:nth-child(3) { animation-delay: 6s; }
  .hero-swap-item:nth-child(4) { animation-delay: 9s; }
  .hero-title em { font-style: italic; color: var(--color-blue); }
  @keyframes heroSwap {
    0%   { opacity: 0; transform: translateY(0.3em); }
    3%   { opacity: 1; transform: translateY(0); }
    22%  { opacity: 1; transform: translateY(0); }
    25%  { opacity: 0; transform: translateY(-0.3em); }
    100% { opacity: 0; transform: translateY(0.3em); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-swap-item { animation: none; opacity: 0; }
    .hero-swap-item:first-child { opacity: 1; }
  }
  .hero-lede { margin: 0; font-size: var(--text-step-3); font-family: var(--font-display); font-weight: 300; font-style: italic; color: var(--color-fg-soft); font-variation-settings: "opsz" 96; letter-spacing: -0.015em; line-height: 1.15; }
  .hero-lede em { font-style: italic; color: var(--color-blue); font-variation-settings: "opsz" 96; }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }

  /* Right column is now the HeroShowcase component, which owns its own
     gridded panel + browser styling. This is just the stretch wrapper. */
  .hero-right { display: flex; align-self: stretch; }

  .marquee { border-block: 1px solid var(--color-line); background: var(--color-paper); overflow: hidden; padding: 22px 0; }
  .marquee-track { display: flex; width: max-content; animation: marquee 60s linear infinite; }
  .marquee:hover .marquee-track { animation-play-state: paused; }
  .marquee-row { display: flex; gap: 44px; padding-inline: 22px; white-space: nowrap; }
  .marquee-item { font-family: var(--font-display); font-style: italic; font-weight: 350; font-size: var(--text-step-3); letter-spacing: -0.02em; color: var(--color-fg); font-variation-settings: "opsz" 144; display: inline-flex; align-items: center; gap: 22px; }
  .marquee-dot { color: var(--color-periwinkle); font-style: normal; font-size: 0.5em; }
  /* The @keyframes that sat here is gone. Astro scopes class selectors but NOT
     keyframe names, so this copy was not dead like the rules around it — being
     last in document order, it silently overrode the real one in Marquee.astro.
     The animation is defined once now, in the component that uses it. */

  /* ============================================================
     META STRIP — a spec table, not four independent tiles.

     The first value ("Agency Style: Personalized team for every
     need") is three to four times the length of the other three,
     and as four separate flex columns that made cell one two to
     five lines tall while its neighbours stayed at one — so the
     cell towered and the strip's height was set by its longest
     string.

     Fixed as a layout problem, not a copy one. The strip is now a
     two-row grid — keys in row one, values in row two — and each
     cell adopts those rows with `grid-template-rows: subgrid`. The
     long value can take as many lines as it needs and every other
     value still starts on exactly the same baseline, because no
     cell owns its own height any more. The first column is also
     given ~1.7× the width of the others, which is what the copy
     actually asks for, and hairline rules between the columns make
     the unequal lengths read as a table rather than as a row that
     failed to line up.
     ============================================================ */
  .meta-strip { background: var(--color-bg-soft); border-bottom: 1px solid var(--color-line); padding-block: var(--band-sm); }
  .meta-strip-grid {
    display: grid;
    grid-template-columns: 1fr;
    grid-auto-rows: auto;
    column-gap: clamp(1.25rem, 2.5vw, 2.25rem);
    row-gap: 1.5rem;
  }
  @media (min-width: 620px) { .meta-strip-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 960px) { .meta-strip-grid { grid-template-columns: 1.7fr 1fr 1fr 1fr; row-gap: 0; } }
  /* span 2 + subgrid: the cell keeps being a real element (so .mv-stagger
     still animates it) while its key and value land in the strip's shared
     rows rather than in a box of the cell's own. */
  .meta-cell { display: grid; grid-row: span 2; grid-template-rows: subgrid; row-gap: 0.4rem; }
  @media (min-width: 960px) {
    .meta-cell + .meta-cell {
      border-left: 1px solid var(--color-hairline);
      padding-left: clamp(1.25rem, 2.5vw, 2.25rem);
    }
  }
  .meta-key { font-family: var(--font-mono); font-size: var(--text-step--2); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-fg-muted); }
  .meta-val {
    font-family: var(--font-display); font-weight: 400;
    font-size: var(--text-step-1); font-variation-settings: "opsz" 60;
    color: var(--color-fg); letter-spacing: -0.01em;
    line-height: 1.28;
    /* Two even lines rather than a full line and an orphaned word. */
    text-wrap: balance;
  }

  /* One band rhythm for the whole page. `.section` ships at
     clamp(3rem, 6vh, 5rem) and the offer band was overriding it to
     clamp(6rem, 11vh, 9rem), so two adjacent sections differed by
     nearly 4rem of padding for no reason a reader could see. */
  .section-offer,
  .section-process,
  .section-area,
  .thread { padding-block: clamp(4.5rem, 9vh, 7rem); }

  .section-head { display: grid; gap: 1rem; grid-template-columns: 1fr; align-items: end; margin-bottom: clamp(2.5rem, 5vh, 3.75rem); }
  @media (min-width: 760px) { .section-head { grid-template-columns: 1fr 1.1fr; gap: 3rem; } }
  .section-head-lead { display: flex; flex-direction: column; align-items: flex-start; gap: 0.9rem; }
  .section-title { font-size: var(--text-step-4); max-width: 18ch; margin: 0; }
  .section-sub { color: var(--color-fg-soft); max-width: 50ch; font-size: var(--text-step-1); margin: 0; text-wrap: pretty; }

  /* Offer head: the sub sits over the 2x3 tile block to the right of the
     headline card, so its column matches the bento's own split (2 of 4
     columns, 1.5rem gutter) rather than the generic 1fr/1.1fr head grid.
     It is allowed the full width of that column so it runs two lines —
     roughly the height of the title beside it — and both are centred on
     the same line, which lets the head sit closer to the cards. */
  @media (min-width: 1000px) {
    .section-offer .section-head {
      grid-template-columns: calc(50% - 0.75rem) 1fr;
      gap: 1.5rem;
      align-items: center;
      margin-bottom: clamp(1.5rem, 3vh, 2.25rem);
    }
    .section-offer .section-sub { max-width: none; text-wrap: balance; }
  }

  /* ============================================================
     BAND — the soft surface and rhythm the service-area and
     process bands use, so this reads as one more band on the page.
     ============================================================ */
  .wk-band {
    /* Ink, not paper. The page ran white from the hero all the way to the
       studio band; the work is the one thing here that should sit on a
       gallery wall rather than on a page. */
    position: relative;
    background: var(--color-ink);
    color: var(--color-paper);
    border-block: 0;
    padding-block: clamp(4.5rem, 9vh, 7rem);
    overflow: hidden;
  }
  .wk-band::before {
    content: "";
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background: radial-gradient(ellipse 60% 60% at 80% 0%, rgb(142 148 184 / 0.14), transparent 70%);
  }
  /* Above the wall AND above the radial wash, both of which are painted by
     absolutely positioned layers at z-index 0. */
  .wk-band > .full { position: relative; z-index: 1; }
  /* Section head + footer link, recoloured for ink. */
  .wk-band .section-title { color: var(--color-paper); }
  .wk-band .section-title em { color: var(--color-periwinkle); }
  .wk-band .section-sub { color: rgb(255 255 255 / 0.72); }
  .wk-band .section-eyebrow { color: rgb(255 255 255 / 0.5); }
  .wk-band .section-eyebrow-bar { background: var(--color-periwinkle); }
  .wk-band .wk-foot :global(.link-arrow) { color: var(--color-periwinkle); }

  .wk-empty {
    margin: 0;
    color: var(--color-fg-muted);
    font-size: var(--text-step-0);
  }
  .wk-empty code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--color-blue);
  }

  /* ============================================================
     THE GRID — what the section is on touch, at narrow widths, and
     under reduced motion. Not a fallback bolted on afterwards: it
     is the base state, and the cursor gallery is layered over it.
     ============================================================ */
  .wk-shots {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: clamp(1.25rem, 3vw, 2rem);
  }
  .wk-shot { display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; }

  /* Frame borrows the project-card chassis: 16:10, hairline, and the two
     stacked shadows with heavy negative spread. */
  .wk-shot-frame {
    display: block;
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: 14px;
    border: 1px solid rgb(255 255 255 / 0.12);
    background: var(--color-surface);
    overflow: hidden;
    box-shadow:
      0 40px 100px -45px rgb(0 0 0 / 0.6),
      0 16px 36px -16px rgb(0 0 0 / 0.45);
  }
  .wk-shot-img { width: 100%; height: 100%; object-fit: cover; object-position: top center; }

  .wk-shot-cap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    width: 100%;
    padding: 0;
    text-align: left;
    background: none;
    border: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-step-1);
    letter-spacing: -0.01em;
    color: var(--color-paper);
    font-variation-settings: "opsz" 60;
  }
  .wk-shot-name { display: inline-flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  /* Desktop has nothing to disclose — the panel below is always open there. */
  .wk-shot-cue { display: none; }
  .wk-shot-kind {
    font-family: var(--font-mono);
    font-size: var(--text-step--2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-periwinkle);
  }
  .wk-shot-detail-inner { display: flex; flex-direction: column; gap: 0.75rem; }
  .wk-tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .wk-tag {
    font-size: var(--text-step--1);
    color: rgb(255 255 255 / 0.78);
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 999px;
    padding: 5px 12px;
  }
  /* Same pill vocabulary as the badge on /work's cards. Work that is not a
     launched client site says so, wherever it is shown. */
  .wk-pill {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-periwinkle);
    background: rgb(255 255 255 / 0.06);
    border: 1px solid rgb(255 255 255 / 0.18);
    padding: 5px 11px;
    border-radius: 999px;
    white-space: nowrap;
  }

  /* ============================================================
     TOUCH / NARROW — each shot becomes a disclosure. Tapping the
     caption opens what that project actually covered, so the band
     says something on a phone instead of being three big pictures
     you scroll past. Clipped by max-height, never display:none, so
     the full text is always in the accessibility tree.
     ============================================================ */
  @media (max-width: 899px) {
    .wk-shots { grid-template-columns: 1fr; gap: 1.25rem; }
    .wk-shot {
      gap: 0;
      border: 1px solid rgb(255 255 255 / 0.12);
      border-radius: 16px;
      background: rgb(255 255 255 / 0.03);
      padding: 0.75rem 0.75rem 0;
      overflow: hidden;
    }
    /* Full-bleed screenshots are wider than they are tall; cropping the sides
       chopped the client's own logo off the shot, so the frame keeps the
       source ratio and the image is contained rather than cropped. */
    .wk-shot-frame { aspect-ratio: 16 / 10; background: var(--color-navy); }
    .wk-shot-img { object-fit: contain; object-position: center; }
    .wk-shot-cap {
      padding: 0.9rem 0.25rem;
      font-size: var(--text-step-0);
      min-height: 44px;
      cursor: pointer;
      /* At 390px "Burnt Crumbs + MOCKUP + TAP TO SEE THE WORK" cannot share
         one line, and flex-wrap left the pill orphaned under the title. Two
         rows, stated. */
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
    .wk-shot-cue {
      flex: none;
      color: var(--color-periwinkle);
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      font-family: var(--font-mono);
      font-size: var(--text-step--2);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
    /* The chevron alone did not read as "there is more here", so the cue says
       what a tap does and swaps its label once the panel is open. */
    .wk-shot-chev {
      display: inline-block;
      transform: rotate(90deg);
      transition: transform 320ms var(--ease-out-expo);
    }
    .wk-shot-cue-close { display: none; }
    .wk-shot-cap[aria-expanded="true"] .wk-shot-cue-open { display: none; }
    .wk-shot-cap[aria-expanded="true"] .wk-shot-cue-close { display: inline; }
    .wk-shot-cap[aria-expanded="true"] .wk-shot-chev { transform: rotate(-90deg); }
    .wk-shot-detail {
      max-height: 0;
      overflow: hidden;
      transition: max-height 420ms var(--ease-out-expo);
    }
    .wk-shot-cap[aria-expanded="true"] + .wk-shot-detail { max-height: 22rem; }
    .wk-shot-detail-inner { padding: 0 0.25rem 1.1rem; }
  }

  .wk-prompt { display: none; }
  /* Decoration only, and only when the script is driving. Off by default so a
     no-JS or touch visitor never gets a stray positioned layer. */
  .wk-trail { display: none; }

  /* The stage owns the drifting mark now, so it has to be a containing block
     and a clipping boundary at EVERY width — not only when .is-armed adds
     those below for the cursor gallery. Without this the wall would resolve
     against the section and wash across the whole band, which is the thing
     moving it in here was meant to stop.

     On a phone the stage is a plain column of cards with no frame of its own,
     so the field is given the same rounded box the armed stage has. It reads
     as the surface the work sits on rather than as loose texture. */
  .wk-stage {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 18px;
  }
  /* Everything real in the stage sits above the field. */
  .wk-stage > :not(.bw) { position: relative; z-index: 1; }
  .wk-foot { margin: clamp(2.25rem, 4.5vh, 3.25rem) 0 0; }

  /* ============================================================
     THE CURSOR GALLERY — pointer devices, desktop widths.
     .is-armed is set by the script, so the stage only collapses
     into a single-shot surface once JS is actually driving it. No
     JS, no armed class, and the grid above simply stands.
     ============================================================ */
  @media (hover: hover) and (min-width: 900px) {
    .wk-stage.is-armed {
      position: relative;
      /* Tall enough that a dropped shot sits inside the frame rather than
         being sliced by its top edge, short enough not to swallow the fold. */
      height: clamp(460px, 56vh, 620px);
      border: 1px solid rgb(255 255 255 / 0.10);
      border-radius: 18px;
      /* Follows the band. On ink, a paper-white stage read as an empty modal
         sitting on the section rather than as part of it. */
      background: rgb(255 255 255 / 0.02);
      overflow: hidden;
      cursor: crosshair;
    }
    /* The blueprint grid that used to paint here is gone — BrandWall inside
       the stage replaces it. Keeping both would have stacked two textures on
       one surface, and the grid was already the site's third copy of that
       same 46px rule. */

    .wk-stage.is-armed .wk-prompt {
      position: absolute;
      inset: 0;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.9rem;
      pointer-events: none;
      transition: opacity 420ms var(--ease-soft);
    }
    /* The invitation retires the moment it is accepted. */
    .wk-stage.is-armed.is-live .wk-prompt { opacity: 0; }
    .wk-prompt-line { width: 1px; height: 34px; background: rgb(255 255 255 / 0.35); }
    .wk-prompt-text {
      font-family: var(--font-mono);
      font-size: var(--text-step--2);
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: rgb(255 255 255 / 0.55);
    }

    /* Once the stage is armed the real list stops being the visual layer. It
       is not display:none — a screen reader still walks the full captioned
       set, and it is what the trail nodes are cloned from — it is simply
       clipped out of sight behind the stage. */
    .wk-stage.is-armed .wk-shots {
      position: absolute;
      width: 1px; height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
      pointer-events: none;
    }

    /* ---- the trail itself ----
       Each drop is absolutely placed at the cursor, centred on it, and stacked
       above the ones before it (source order = age, so a later sibling paints
       on top for free). Only transform and opacity animate. */
    .wk-trail {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 2;
      pointer-events: none;
    }
    /* Base = the pre-drop pose. The nudge each shot enters from is a fixed
       per-node vector (--ix/--iy, written by the script from the pointer's
       direction of travel), so a shot arrives as if it were flung off the
       cursor rather than simply appearing.

       Entrance and exit are KEYFRAMES, not transitions between two class
       states. A transition cannot overshoot on the way in, and it cannot be
       interrupted mid-flight without snapping — with animations the exit
       simply takes over from wherever the entrance got to. Both are
       `forwards`, so the node holds its end pose until it is removed. */
    .wk-trail :global(.wk-trail-item) {
      position: absolute;
      width: clamp(230px, 22vw, 300px);
      margin: 0;
      will-change: transform, opacity;
      opacity: 0;
      transform:
        translate3d(calc(-50% + var(--jx, 0px)), -50%, 0)
        rotate(var(--r, 0deg)) scale(0.72);
    }
    /* Arriving — scales up past 1 and settles back, rotating in from a
       flatter angle so the tilt lands rather than being there all along. */
    .wk-trail :global(.wk-trail-item.is-in) {
      animation: wkTrailIn 620ms cubic-bezier(0.22, 1.4, 0.36, 1) forwards;
    }
    /* Retiring — carries on along the entry vector, shrinking and fading,
       so a shot exits with the sweep instead of dropping straight down. */
    .wk-trail :global(.wk-trail-item.is-out) {
      animation: wkTrailOut 420ms cubic-bezier(0.4, 0, 0.7, 0.2) forwards;
    }

    @keyframes wkTrailIn {
      0% {
        opacity: 0;
        transform:
          translate3d(calc(-50% + var(--jx, 0px) + var(--ix, 0px)), calc(-50% + var(--iy, 0px)), 0)
          rotate(calc(var(--r, 0deg) * 0.2)) scale(0.72);
      }
      45% { opacity: 1; }
      /* The overshoot: a hair past full size and past its own tilt. */
      62% {
        transform:
          translate3d(calc(-50% + var(--jx, 0px)), -50%, 0)
          rotate(calc(var(--r, 0deg) * 1.12)) scale(1.045);
      }
      100% {
        opacity: 1;
        transform:
          translate3d(calc(-50% + var(--jx, 0px)), -50%, 0)
          rotate(var(--r, 0deg)) scale(1);
      }
    }
    @keyframes wkTrailOut {
      0% { opacity: 1; }
      100% {
        opacity: 0;
        transform:
          translate3d(
            calc(-50% + var(--jx, 0px) - var(--ix, 0px) * 0.45),
            calc(-50% - var(--iy, 0px) * 0.45 + 10px), 0)
          rotate(calc(var(--r, 0deg) * 0.75)) scale(0.9);
      }
    }
    .wk-trail :global(.wk-shot-frame) {
      box-shadow:
        0 30px 70px -34px rgb(7 23 34 / 0.42),
        0 10px 24px -12px rgb(7 23 34 / 0.20);
    }
  }

  /* ============================================================
     REDUCED MOTION — the script never arms the stage, so the grid
     stands on its own and there is nothing to undo here beyond the
     stage's own entrance, which global.css already suppresses.
     ============================================================ */
  @media (prefers-reduced-motion: reduce) {
    .wk-shot { opacity: 1; transform: none; }
  }

  /* Same key/value grammar as the meta strip at the top of the page. */
  .area-key {
    font-family: var(--font-mono); font-size: var(--text-step--2);
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-fg-muted);
  }
  .meta-val {
    font-family: var(--font-display); font-weight: 400;
    font-size: var(--text-step-1); font-variation-settings: "opsz" 60;
    color: var(--color-fg); letter-spacing: -0.01em;
    line-height: 1.28;
  }
  .area-text { margin: 0; max-width: 50ch; color: var(--color-fg-soft); text-wrap: pretty; }
  .area-block { display: flex; flex-direction: column; gap: 0.6rem; }

  /* ============================================================
     NEW — the band itself.
     Two columns on the same track as .section-head above it, so
     the card starts on exactly the x of the section sub.
     ============================================================ */
  .area-grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; align-items: center; }
  @media (min-width: 760px) { .area-grid { grid-template-columns: 1fr 1.1fr; gap: 3rem; } }

  /* ---- left: map in a double bezel ----
     Outer shell is paper with the two stacked shadows the project cards use;
     the inner core is the gridded panel from the hero showcase. Inner radius
     is outer minus the 10px padding so the two curves stay concentric. */
  .area-shell {
    border-radius: 20px;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    padding: 10px;
    box-shadow:
      0 40px 100px -45px rgb(7 23 34 / 0.28),
      0 16px 36px -16px rgb(7 23 34 / 0.16);
  }
  .area-core {
    position: relative;
    overflow: hidden;
    border-radius: 10px;
    background: linear-gradient(160deg, var(--color-bg-soft) 0%, color-mix(in srgb, var(--color-navy) 4%, var(--color-bg-soft)) 100%);
    padding: 0.85rem 0.85rem 1.4rem;
  }
  .area-core::before {
    content: "";
    position: absolute; inset: 0;
    background-image:
      linear-gradient(color-mix(in srgb, var(--color-navy) 6%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--color-navy) 6%, transparent) 1px, transparent 1px);
    background-size: 38px 38px;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, black 13%, black 87%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0%, black 13%, black 87%, transparent 100%);
    pointer-events: none;
  }
  /* Floated over the map, not stacked above it. As a row in the flow it took
     a band out of the top of the frame and the map's first ~40px went with it.
     The pill carries its own paper background, so it stays legible over land. */
  .area-strip {
    position: absolute; top: 0.85rem; left: 0.85rem; right: 0.85rem; z-index: 2;
    display: flex; align-items: center; justify-content: space-between;
    gap: 1rem;
  }
  /* Same pill vocabulary as the hero showcase stage tag. */
  .area-pill {
    display: inline-flex; align-items: center; gap: 7px;
    font-family: var(--font-mono); font-size: 11px;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-blue);
    background: var(--color-paper); border: 1px solid var(--color-line);
    padding: 5px 12px; border-radius: 999px; white-space: nowrap;
  }
  .area-pill-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-periwinkle); }
  /* The old note said "Not to scale", which was honest about a hand-drawn
     blob. The outline is now real Census data on an equal-area projection, so
     the note names the projection instead. */

  /* Bleeds out over the core's padding on three sides so the map reaches the
     panel's own rounded edge. Inset on all four it read as a small picture
     floating in a large frame rather than as the frame's contents. */
  .area-map { position: relative; z-index: 1; margin: -0.85rem -0.85rem -1.4rem; }
  /* No max-width. The map now runs to the edge of the frame on all four sides,
     so the SVG has to be the full width of the panel: capped at 420px inside a
     740px panel, the land stopped dead in mid-air with bare panel beyond it,
     which read as a torn image. The only thing that ends a shape now is the
     edge of the SVG, and that edge sits on the panel's own inner margin. */
  .area-map svg { display: block; width: 100%; height: auto; }

  /* Hairlines and one accent, nothing else — this band is the quiet one on
     the page and a map is loud enough on its own. */
  .oc-land { fill: var(--color-paper); stroke: var(--color-line-strong); stroke-width: 1; stroke-linejoin: round; stroke-linecap: round; }
  /* Neighbours: a shade off paper so land still reads as land against the
     panel, and a line light enough that California's own edge stays the
     strongest one on the map. Opaque rather than an alpha token, because
     adjoining states stroke their shared border twice. */
  .oc-neighbours path {
    fill: color-mix(in srgb, var(--color-navy) 3%, var(--color-paper));
    stroke: color-mix(in srgb, var(--color-navy) 20%, var(--color-bg-soft));
    stroke-width: 1; stroke-linejoin: round; stroke-linecap: round;
  }
  /* No stroke: the county's western edge *is* the state's coastline, so a
     contrasting outline would open a seam along it. */
  .oc-county { fill: var(--color-blue); stroke: none; }
  .oc-leader { fill: none; stroke: var(--color-line-strong); stroke-width: 1; stroke-linecap: round; stroke-linejoin: round; }
  /* Type is sized in user units, so it now scales with the panel rather than
     sitting at a fixed pixel size: roughly 10px on a narrow column and 15px on
     a wide one, which is the right direction for an annotation on a map that
     is itself getting bigger. */
  .oc-sea {
    font-family: var(--font-display); font-style: italic; font-size: 12px;
    letter-spacing: 0.02em; fill: var(--color-fg-muted);
  }
  /* Same face and size as the water label, upright and in the accent, so it
     reads as a place rather than a sea. */
  .oc-label {
    font-family: var(--font-display); font-size: 13px;
    letter-spacing: 0.01em; fill: var(--color-blue);
  }

  /* ---- map motion ----
     `backwards` fill, not `forwards`: the outline holds its start state
     through the delay and then hands control back to the declared end state. */
  .oc-neighbours { opacity: 0; }
  .area-grid.is-inview .oc-neighbours {
    opacity: 1;
    animation: ocMark var(--motion-dur-base) var(--ease-soft) 120ms backwards;
  }
  .oc-land { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .area-grid.is-inview .oc-land {
    stroke-dashoffset: 0;
    animation: ocDraw var(--motion-dur-slow) var(--ease-out-expo) 240ms backwards;
  }
  @keyframes ocDraw { from { stroke-dashoffset: 1; } }

  /* County, leader and label land after the coastline has finished drawing. */
  .oc-county, .oc-leader, .oc-label { opacity: 0; }
  .area-grid.is-inview .oc-county,
  .area-grid.is-inview .oc-leader,
  .area-grid.is-inview .oc-label {
    opacity: 1;
    animation: ocMark 620ms var(--ease-soft) 1s backwards;
  }
  .area-grid.is-inview .oc-leader { animation-delay: 1.2s; }
  .area-grid.is-inview .oc-label { animation-delay: 1.35s; }
  @keyframes ocMark { from { opacity: 0; } }

  .oc-ping { fill: none; stroke: var(--color-blue); stroke-width: 1.2; opacity: 0; transform-box: fill-box; transform-origin: center; }
  .area-grid.is-inview .oc-ping { animation: ocPing 2.8s var(--ease-soft) 1.9s infinite; }
  @keyframes ocPing {
    0%   { transform: scale(1); opacity: 0.5; }
    70%  { transform: scale(2.4); opacity: 0; }
    100% { transform: scale(2.4); opacity: 0; }
  }

  /* ---- the push-in to Southern California ----
     Six seconds after the panel arrives — long enough to have read the
     section — the map eases from the regional view down onto Orange County
     and holds there. It holds rather than loops: this band sits next to copy
     you are meant to read, and a map that pumps in and out would pull the eye
     back every few seconds.

     A CSS transform, not the viewBox: transform is composited, viewBox is not
     animatable in CSS at all. .oc-zoom is a direct child of the <svg> and the
     viewBox starts at 0 0, so transform-origin below is plain frame
     coordinates — 361 390 is the water just off Orange County. The translate
     that follows carries that point to the middle of the frame, and 3.3 is the
     scale that leaves Santa Barbara, Palm Springs, Tijuana and Ensenada just
     inside the edges. Because the zoom only ever shrinks the window, a frame
     that is full of land at rest cannot open a bare edge part-way through.

     --ease-soft rather than --ease-out-expo: expo covers three quarters of
     the distance in the first three tenths of a second, which lands as a snap.
     This is the one place on the page where the slower curve is the right one. */
  /* Orange County's own user-space point. transform-box: view-box does NOT
     offset transform-origin by the viewBox's min-x/min-y — Chrome reads these
     as plain user coordinates — so this is the county's absolute position, not
     a position relative to the crop. Verified in the browser: subtracting the
     crop put the pivot ~150 units off and the leader missed the county. */
  .oc-zoom { transform-box: view-box; transform-origin: 354px 385px; }
  .area-grid.is-inview .oc-zoom { animation: ocZoom 2.1s var(--ease-soft) 6s both; }
  @keyframes ocZoom {
    from { transform: translate(0px, 0px) scale(1); }
    to   { transform: translate(19px, -120px) scale(2.1); }
  }

  /* The two label sets cross-fade around the move. The regional pair leaves
     just *before* the map starts travelling — it is pinned to the frame, not to
     the map, so any overlap would show it pointing at water — and the close
     pair arrives as the map settles. */
  .area-grid.is-inview .oc-mark-wide { animation: ocConceal 520ms var(--ease-soft) 5.7s forwards; }
  .oc-mark-close { opacity: 0; }
  .area-grid.is-inview .oc-mark-close { animation: ocReveal 700ms var(--ease-soft) 7.7s forwards; }
  @keyframes ocConceal { to { opacity: 0; } }
  @keyframes ocReveal { to { opacity: 1; } }

  /* ---- right: the studio card ---- */
  .area-card {
    display: flex; flex-direction: column;
    align-items: flex-start;
    gap: 1.15rem;
    padding: clamp(1.6rem, 3vw, 2.25rem);
  }
  .area-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--font-mono); font-size: var(--text-step--2);
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--fg-muted);
  }
  .area-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--color-periwinkle);
    animation: mvPulseRing 2.4s var(--ease-soft) infinite;
  }
  .area-place {
    margin: 0;
    font-size: var(--text-step-2);
    font-weight: 400; font-variation-settings: "opsz" 60;
    letter-spacing: -0.015em; line-height: 1.1;
  }
  .area-rule { width: 100%; height: 1px; background: var(--color-line); }
  .area-stats {
    width: 100%;
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .area-stat { display: flex; flex-direction: column; gap: 0.35rem; }
  .area-card .area-block { width: 100%; margin-top: 0.35rem; }

  .area-cities {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 0.5rem;
  }
  .area-city {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 6px 12px 6px 10px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-size: var(--text-step--1);
    color: var(--color-fg-soft);
    transition: background 260ms var(--ease-soft), border-color 260ms var(--ease-soft), color 260ms var(--ease-soft);
  }
  .area-city-dot {
    width: 5px; height: 5px; border-radius: 50%;
    background: var(--color-blue);
    transition: transform 260ms var(--ease-out-expo);
  }
  .area-city:hover {
    background: var(--color-bg-soft);
    border-color: var(--color-line-strong);
    color: var(--color-fg);
  }
  .area-city:hover .area-city-dot { transform: scale(1.6); }

  /* The chip→pin :has() join is gone with the pins. At state scale the eight
     cities fall inside a 24-unit county, so there was nothing left to light. */

  /* ---- the prose, out of the card and under the grid ---- */
  .area-prose {
    display: grid; grid-template-columns: 1fr; gap: 2rem;
    margin-top: clamp(2.5rem, 5vh, 3.5rem);
    padding-top: clamp(2rem, 4vh, 2.75rem);
    border-top: 1px solid var(--color-hairline);
  }
  @media (min-width: 760px) {
    .area-prose { grid-template-columns: 1fr 1.1fr; gap: 3rem; }
    /* The hairline sits in the middle of the gap rather than on the second
       column's edge, so both blocks stay on the same two tracks as the map
       and the card above them. A border-left plus padding would have pushed
       this copy 3rem off the card's left edge. */
    .area-prose > * + * { position: relative; }
    .area-prose > * + *::before {
      content: "";
      position: absolute; left: -1.5rem; top: 0; bottom: 0;
      width: 1px; background: var(--color-hairline);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .oc-land,
    .area-grid.is-inview .oc-land { stroke-dashoffset: 0; animation: none; }
    .oc-county, .oc-leader, .oc-label, .oc-neighbours,
    .area-grid.is-inview .oc-county,
    .area-grid.is-inview .oc-leader,
    .area-grid.is-inview .oc-label,
    .area-grid.is-inview .oc-neighbours { opacity: 1; animation: none; }
    .area-grid.is-inview .oc-ping { animation: none; }
    .area-dot { animation: none; }
    /* No push-in: the regional view is the one static framing, so the close
       labels have to go with it or they would sit over open water. */
    .oc-zoom,
    .area-grid.is-inview .oc-zoom { transform: none; animation: none; }
    .oc-mark-wide,
    .area-grid.is-inview .oc-mark-wide { opacity: 1; animation: none; }
    .oc-mark-close { display: none; }
  }

  /* ============================================================
     SERVICES — bento spec sheet. The single offer becomes an
     editorial composition: a dark centerpiece (price + CTA) and
     six annotation tiles, each with its own mouse-spotlight sheen.
     ============================================================ */
  .offer-bento {
    display: grid;
    grid-template-columns: 1fr;
    grid-auto-rows: minmax(0, auto);
    gap: 1rem;
  }
  @media (min-width: 760px) {
    .offer-bento {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
  }
  @media (min-width: 1000px) {
    .offer-bento {
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: repeat(3, minmax(180px, 1fr));
      gap: 1.5rem;
    }
  }

  /* Shared card chassis — same sheen mechanic the tier cards use,
     hoisted so each bento tile gets its own spotlight on hover. */
  .bento-card {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    --bg: #fff;
    --fg: var(--color-navy);
    --fg-soft: var(--color-fg-soft);
    --fg-muted: var(--color-fg-muted);
    --line: var(--color-line);
    --accent: var(--color-blue);
    --sheen: rgb(13 47 69 / 0.10);
    background: var(--bg);
    color: var(--fg);
    border: 1px solid var(--line);
    border-radius: 14px;
    transition: transform 360ms var(--ease-soft), box-shadow 360ms var(--ease-soft), border-color 360ms var(--ease-soft);
  }
  .bento-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 30px 60px -28px rgb(7 23 34 / 0.28);
  }
  .bento-card .tier-sheen {
    position: absolute; inset: 0;
    pointer-events: none; z-index: 0;
    border-radius: inherit;
    opacity: 0;
    transition: opacity 360ms var(--ease-soft);
    background: radial-gradient(260px circle at var(--mx, 50%) var(--my, 50%), var(--sheen), transparent 60%);
  }
  .bento-card:hover .tier-sheen { opacity: 1; }
  .bento-card > :not(.tier-sheen) { position: relative; z-index: 1; }

  /* Centerpiece — dark "spec card" with price + CTA + ticker */
  .bento-headline {
    --bg: var(--color-navy);
    --fg: #fff;
    --fg-soft: rgba(255,255,255,0.82);
    --fg-muted: rgba(255,255,255,0.55);
    --line: rgba(255,255,255,0.14);
    --accent: var(--color-periwinkle);
    --sheen: rgb(255 255 255 / 0.14);
    display: flex;
    flex-direction: column;
    padding: clamp(2rem, 3.2vw, 2.75rem);
    min-height: 480px;
  }
  @media (min-width: 1000px) {
    .bento-headline {
      grid-column: 1 / span 2;
      grid-row: 1 / span 3;
      min-height: 0;
    }
  }
  .bh-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .bh-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--font-mono); font-size: var(--text-step--2);
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--fg-muted);
  }
  .bh-eyebrow .live-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--color-periwinkle);
    box-shadow: 0 0 0 0 rgba(142, 148, 184, 0.6);
    animation: bhPulse 2.4s var(--ease-soft) infinite;
  }
  @keyframes bhPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(142, 148, 184, 0.55); }
    50% { box-shadow: 0 0 0 7px rgba(142, 148, 184, 0); }
  }
  .bh-meta {
    font-family: var(--font-mono); font-size: var(--text-step--2);
    letter-spacing: 0.06em; color: var(--fg-muted);
    text-align: right;
  }
  .bh-body { display: flex; flex-direction: column; gap: 1.25rem; margin-block: auto; padding-block: clamp(2rem, 5vh, 3rem); }
  .bh-title {
    font-family: var(--font-display); font-weight: 350;
    font-size: clamp(2.8rem, 5vw, 4.4rem);
    line-height: 0.95; letter-spacing: -0.03em;
    color: var(--fg); margin: 0;
    font-variation-settings: "opsz" 144;
  }
  .bh-title em {
    font-style: italic; color: var(--accent);
    font-variation-settings: "opsz" 144;
  }
  .bh-price {
    display: flex; align-items: baseline; gap: 0.2rem;
    padding-block: 0.75rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .bh-dollar {
    font-family: var(--font-display); font-weight: 300; font-style: italic;
    font-size: clamp(1.6rem, 2.4vw, 2.4rem);
    color: var(--accent);
    font-variation-settings: "opsz" 60;
  }
  .bh-amount {
    font-family: var(--font-display); font-weight: 300; font-style: italic;
    font-size: clamp(4.5rem, 8vw, 7.5rem);
    line-height: 0.9; letter-spacing: -0.04em;
    color: var(--fg);
    font-variation-settings: "opsz" 144;
  }
  .bh-note {
    margin: 0;
    color: var(--fg-soft);
    font-family: var(--font-display); font-weight: 300; font-style: italic;
    font-size: var(--text-step-1); line-height: 1.4;
    max-width: 32ch;
    font-variation-settings: "opsz" 60;
  }
  .bh-foot { display: flex; flex-direction: column; gap: 1.25rem; }
  .bh-cta {
    display: inline-flex; align-items: center; justify-content: space-between;
    gap: 0.75rem;
    padding: 1.1rem 1.5rem;
    border-radius: 999px;
    border: 1px solid var(--fg);
    background: transparent;
    color: var(--fg);
    font-family: var(--font-sans); font-size: var(--text-step--1);
    font-weight: 500; letter-spacing: 0.01em;
    transition: background 280ms var(--ease-soft), color 280ms var(--ease-soft);
  }
  .bh-cta:hover { background: var(--fg); color: var(--bg); }
  .bh-cta .arrow { transition: transform 320ms var(--ease-soft); }
  .bh-cta:hover .arrow { transform: translateX(4px); }

  /* Marquee ticker — subtle motion at the bottom of the centerpiece */
  .bh-ticker {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--line);
    padding-top: 1rem;
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .bh-ticker-track {
    display: inline-flex;
    align-items: center;
    gap: 1.25rem;
    white-space: nowrap;
    animation: bhTicker 28s linear infinite;
    font-family: var(--font-mono);
    font-size: var(--text-step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .bh-ticker-track .dot { color: var(--accent); font-size: 0.6em; }
  @keyframes bhTicker { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .bh-ticker-track { animation: none; }
    .bh-eyebrow .live-dot { animation: none; }
  }

  /* Feature tiles — soft, numbered, individually spotlit */
  .bento-feature {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: clamp(1.5rem, 2vw, 2rem);
    --bg: var(--color-bg-soft);
    background: var(--bg);
    min-height: 200px;
  }
  .bento-feature::before {
    content: "";
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 2px;
    background: var(--color-periwinkle);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 420ms var(--ease-soft);
    z-index: 2;
  }
  .bento-feature:hover::before { transform: scaleY(1); }
  .bf-num {
    font-family: var(--font-display); font-style: italic; font-weight: 400;
    font-size: var(--text-step-2); line-height: 1;
    color: var(--color-blue);
    font-variation-settings: "opsz" 144;
  }
  .bf-title {
    margin: 0;
    font-family: var(--font-display); font-weight: 400;
    font-size: var(--text-step-2);
    line-height: 1.1; letter-spacing: -0.015em;
    color: var(--color-fg);
    font-variation-settings: "opsz" 60;
  }
  .bf-title em {
    font-style: italic; color: var(--color-blue);
    font-variation-settings: "opsz" 60;
  }
  .bf-body {
    margin: auto 0 0;
    color: var(--color-fg-soft);
    font-size: var(--text-step-0);
    line-height: 1.45;
    max-width: 32ch;
  }

  /* This head now uses the shared two-column .section-head grid — the only
     thing left to say is the measure, which runs a little wider here because
     the title is the longest of the three. */
  .section-process .section-head .section-title { max-width: 20ch; }
  .section-eyebrow { display: inline-flex; align-items: center; gap: 12px; font-family: var(--font-mono); font-size: var(--text-step--2); letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-fg-muted); }
  .section-eyebrow-bar { width: 24px; height: 1px; background: var(--color-blue); }

  /* ============================================================
     PROCESS — four cards in one row that trade space.

     This replaced four full-bleed alternating rows, each carrying a
     620px browser/calendar mockup. Those rows were the reason the
     section ran nearly four screens tall on desktop. The mockups
     themselves are kept — see the PROCESS STEP GRAPHICS block below
     for how they are sized down into a card.

     Flex rather than grid on purpose: `flex-grow` is animatable on
     the child, so "this card takes the room, the others give it up"
     is one declaration on .process-card instead of four :has() rules
     on the container.

     Nothing here is hover-only. The detail copy is clipped, never
     hidden — no display:none, no visibility:hidden — so a screen
     reader reads every card in full regardless of visual state, and
     .pc-head is a real link so Tab reaches the expansion via
     :focus-within.
     ============================================================ */
  .process-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    /* 1px gaps over a line-coloured backing draw the seams — a spec
       sheet rather than four detached tiles. Cheaper than borders,
       which would double up on wrap. */
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: 16px;
    overflow: hidden;
  }

  .process-card {
    position: relative;
    flex: 1 1 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    /* Named because the step graphic below bleeds through it and has to
       add it back to work out how wide the card actually is. */
    --pc-pad: clamp(1.5rem, 2.2vw, 2.25rem);
    padding: var(--pc-pad);
    background: var(--color-bg-soft);
    transition:
      background 420ms var(--ease-soft),
      flex-grow 620ms var(--ease-out-expo);
  }
  /* Accent rail across the top of the card. In the stacked layout it
     just stands there quietly, marking the head of each step; in the
     four-up regime it draws itself across whichever card is open. */
  .process-card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: var(--color-periwinkle);
    transform: scaleX(1);
    opacity: 0.35;
    transform-origin: left;
    transition: transform 520ms var(--ease-out-expo);
    z-index: 3;
  }
  @media (min-width: 640px) { .process-card { flex-basis: calc(50% - 1px); } }

  .pc-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    text-decoration: none;
    color: inherit;
  }
  /* --focus-ring rather than periwinkle: the card only turns ink in the
     four-up regime above, and periwinkle on the resting bg-soft surface
     is 2.75:1 — under the 3:1 WCAG 1.4.11 asks. --focus-ring clears it
     on both surfaces (4.00:1 on paper, 4.55:1 on ink). */
  .pc-head:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 6px;
    border-radius: 4px;
  }

  /* The numeral leads the card on its own line rather than sitting
     inline next to "Step 01" as it did in the old wide rows — at a
     quarter of the page width an inline glyph cost the title a whole
     line of measure. Same shape as .bf-num in the offer bento above,
     which is the page's existing vocabulary for a numbered tile. */
  .pc-glyph {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-step-4);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-blue);
    font-variation-settings: "opsz" 144;
    transition: color 420ms var(--ease-soft);
  }
  .pc-step {
    font-family: var(--font-mono);
    font-size: var(--text-step--2);
    color: var(--color-blue);
    letter-spacing: 0.1em;
    font-weight: 500;
    text-transform: uppercase;
    transition: color 420ms var(--ease-soft);
  }
  .pc-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 350;
    /* Between step-2 and step-3. Step-3 is the right weight for a card
       this size but overshoots the measure of a collapsed column. */
    font-size: clamp(1.55rem, 1.05rem + 1.35vw, 2.15rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
    font-variation-settings: "opsz" 96;
    color: var(--color-fg);
    text-wrap: balance;
    transition: color 420ms var(--ease-soft);
  }
  .pc-title em { font-style: italic; color: var(--color-blue); font-variation-settings: "opsz" 96; }
  /* Inline in the step label and always present, rather than an arrow
     that only existed on hover. The head is a link at every width, so
     its affordance has to be there at every width too. */
  .pc-cue {
    display: inline-block;
    margin-left: 0.5rem;
    transition: transform 380ms var(--ease-out-expo);
  }
  .process-card:hover .pc-cue,
  .process-card:focus-within .pc-cue { transform: translateX(3px); }

  /* ============================================================
     THE COPY.

     Default — below 1040px and under reduced motion at any width —
     it is simply the next block in the card's flow, between the
     head and the graphic, standing open with nothing to reveal.
     The four-up query above lifts it onto an ink sheet instead.
     ============================================================ */
  .pc-window {
    position: relative;
    display: flex;
    flex-direction: column;
    /* Grows into whatever height the tallest card in the row forces, so
       the free space lands above the graphic rather than below it. */
    flex: 1 1 auto;
    min-height: 0;
    /* No longer bled through the card's padding: the graphic floats
       inside it instead, so the card's own padding is the inset on the
       left, the right and the bottom, and this top margin is the only
       one that has to be declared. Same value, so all four match. */
    margin: var(--pc-pad) 0 0;
  }
  /* Takes the slack, which puts the four graphics on one baseline across
     a row whose cards carry different amounts of copy. */
  .pc-reveal {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    /* No horizontal padding: it existed to undo .pc-window's negative
       side margins, and the window no longer has them. Left in, it
       indents the copy past the title it belongs to. */
    padding: 0 0 1.75rem;
  }
  .pc-body {
    margin: 0;
    color: var(--color-fg-soft);
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--text-step-1);
    line-height: 1.45;
    text-wrap: pretty;
  }
  /* A step below .pc-body, so the card reads title → summary → detail,
     and a step above the .pc-meta caption line. */
  .pc-more {
    margin: 0;
    color: var(--color-fg-soft);
    font-size: var(--text-step-0);
    line-height: 1.55;
    text-wrap: pretty;
  }
  .pc-meta {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-step--1);
    letter-spacing: 0.05em;
    color: var(--color-fg-muted);
  }
  /* Both of these belong to the mobile disclosure only. Above the breakpoint
     the card opens on hover and its head is already the link, so a "tap"
     instruction would be wrong and a second link redundant. */
  .pc-hint,
  .pc-link-out { display: none; }

  /* ============================================================
     PROCESS STEP GRAPHICS — the resting state of every card.

     These are what a card *is* when nobody is touching it, so the
     job here is legibility at rest, not on expand.

     They lay out at a fixed design size and get scaled to the card
     rather than reflowed into it — reflowing keeps the 10–13px mono
     at full size inside a quarter-width box and tears every one of
     these compositions apart.

     The design box is 470 × 500, which is the box these compositions
     were drawn in and the one /services still renders them at.

     It was briefly 410 × 316 — landscape, to fit a card that was not
     tall enough for a portrait graphic — and the missing height came
     out of the CONTENT: the calendar lost its fifth week, the deploy
     log lost a row, the draft browser's hero lost its lede lines and
     its CTA, and the date cells were flattened from 1.4:1 to 1.75:1.
     That shrunken box was then scaled back UP by 1.08 to fill the
     card, so what shipped was an upscaled crop of a portrait design.
     The card is sized for the graphic now instead, so nothing has to
     be deleted and nothing is enlarged past the size it was drawn at.

     The scale comes from a container query on .pc-visual (not on the
     card) so that it tracks the *graphic column* as the card opens
     and the text panel pushes in from the left, frame by frame, with
     no transition of its own.
     ============================================================ */

  /* Registered so that an engine without length-by-length division in
     calc() falls back to a usable 0.8 rather than dropping the height
     and the transform outright. */
  @property --pc-scale {
    syntax: "<number>";
    inherits: true;
    initial-value: 0.8;
  }

  .pc-visual {
    --stage-w: 470px;
    --stage-h: 500px;
    container-type: inline-size;
    position: relative;
    overflow: hidden;
    /* Stacked layout: the window takes the composition's own aspect
       rather than a fixed crop height, so a full-width card shows the
       whole graphic instead of the top 60% of it. Unitless on purpose
       — `470px / 500px` is not a valid aspect-ratio — so keep these
       two numbers in step with --stage-w / --stage-h above. */
    height: auto;
    aspect-ratio: 470 / 500;
    /* No paper here. The frame floats now and carries its own paper,
       border and shadow; leaving a background on the column as well
       draws a second white panel behind the frame, which shows the
       moment the column is taller than the frame. */
    background: transparent;
    border-radius: 14px;
    /* No mask. It existed to soften a bottom edge that was being
       cropped; nothing is cropped now — the stage scales to fit both
       axes — so there is no hard edge left to hide. */
  }
  .pc-stage {
    /* Declared on the stage, not on .pc-visual: an element cannot query
       itself, and .pc-visual is the container. */
    /* Dividing a length by a length is not something calc() will do, so the
       old `100cqi / var(--stage-w)` was dropped outright and every mockup
       rendered at the @property fallback of 0.8 — 376px of artwork inside a
       292px column on a phone, which is the overflow you could see. The ratio
       is measured in JS at the bottom of this file and written here as an
       inline custom property; this value is only the pre-script fallback. */
    --pc-scale: 0.8;
    position: absolute;
    top: 0;
    left: 50%;
    width: var(--stage-w);
    height: var(--stage-h);
    margin-left: calc(var(--stage-w) / -2);
    transform: scale(var(--pc-scale));
    transform-origin: top center;
  }

  /* The frame chassis. It lived in this file before the grid rewrite too —
     global.css only ever carried the graphics *inside* the frame.

     Floating rather than seated: the frame is inset from the card on
     every side by the card's own --pc-pad, so head room and foot room
     are the same number and match the left and right margins. Seated,
     it met the card's bottom edge and the whole of the slack in the
     card landed above it in one dead band — 109px of it at 1440. */
  .ps-visual-frame {
    position: relative;
    width: 100%;
    height: 100%;
    background: var(--color-paper);
    border-radius: 14px;
    border: 1px solid var(--color-line);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 18px 44px -26px rgb(7 23 34 / 0.35);
  }
  .ps-visual-frame > * { flex: 1; min-height: 0; }

  /* ------------------------------------------------------------
     The compositions render at the sizes global.css ships them at —
     the same ones /services renders — so there is nothing here
     re-proportioning them and nothing hiding parts of them.

     Two blocks used to sit at this point. One de-aired every
     composition to fit a 410px-wide stage; the other took height out
     of them as CONTENT to fit a 316px-tall one, hiding the calendar's
     fifth week, the draft hero's lede and CTA, and the deploy log's
     fourth row. Both existed only because the stage was landscape.
     The stage is 470 × 500 again, which is what these were drawn for,
     so both blocks are gone rather than retuned.

     The one thing kept from them is below: the calendar's chip.
     ------------------------------------------------------------ */

  /* The chip is positioned bottom-right in global.css and floats in a
     band of bare paper, which is the one pocket of dead space the
     restored box does not fix by itself. Seated as a full-width bar it
     fills the band, and it is what gives this composition the same
     bottom margin as the other three. */
  .ps-cal { justify-content: flex-start; }
  .ps-cal-foot { position: static; margin-top: auto; }
  .ps-cal-slot { width: 100%; }

  /* Contrast fix. The out-of-month days were rgb(13 47 69 / 0.22), which
     composites to 1.52:1 against the darkest end of .ps-frame-call's
     gradient (#eef0f6). --color-fg-muted lands at 4.79:1 there and 5.42:1
     at the light end, and still sits a step back from the in-month days
     (--color-fg-soft), so the hierarchy the greying was for survives.
     Overridden here because the rule itself lives in global.css. */
  .ps-cal-grid .off { color: var(--color-fg-muted); }

  /* ============================================================
     FOUR-UP — the open/closed regime.

     Everything that depends on one card being open lives inside
     this one query, gated on width, on a real pointer, AND on the
     reader tolerating motion. Below 1040px, on touch at any width,
     and under reduced motion at any width, the cards fall through to
     the stacked layout above: head, copy, graphic, every card
     standing open, no hover state at all. That is why this section
     needs no separate prefers-reduced-motion block.

     The reveal is horizontal, not vertical. The window is a two
     column row — text panel first, graphic second — and opening a
     card grows the panel while the card itself grows. Nothing is
     ever laid over the graphic; the graphic is pushed across, and
     the panel's flex-basis is written as `100% - 25cqi` against the
     *grid* so that whatever is left for the graphic is exactly one
     resting card width, plus 5px. The graphic therefore comes out
     fractionally larger on open and can never come out smaller, at
     any viewport this query applies at. The container query on
     .pc-visual keeps the mockup filling that column frame by frame.

     It sits at the end of the section on purpose — it overrides the
     stacked rules for .pc-window, .pc-visual and .pc-reveal at the
     same specificity, so it has to come after them.
     ============================================================ */
  /* 1200, not 1040. At 1040 the three cards that yield are already at
     the width of the longest word in their own titles, so an opening
     card has nothing to take and does not grow at all — measured 232px
     open against 232px at rest, which left the copy panel 97px wide and
     cut two thirds of the text off. Below 1200 the stacked layout is
     simply the better one: it shows every card's copy outright and asks
     for no pointer at all. */
  @media (min-width: 1200px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    /* Queried by .pc-reveal below to work out what a resting card is
       worth: (100cqi - 3px of seams) / 4. */
    .process-grid { flex-wrap: nowrap; container-type: inline-size; }
    .process-card {
      flex: 1 1 0;
      /* Unchanged from the vertical-reveal version — the row is no
         taller than it was. `height` rather than `min-height` because
         the copy panel is now a real in-flow flex item: at a resting
         width of 0 its text wraps to one word per line, and against a
         min-height the card would grow to 1,600px to fit it. A
         definite height means .pc-window's `overflow: hidden` is what
         deals with that, as it already did for the parked sheet. */
      /* A quarter of the row is ~0.25vw wide, so a 470:500 graphic on
         it is ~0.266vw tall, and the ~10.1rem is the head and padding
         above it, which barely moves across the range.

         The 41vw this replaces was flat above 1405px — the card was a
         fixed 576px while the landscape graphic kept shrinking with
         the column, so at 1440 there were 109px of empty card above
         the graphic and only 0 below it. That band is what read as the
         graphic sitting awkwardly in its cell. */
      height: clamp(30rem, 26.6vw + 10.1rem, 46rem);
    }
    /* Two lines reserved whatever a title actually needs, so the four
       graphics start on one line across the row instead of two of them
       hanging 36px below the others. */
    .pc-title { min-height: calc(2 * 1.05em); }

    /* 2.75 is the floor, not a taste call. With the text panel at 47%
       of the open card, the graphic keeps 53% of 2.75/5.75 = 25.3% of
       the row against the 25% it holds at rest — so it comes out very
       slightly larger, never smaller. Anything below ~2.68 and the
       graphic shrinks on open, which is the one thing this layout is
       not allowed to do. The three that yield hold 17.4% (227px at
       1440) against the 18.9% they held before. */
    .process-card:hover,
    .process-card:focus-within { flex-grow: 2.75; }

    /* The window is everything below the head, and in this regime it is
       a row: copy on the left, graphic on the right. Its height comes
       from the card, so nothing inside it can move the row. */
    .pc-window {
      flex: 1;
      min-height: 0;
      overflow: hidden;
      flex-direction: row;
      align-items: stretch;
    }

    /* Clipped, not hidden. At rest the panel is exactly 0 wide and
       `overflow: hidden` is the only thing keeping its copy off screen
       — no display:none, no visibility:hidden, no hidden attribute. A
       screen reader reads all three paragraphs of all four cards
       whatever is on screen, and Tab reaches the reveal because
       .pc-head is a real link and the card opens on :focus-within. */
    .pc-reveal {
      flex: 0 0 0%;
      min-width: 0;
      overflow: hidden;
      justify-content: center;
      gap: 0.5rem;
      z-index: 2;
      /* Vertical padding only. Horizontal padding cannot compress below
         its own sum, so a padded panel would still be ~48px wide at a
         flex-basis of 0 and would show a strip of ink down the left of
         every resting card. The inset lives on the children instead. */
      padding: 1.15rem 0;
      background: var(--color-ink);
      /* The panel is inset with the graphic now rather than bleeding to
         the card's edges, so it rounds its own left corners. */
      border-radius: 14px 0 0 14px;
      transition: flex-basis 620ms var(--ease-out-expo);
    }
    .pc-reveal > * { margin-inline: 1.25rem 1rem; }
    /* 42, not 47. The three cards that yield cannot go below the width
       of the longest word in their own title (~244px at 1440), so an
       open card tops out around 560px rather than the 619px its
       flex-grow would otherwise buy it — and at 47% of 560 the graphic
       came out 26px NARROWER than it is at rest, which is the one thing
       this layout must never do. 42% keeps it a couple of px wider than
       resting at every width the query covers. */
    .process-card:hover .pc-reveal,
    .process-card:focus-within .pc-reveal { flex-basis: 42%; }
    /* The column is roughly half a card rather than a whole one, so the
       two paragraphs each step down one size to keep a workable
       measure. The strings are untouched.

       Stepped down again with the panel: at 42% of an open card the
       measure is ~188px, and against the trimmed card height the three
       blocks overran the panel by 31px and lost the last line of the
       second paragraph to overflow: hidden. Nothing is truncated now. */
    .pc-body { font-size: var(--text-step--1); line-height: 1.45; }
    .pc-more { font-size: var(--text-step--2); line-height: 1.45; }

    /* The graphic's height is no longer derived from its width.

       It used to be: aspect-ratio against a flex-driven width. Opening
       a card widened the column, which made the graphic taller than the
       window, and .pc-window's overflow: hidden took the difference off
       — evenly at the top and the bottom, because the graphic is
       centred, which is why both ends of it went at once.

       Now the column simply fills the window (a definite height, since
       the card's is definite) and the stage below scales to fit
       whichever axis runs out first. Nothing can exceed its box on
       either axis at any card width or any frame of the open, so there
       is nothing left to crop and no height curve to keep in step. */
    .pc-visual {
      flex: 1 1 0%;
      min-width: 0;
      align-self: stretch;
      height: auto;
      aspect-ratio: auto;
      container-type: size;
    }
    .pc-stage {
      --pc-scale: clamp(0.3, min(100cqi / var(--stage-w), 100cqb / var(--stage-h)), 1.6);
      top: 50%;
      margin-top: calc(var(--stage-h) / -2);
      transform-origin: center center;
    }

    /* Open card: ink, and every colour set for paper has to flip. */
    .process-card:hover,
    .process-card:focus-within { background: var(--color-ink); }
    .process-card::before { transform: scaleX(0); opacity: 1; }
    .process-card:hover::before,
    .process-card:focus-within::before { transform: scaleX(1); }
    .pc-body { color: rgb(255 255 255 / 0.92); }
    .pc-more { color: rgb(255 255 255 / 0.76); }
    .pc-meta { color: var(--color-periwinkle); }
    .process-card:hover .pc-step,
    .process-card:focus-within .pc-step { color: var(--color-periwinkle); }
    /* Full periwinkle, not the 34% wash it used to carry — the numeral
       is the card's mark and it should read as one. 6.20:1 on ink. */
    .process-card:hover .pc-glyph,
    .process-card:focus-within .pc-glyph { color: var(--color-periwinkle); }
    .process-card:hover .pc-title,
    .process-card:focus-within .pc-title { color: var(--color-paper); }
    .process-card:hover .pc-title em,
    .process-card:focus-within .pc-title em { color: var(--color-periwinkle); }
    /* border-color, not border-top-color: the frame carries all four
       sides now that it floats. */
    .process-card:hover .ps-visual-frame,
    .process-card:focus-within .ps-visual-frame {
      border-color: rgb(255 255 255 / 0.14);
      box-shadow: 0 22px 60px -30px rgb(7 23 34 / 0.7);
    }
  }

  /* ============================================================
     BELOW THE FOUR-UP BREAKPOINT — the copy opens on tap.

     What was here before: every card stood fully open, one under the
     other, so on a phone the section ran four full-height cards deep
     and you scrolled past three blocks of copy you had not asked for.

     Now the graphic is what a card shows at rest — the same contract
     the four-up regime keeps — and the copy is collapsed until the
     card is tapped. Clipped by max-height, never display:none and
     never hidden, so a screen reader still reads all four cards in
     full whatever is open on screen.
     ============================================================ */
  @media (max-width: 1199px) {
    /* Never render a composition larger than the 470px box it was
       drawn in. An open card on a tablet is ~817px wide and the
       graphic followed it all the way up, hitting the scale clamp's
       1.6 ceiling and rendering the 11px mono at 17.6px — which more
       than doubled the height of the grid on one tap.

       align-self, not margin-inline: auto — an auto cross-axis margin
       cancels the stretch a flex item gets by default, and this one
       has no in-flow content to size to (the stage is absolutely
       positioned), so the column would collapse to 0x0. */
    .pc-visual { width: 100%; max-width: var(--stage-w); align-self: center; }

    .pc-reveal {
      max-height: 0;
      padding-block: 0;
      overflow: hidden;
      transition: max-height 460ms var(--ease-out-expo);
    }
    /* A ceiling, not a height — it only has to clear the tallest of the
       four bodies, and a transition needs a length to land on. */
    .process-card.is-open .pc-reveal { max-height: 32rem; padding-bottom: 1.5rem; }

    /* Say what the card does, in words. The arrow alone was not reading as
       "there is more here", so each head carries the instruction and swaps it
       for "Tap to close" once open. */
    .pc-hint {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      margin-top: 0.55rem;
      font-family: var(--font-mono);
      font-size: var(--text-step--2);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-blue);
    }
    .pc-hint-close { display: none; }
    .process-card.is-open .pc-hint-open { display: none; }
    .process-card.is-open .pc-hint-close { display: inline; }
    /* The whole head is the tap target, so give it a real one. */
    .pc-head { min-height: 44px; cursor: pointer; }

    /* The head stops navigating below the breakpoint, so the route to
       /services lives inside the panel it opens. */
    .pc-link-out {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      align-self: flex-start;
      min-height: 44px;
      font-family: var(--font-mono);
      font-size: var(--text-step--2);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-blue);
      text-decoration: none;
    }

    /* The arrow is the only affordance saying the card does something,
       so it points down while the card is closed.

       The hover selectors are repeated because the nudge-right rule
       above is (0,3,0) and a bare .pc-cue is (0,1,0) — without them a
       mouse user in a window under 1200px un-rotates the arrow just by
       pointing at the card. */
    .pc-cue,
    .process-card:hover .pc-cue,
    .process-card:focus-within .pc-cue { transform: rotate(90deg); }
    .process-card.is-open .pc-cue,
    .process-card.is-open:hover .pc-cue,
    .process-card.is-open:focus-within .pc-cue { transform: rotate(-90deg); }
  }

  /* Two up from 600px, not the base rule's 640px, so tablets get the
     2x2 rather than a column of full-width cards. An open card takes a
     whole row, which leaves the fourth alone on the last one — hence
     flex-grow 0, or that card stretched to full width and read as a
     second open card. */
  @media (min-width: 600px) and (max-width: 1199px) {
    .process-card { flex: 0 1 calc(50% - 1px); }
    .process-card.is-open { flex-basis: 100%; }
  }

  /* Phones stay one column. In a 2x2 at 390px a card is 170px wide,
     which puts the mockup frame at 141px and its 11px mono at 3.3px —
     and the scale had already bottomed out on the clamp's 0.3 floor,
     so it cannot be fixed by scaling. Full width the same frame is
     ~293px and reads. */
  @media (max-width: 599px) {
    .process-card,
    .process-card.is-open { flex-basis: 100%; }
  }

  .process-step-featured { background: var(--color-ink); color: var(--color-paper); border-block: 0; }
  .process-step-featured-inner { display: grid; grid-template-columns: 1fr !important; gap: 2.5rem; padding-block: clamp(3rem, 6vh, 5rem) !important; align-items: center; }
  @media (min-width: 900px) {
    .process-step-featured-inner { grid-template-columns: 1.1fr 1fr !important; gap: clamp(2rem, 5vw, 5rem) !important; }
  }
  .process-step-featured-text { display: flex; flex-direction: column; gap: 1.5rem; }
  .ps-step-on-dark { color: var(--color-periwinkle); }
  .ps-title-on-dark { color: var(--color-paper); font-size: var(--text-step-4); font-weight: 350; max-width: 14ch; font-variation-settings: "opsz" 144; line-height: 1; }
  .ps-title-on-dark em { font-style: italic; color: var(--color-periwinkle); font-variation-settings: "opsz" 144; }
  .ps-body-on-dark { color: rgba(255,255,255,0.78); max-width: 42ch; }
  .ps-meta-on-dark { color: rgba(255,255,255,0.4); }

  /* ============================================================
     WHO YOU'LL WORK WITH — condensed port of /studio's .st-thread.
     Astro styles are component-scoped, so the rules below are a copy
     rather than a reference; the class prefix is changed to `thread-`
     / `fold-` so nobody later mistakes them for the /studio originals
     and edits one expecting both to move.

     Differences from /studio, all deliberate: the stage detail is
     always shown instead of revealed on hover (nothing on the
     homepage should sit behind a pointer), the "Hover for what each
     covers" hint is gone with it, and every delay is roughly halved —
     /studio holds the spread state for 3s before collapsing, which is
     far too long for a reader who is scrolling a homepage.
     ============================================================ */
  /* padding-block comes from the shared band rule near the top of this
     stylesheet — this band sits on the same rhythm as the rest. */
  .thread {
    position: relative; overflow: hidden;
    background: var(--color-ink); color: var(--color-paper);
  }
  .thread::before {
    content: ""; position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background: radial-gradient(ellipse 60% 60% at 20% 0%, rgb(142 148 184 / 0.12), transparent 70%);
  }
  .thread .full { position: relative; z-index: 1; }
  .thread-grid {
    display: grid; grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4rem); align-items: center;
  }
  @media (min-width: 1000px) {
    .thread-grid { grid-template-columns: 0.9fr 1.1fr; }
    .fold { margin-top: 0; }
  }
  .thread-copy { max-width: 46ch; }
  .thread-eyebrow {
    display: inline-flex; align-items: center; gap: 12px;
    font-family: var(--font-mono); font-size: var(--text-step--2);
    letter-spacing: 0.14em; text-transform: uppercase;
    color: rgba(255,255,255,0.55);
    margin-bottom: 1.25rem;
  }
  .thread-eyebrow-bar { width: 24px; height: 1px; background: var(--color-periwinkle); }
  .thread-title { font-size: var(--text-step-4); margin: 0; max-width: 18ch; line-height: 1.0; color: var(--color-paper); }
  .thread-title em { color: var(--color-periwinkle); }
  .thread-body {
    margin: 1.25rem 0 0; max-width: 46ch;
    font-family: var(--font-display); font-weight: 300;
    font-size: var(--text-step-1); line-height: 1.5;
    color: rgba(255,255,255,0.78); font-variation-settings: "opsz" 60;
    text-wrap: pretty;
  }

  .fold {
    margin-top: clamp(2.5rem, 6vh, 4rem);
    display: flex; flex-direction: column; align-items: center;
    gap: 1.25rem;
  }
  .fold-cap {
    font-family: var(--font-mono); font-size: var(--text-step--2);
    letter-spacing: 0.14em; text-transform: uppercase;
    transition: opacity 1200ms var(--ease-soft) 2200ms;
  }
  .fold-cap-before { color: rgba(255,255,255,0.42); opacity: 1; }
  .fold-cap-after { color: var(--color-periwinkle); opacity: 0; }

  /* Fixed height so the collapse never reflows the page around it. */
  .fold-stage {
    position: relative;
    width: 100%;
    height: 220px;
    display: flex; align-items: center; justify-content: center;
  }

  .fold-card {
    position: absolute; top: 50%; left: 50%;
    display: flex; align-items: center; justify-content: center;
    text-align: center;
    width: clamp(104px, 17vw, 152px); height: 84px;
    padding: 0.5rem;
    border-radius: 12px;
    font-family: var(--font-mono); font-size: var(--text-step--2);
    letter-spacing: 0.04em; line-height: 1.35;
    /* Spread from centre by index, with a little rotation so they read
       as separate physical objects rather than a row of divs.
       The step was 18vw / 168px, which at 1440 put the five cards across
       824px inside a 700px column — the outer two ran off the section's
       right edge and got clipped, which read as a bug rather than as a
       crop. 9vw / 126px keeps the whole spread inside the column. */
    --spread: calc((var(--i) - 2) * clamp(84px, 9vw, 126px));
    --rot: calc((var(--i) - 2) * 2.5deg);
    margin: -42px 0 0 calc(clamp(104px, 17vw, 152px) * -0.5);
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.16);
    color: rgba(255,255,255,0.66);
    box-shadow: 0 18px 40px -22px rgba(0,0,0,0.7);
    transform: translateX(var(--spread)) rotate(var(--rot));
    transition:
      transform 2400ms var(--ease-out-expo),
      opacity 1400ms var(--ease-soft);
    transition-delay: calc(2400ms + var(--i) * 120ms);
  }

  .fold-solo {
    position: absolute; top: 50%; left: 50%;
    width: min(560px, 100%);
    /* translate, not a negative margin: `margin-left: min(-280px, -50%)`
       picks the *more negative* value, so on a wide stage it resolves to
       -50% of the container and throws the card left of centre. */
    transform: translate(-50%, -50%) scale(0.94);
    display: flex; flex-direction: column; align-items: center; gap: 0.7rem;
    padding: 1.15rem 1.25rem;
    border-radius: 14px;
    background: var(--color-periwinkle);
    border: 1px solid var(--color-periwinkle);
    color: var(--color-navy);
    box-shadow: 0 26px 60px -24px rgba(142,148,184,0.7);
    opacity: 0;
    transition:
      opacity 1200ms var(--ease-soft) 4000ms,
      transform 1600ms var(--ease-out-expo) 4000ms;
  }
  .fold-solo :global(.fold-mark) {
    height: clamp(44px, 6vw, 60px); width: auto; display: block;
    color: var(--color-navy);
  }
  /* The mark's shadow layer is periwinkle, which is this card's
     background — it would vanish. Re-tint it so the mark keeps its
     two-layer offset. */
  .fold-solo :global(.fold-mark) > g:first-of-type path {
    fill: rgba(13, 47, 69, 0.22);
  }
  .fold-solo-label {
    font-family: var(--font-mono); font-size: var(--text-step--2);
    font-weight: 500; text-transform: uppercase; letter-spacing: 0.16em;
  }
  .fold-solo-stages {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem 0.9rem;
    padding-top: 0.8rem;
    border-top: 1px solid rgba(13,47,69,0.22);
    width: 100%;
  }
  .fold-stg { display: flex; flex-direction: column; gap: 0.2rem; text-align: center; }
  .fold-stg b {
    font-family: var(--font-display); font-weight: 400;
    font-size: var(--text-step-0); color: var(--color-navy);
    font-variation-settings: "opsz" 40;
  }
  .fold-stg i {
    font-style: normal;
    font-family: var(--font-mono); font-size: 10px;
    line-height: 1.35; letter-spacing: 0.02em;
    color: rgba(13,47,69,0.68);
  }
  /* Detail reveals on hover, as on /studio: the collapsed card stays tight
     and hovering expands it to say what each stage actually covers.

     Nothing is put out of reach by that. The whole graphic is
     aria-hidden, and the .sr-only paragraph beneath it carries the same
     four descriptions in prose — so assistive tech already has the
     content and the reveal can stay purely presentational.

     Keyboard parity is handled in two ways, because :focus-within alone
     cannot carry it here. There is deliberately nothing focusable inside
     the graphic — a tab stop inside an aria-hidden subtree is its own
     WCAG failure (axe `aria-hidden-focus`), so adding one to hang the
     reveal on would trade a small problem for a real one. So instead:
     the .sr-only prose below carries all four descriptions verbatim, and
     the *collapse* is gated on a fine pointer rather than the reveal, so
     a reader who cannot hover — touch, or switch control — gets the
     descriptions standing open rather than a hint they can never act on.
     :focus-within is still paired with :hover below so the reveal fires
     if focus ever does land inside, but it is the belt, not the braces. */
  .fold-solo-hint { display: none; }
  @media (hover: hover) and (pointer: fine) {
    .fold-stg i {
      max-height: 0; opacity: 0; overflow: hidden;
      transition: max-height 420ms var(--ease-soft), opacity 300ms var(--ease-soft);
    }
    .fold-solo:hover .fold-stg i,
    .fold-solo:focus-within .fold-stg i { max-height: 4rem; opacity: 1; }
    .fold-solo:hover,
    .fold-solo:focus-within { box-shadow: 0 34px 70px -22px rgba(142,148,184,0.85); }
    .fold-solo-hint {
      display: block;
      font-family: var(--font-mono); font-size: 9px;
      letter-spacing: 0.16em; text-transform: uppercase;
      color: rgba(13,47,69,0.45);
      transition: opacity 300ms var(--ease-soft);
    }
    .fold-solo:hover .fold-solo-hint,
    .fold-solo:focus-within .fold-solo-hint { opacity: 0; }
  }

  /* Collapse, on scroll into view. */
  .fold.is-inview .fold-card { transform: translateX(0) rotate(0deg) scale(0.86); opacity: 0; }
  .fold.is-inview .fold-solo { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  .fold.is-inview .fold-cap-before { opacity: 0; }
  .fold.is-inview .fold-cap-after { opacity: 1; }

  /* [data-mv-watch] holds elements at opacity 0 until observed; this one
     animates its children instead, so the container itself stays visible. */
  .fold[data-mv-watch] { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .fold-card { opacity: 0; transform: none; }
    .fold-solo { opacity: 1; transform: translate(-50%, -50%); }
    .fold-cap-before { opacity: 0; }
    .fold-cap-after { opacity: 1; }
  }

  @media (max-width: 700px) {
    /* The fan does not survive a phone. Five 100px cards need ~500px of
       spread to sit side by side and there is 390px, so the step was 52px:
       every card covered half of its neighbour and the five labels printed
       on top of each other. Below 700px they stop being a spread and become
       a wrapped row of chips — the same five roles, all legible, and the
       collapse still plays as a fade-and-shrink toward the card underneath. */
    .fold-stage {
      height: auto;
      /* Has to clear the collapsed card, which is pinned to the stage's
         centre and runs ~250px tall once the four stages wrap to 2x2.
         Under that it printed over the caption below it. */
      min-height: 290px;
      flex-wrap: wrap;
      align-content: center;
      gap: 0.5rem;
      padding: 0.5rem 0;
    }
    .fold-card {
      position: static;
      width: auto;
      height: auto;
      margin: 0;
      padding: 0.6rem 0.85rem;
      font-size: 11px;
      border-radius: 999px;
      transform: none;
      transition:
        transform 700ms var(--ease-out-expo),
        opacity 500ms var(--ease-soft);
      transition-delay: calc(900ms + var(--i) * 70ms);
    }
    /* The line break only exists to keep "Account manager" inside a
       fixed-width card; a chip sizes to its own text. */
    .fold-card :global(br) { display: none; }
    .fold.is-inview .fold-card { transform: scale(0.9); opacity: 0; }

    /* Cards are in the flow now, so the solo card cannot hang off the
       stage's centre without being pinned over them. */
    .fold-solo { top: 50%; }
    .fold-solo { width: 100%; }
    .fold-solo-stages { grid-template-columns: repeat(2, 1fr); gap: 0.6rem 0.75rem; }
  }

  @media (max-width: 1000px) {
    .hero-outer { min-height: 0; padding-block: 2rem 3rem; }
    .hero { grid-template-columns: 1fr; gap: 2.5rem; }
    .hero-left { padding-right: var(--pad-x); }
    .hero-title { font-size: clamp(2.6rem, 9vw, 4.5rem); }
    /* Narrow screens: let a long phrase wrap rather than overflow the column. */
    .hero-swap-item { white-space: normal; }
  }
</style>

<script is:inline>
  // Process cards — tap to open, below the four-up breakpoint.
  //
  // .pc-head stays the real link it already is: the first tap on a
  // closed card opens it instead of navigating, and a second tap on an
  // open card follows the link through to /services as before. No
  // markup changes, so the desktop hover regime and the screen-reader
  // reading order are untouched, and above the breakpoint this does
  // nothing at all — the link behaves like a link and the card opens
  // on hover and focus as it always has.
  (() => {
    const grid = document.querySelector('.process-grid');
    if (!grid) return;
    const cards = Array.from(grid.querySelectorAll('.process-card'));
    const mq = window.matchMedia('(max-width: 1199px)');

    const sync = () => {
      cards.forEach((card) => {
        const head = card.querySelector('.pc-head');
        if (mq.matches) {
          head.setAttribute('aria-expanded', String(card.classList.contains('is-open')));
        } else {
          // Leaving aria-expanded on a plain link above the breakpoint
          // would announce a disclosure that no longer exists.
          head.removeAttribute('aria-expanded');
          card.classList.remove('is-open');
        }
      });
    };

    cards.forEach((card) => {
      card.querySelector('.pc-head').addEventListener('click', (event) => {
        if (!mq.matches) return;
        // Below the breakpoint the head is the disclosure's button, not a
        // link: tapping an open card closes it again. The route to /services
        // moves inside the panel (.pc-link-out), so nothing is lost.
        event.preventDefault();
        const open = card.classList.contains('is-open');
        // One open at a time, so the grid never grows past two rows.
        cards.forEach((other) => other.classList.remove('is-open'));
        if (!open) card.classList.add('is-open');
        sync();
      });
    });

    mq.addEventListener('change', sync);
    sync();
  })();

  // Selected work — on phones/tablets each shot's caption is a disclosure for
  // Process mockups — fit each fixed-size stage to the column it lands in.
  // This is a ratio of two lengths, which CSS calc() cannot compute, so it is
  // measured here and written back as --pc-scale. Without it the stages render
  // at the stylesheet's fallback and overflow their cards on a phone.
  (() => {
    const stages = Array.from(document.querySelectorAll('.pc-stage'));
    if (!stages.length) return;
    const fit = () => {
      stages.forEach((stage) => {
        const box = stage.parentElement;
        if (!box) return;
        const w = box.clientWidth;
        if (!w) return;
        const cs = getComputedStyle(stage);
        const baseW = parseFloat(cs.width) || 470;
        const baseH = parseFloat(cs.height) || 500;
        // Fit BOTH axes. Width-only fitting is what cropped the top of the
        // draft browser and the bottom of the revisions sheet: the column is
        // shorter than 500 * (w / 470) in the four-up regime, and .pc-visual
        // clips the overflow. Height is only a constraint when the box has a
        // definite one (the stage is absolutely positioned, so clientHeight
        // is 0 in the stacked layout, where aspect-ratio already sizes it).
        const h = box.clientHeight;
        const ratio = h > 0 ? Math.min(w / baseW, h / baseH) : w / baseW;
        const s = Math.min(Math.max(ratio, 0.3), 1.6);
        stage.style.setProperty('--pc-scale', String(s));
      });
    };
    fit();
    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(fit);
      stages.forEach((s) => s.parentElement && ro.observe(s.parentElement));
    } else {
      window.addEventListener('resize', fit, { passive: true });
    }
  })();

  // Selected work — on phones/tablets each shot's caption is a disclosure for
  // what that project covered. Above 900px the CSS keeps every panel open and
  // the cursor gallery takes over, so this listener simply does nothing there.
  (() => {
    const toggles = Array.from(document.querySelectorAll('[data-wk-toggle]'));
    if (!toggles.length) return;
    const mq = window.matchMedia('(max-width: 899px)');

    const sync = () => {
      toggles.forEach((t) => {
        if (mq.matches) {
          if (!t.hasAttribute('aria-expanded')) t.setAttribute('aria-expanded', 'false');
        } else {
          // Above the breakpoint the panel is always visible, so announcing a
          // collapsed disclosure would be a lie.
          t.removeAttribute('aria-expanded');
        }
      });
    };

    toggles.forEach((t) => {
      t.addEventListener('click', () => {
        if (!mq.matches) return;
        const open = t.getAttribute('aria-expanded') === 'true';
        // One open at a time keeps the band a predictable length.
        toggles.forEach((o) => o.setAttribute('aria-expanded', 'false'));
        t.setAttribute('aria-expanded', String(!open));
      });
    });

    mq.addEventListener('change', sync);
    sync();
  })();

  // Services bento — count up the headline price when it enters the viewport.
  (() => {
    const el = document.getElementById('bhAmount');
    if (!el) return;
    const target = parseInt(el.dataset.target, 10) || 6000;
    const fmt = (n) => n.toLocaleString('en-US');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) { el.textContent = fmt(target); return; }
    const run = () => {
      const dur = 1400;
      const start = performance.now();
      el.textContent = '0';
      const step = (ts) => {
        const t = Math.min((ts - start) / dur, 1);
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = fmt(Math.round(eased * target));
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { io.disconnect(); run(); } });
      }, { threshold: 0.4 });
      io.observe(el);
    } else { run(); }
  })();
</script>
