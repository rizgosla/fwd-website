---
// /contact — "one question at a time" stepper.
//
// Progressive enhancement, deliberately: the markup below is one ordinary
// <form> with four <fieldset>s, so with JS dead it renders as a normal
// long-form contact page and still POSTs to /api/inquiry. The inline script
// turns those fieldsets into steps. Nothing that matters lives in JS only.
import BaseLayout from "../layouts/BaseLayout.astro";
import Marquee from "../components/Marquee.astro";

const steps = [
  { n: "01", label: "Who you are" },
  { n: "02", label: "What you are building" },
  { n: "03", label: "Shape of the project" },
  { n: "04", label: "When you'd start" },
];
---

<BaseLayout
  title="Contact — Orange County Web Design | Forward Design"
  description="Start a web design project with our Orange County studio. Tell us what you are building and get a flat-fee proposal back within a day. No discovery deck."
  ogImage="/og/contact.jpg"
>
  <section class="ask">
    {/* Ink panel. The only dark surface above the footer on this page. */}
    <div class="ask-rail">
      <div class="ask-rail-inner mv-rise" data-mv-watch>
        <p class="eyebrow"><span>Contact</span></p>
        <h1 class="display ask-h1">Four questions, <em>ninety seconds</em>.</h1>
        <p class="ask-deck">
          Then a flat-fee proposal back within a day. No discovery deck, no
          hourly estimate, no follow-up sequence.
        </p>
      </div>

      {/* Progress + step list. Hidden from the no-JS view — without the
          stepper there are no steps to track. */}
      <div class="ask-progress" data-stepper-only hidden>
        <div class="ask-bar"><div class="ask-bar-fill" id="askBarFill"></div></div>
        <ol class="ask-steps" id="askSteps">
          {steps.map((s, i) => (
            <li>
              <button type="button" class="ask-step" data-goto={i + 1} aria-current={i === 0 ? "step" : undefined}>
                <span class="ask-step-n">{s.n}</span>
                <span class="ask-step-l">{s.label}</span>
                <span class="ask-step-s" aria-hidden="true"></span>
              </button>
            </li>
          ))}
        </ol>
        <p class="ask-slots">
          <span class="status-dot mv-pulse" aria-hidden="true"></span>
          Two studio slots open in June
        </p>
      </div>
    </div>

    {/* Paper panel */}
    <div class="ask-panel">
      <form id="askForm" class="ask-form" method="POST" action="/api/inquiry" novalidate>
        {/* Spam trap — off-screen rather than display:none, which some bots skip.
            No aria-hidden wrapper: it would wrap a focusable input, which
            every automated scanner flags as aria-hidden-focus, and
            tabindex="-1" doesn't mitigate it since the field can still be
            focused by click or script. The off-screen CSS already hides it
            from sighted users, and bots fill any input they find regardless
            of ARIA, so the trap still works without the violation.
            Name/id/label avoid words like "website" or "company" on purpose —
            browser and password-manager autofill match those against saved
            address/business data even on off-screen fields, which would fill
            this trap for a real visitor and cause their genuine submission
            to be silently discarded as spam. */}
        <label class="hp">Leave blank<input type="text" name="hp_verify" id="hp_verify" tabindex="-1" autocomplete="off" aria-label="Leave this field blank" /></label>

        <p class="ask-counter" id="askCounter" data-stepper-only hidden>Question 01 of 04</p>

        <fieldset class="ask-group" data-step="1">
          <legend class="ask-q">First, who are we writing back to?</legend>
          <p class="ask-help">A name and an email. That is the whole of it.</p>
          <div class="ask-pair">
            <label class="field">
              <span class="field-label">Your name <span aria-hidden="true" class="req-marker">*</span></span>
              <input type="text" name="name" class="ask-line" required aria-required="true" autocomplete="name" placeholder="Maya Chen" />
            </label>
            <label class="field">
              <span class="field-label">Email <span aria-hidden="true" class="req-marker">*</span></span>
              <input type="email" name="email" class="ask-line" required aria-required="true" autocomplete="email" placeholder="maya@practice.com" />
            </label>
          </div>
        </fieldset>

        <fieldset class="ask-group" data-step="2">
          <legend class="ask-q">What are you building, in a sentence or two?</legend>
          <p class="ask-help">What it is, who it is for, and what success would look like.</p>
          {/* The legend names the fieldset, not the field inside it, so the
              textarea needs a label of its own. Hidden because the question
              above already asks it out loud — and a placeholder is not a label. */}
          <label class="field">
            <span class="sr-only">What you are building</span>
            <textarea name="brief" rows="5" required aria-required="true" placeholder="A new site for a two-chair dental practice…"></textarea>
          </label>
        </fieldset>

        <fieldset class="ask-group" data-step="3">
          <legend class="ask-q">Is it a full site, or something smaller?</legend>
          <p class="ask-help">Full Site is $4,000 for up to eight pages. Smaller work is quoted separately.</p>
          <div class="ask-radios">
            <label class="radio">
              <input type="radio" name="scope" value="full" checked />
              <span class="radio-content">
                <span class="radio-h">Full Site, $4,000</span>
                <span class="radio-d">Up to 8 pages · about 4 weeks</span>
              </span>
            </label>
            <label class="radio">
              <input type="radio" name="scope" value="smaller" />
              <span class="radio-content">
                <span class="radio-h">Something smaller</span>
                <span class="radio-d">A single landing page or microsite, quoted separately</span>
              </span>
            </label>
            <label class="radio">
              <input type="radio" name="scope" value="not-sure" />
              <span class="radio-content">
                <span class="radio-h">Not sure yet</span>
                <span class="radio-d">We will help you decide</span>
              </span>
            </label>
          </div>
        </fieldset>

        <fieldset class="ask-group" data-step="4">
          <legend class="ask-q">And when would you like to start?</legend>
          <p class="ask-help">Optional — “no rush” is a real answer. We run two builds at a time.</p>
          {/* Same as step 2 — the legend labels the group, not this input. */}
          <label class="field">
            <span class="sr-only">When you'd start</span>
            <input type="text" name="when" class="ask-line" placeholder="June, ASAP, no rush…" />
          </label>
        </fieldset>

        <div class="ask-foot">
          <button type="submit" class="btn btn-primary ask-submit">
            <span class="submit-text">Send inquiry</span>
            <span class="submit-arrow arrow" aria-hidden="true">→</span>
            <span class="submit-spinner" aria-hidden="true"></span>
          </button>
          <button type="button" class="ask-back" id="askBack" data-stepper-only hidden>← Back</button>
          <span class="ask-hint" id="askHint">We reply within a day, every day.</span>
        </div>

        <p class="form-error" id="formError" role="alert" hidden></p>
      </form>

      <div class="form-success" hidden role="status" aria-live="polite">
        <div class="success-icon" aria-hidden="true">
          <svg viewBox="0 0 48 48" width="48" height="48"><circle cx="24" cy="24" r="22" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M14 24l7 7 14-14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <h2 class="display success-h">Got it.</h2>
        <p class="success-p">Your inquiry is in our inbox. One of us will read it today and reply with a proposal by <strong id="successReplyBy">tomorrow afternoon</strong>.</p>
        <p class="success-meta">A confirmation is on its way to <strong id="successEmail">your email</strong>. If you do not see it in 10 minutes, check your spam folder.</p>
        <div class="success-actions">
          <a href="/services" class="link-arrow">Read services in the meantime <span class="arrow">→</span></a>
          <button type="button" id="successReset" class="link-arrow">Send another <span class="arrow">→</span></button>
        </div>
      </div>

      <div class="ask-email">
        <span class="ask-email-l">Rather just write to us?</span>
        <a href="mailto:fwddesignconsulting@gmail.com" class="ask-email-a">fwddesignconsulting@gmail.com</a>
      </div>
    </div>
  </section>

  <Marquee />

  <section class="section section-facts">
    <div class="full">
      <p class="eyebrow" style="margin-bottom: 2.25rem"><span>Before you ask</span></p>
      <div class="facts mv-stagger" data-mv-watch>
        <div class="aside-card">
          <span class="aside-label">Response time</span>
          <span class="aside-val"><span class="status-dot mv-pulse"></span>Usually within a day</span>
          <span class="aside-help">We read every inquiry. If you write in over a weekend you will hear back on Monday.</span>
        </div>
        <div class="aside-card">
          <span class="aside-label">Based in</span>
          <span class="aside-val">Irvine, California</span>
          <span class="aside-help">We work with clients across North America and Europe. Time zone has not been a problem yet.</span>
        </div>
        <div class="aside-card">
          <span class="aside-label">Prefer a call?</span>
          <span class="aside-val">15-minute intro, no obligation</span>
          <span class="aside-help">Once you have sent the four answers (or an email), we will send a calendar link in the reply.</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- Split ------------------------------------------------------- */
  .ask {
    display: grid;
    grid-template-columns: 1fr;
    border-bottom: 1px solid var(--color-hairline);
  }
  @media (min-width: 1000px) {
    .ask { grid-template-columns: 0.85fr 1.15fr; align-items: stretch; }
  }

  /* ---- Ink rail ---------------------------------------------------- */
  .ask-rail {
    position: relative;
    overflow: hidden;
    background: var(--color-ink);
    color: var(--color-paper);
    padding: clamp(3rem, 8vh, 5.5rem) clamp(2rem, 4vw, 3.5rem) clamp(3rem, 8vh, 5.5rem) var(--pad-x);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(2.5rem, 6vh, 4rem);
  }
  /* Lights the top-left, the opposite corner to .ft::before, so rail and
     footer read as two planes rather than one ink field. */
  .ask-rail::before {
    content: "";
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 70% 55% at 15% 0%, rgb(142 148 184 / 0.16), transparent 70%);
    pointer-events: none;
  }
  .ask-rail-inner, .ask-progress { position: relative; z-index: 1; }
  .ask-rail .eyebrow { color: var(--color-periwinkle); margin-bottom: 1.75rem; }
  .ask-rail .eyebrow::before { background: var(--color-periwinkle); }

  .ask-h1 {
    font-size: var(--text-step-4);
    margin: 0 0 1.25rem;
    color: var(--color-paper);
    max-width: 13ch;
  }
  .ask-h1 em { color: var(--color-periwinkle); }
  .ask-deck {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 300; font-style: italic;
    font-size: var(--text-step-1);
    line-height: 1.35;
    color: rgba(255,255,255,0.75);
    max-width: 34ch;
    font-variation-settings: "opsz" 80;
  }

  .ask-progress { display: flex; flex-direction: column; gap: 1.1rem; }
  .ask-bar { height: 2px; border-radius: 999px; background: rgba(255,255,255,0.12); overflow: hidden; }
  .ask-bar-fill {
    height: 100%; width: 25%;
    border-radius: 999px;
    background: var(--color-periwinkle);
    transition: width 700ms var(--ease-soft);
  }
  .ask-steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.15rem; }
  .ask-step {
    width: 100%;
    display: flex; align-items: baseline; gap: 0.9rem;
    padding: 0.15rem 0;
    text-align: left;
    opacity: 0.4;
    transition: opacity 240ms var(--ease-soft);
  }
  .ask-step.is-done { opacity: 0.75; }
  .ask-step[aria-current="step"] { opacity: 1; }
  .ask-step-n {
    font-family: var(--font-mono); font-size: var(--text-step--2);
    letter-spacing: 0.14em; color: var(--color-periwinkle);
    width: 26px; flex-shrink: 0;
  }
  .ask-step-l {
    font-family: var(--font-display); font-weight: 400;
    font-size: var(--text-step-0); color: var(--color-paper);
    font-variation-settings: "opsz" 60;
  }
  .ask-step-s {
    margin-left: auto;
    font-family: var(--font-mono); font-size: 11px;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--color-periwinkle);
  }
  .ask-step.is-done .ask-step-s::after { content: "done"; color: #2bb673; }
  .ask-step[aria-current="step"] .ask-step-s::after { content: "now"; }

  .ask-slots {
    margin: 0;
    display: flex; align-items: center; gap: 0.65rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255,255,255,0.10);
    font-family: var(--font-mono); font-size: var(--text-step--2);
    letter-spacing: 0.06em; color: rgba(255,255,255,0.6);
  }
  .ask-slots .status-dot { width: 8px; height: 8px; border-radius: 50%; background: #2bb673; flex-shrink: 0; }

  /* ---- Paper panel ------------------------------------------------- */
  .ask-panel {
    background: var(--color-paper);
    padding: clamp(3rem, 8vh, 5.5rem) var(--pad-x) clamp(3rem, 8vh, 5.5rem) clamp(2rem, 4vw, 3.5rem);
    display: flex; flex-direction: column; justify-content: center;
    min-height: 34rem;
  }
  .ask-form {
    display: flex; flex-direction: column; gap: 1.75rem;
    transition: opacity 320ms var(--ease-soft), transform 320ms var(--ease-soft);
  }
  .ask-counter {
    margin: 0;
    font-family: var(--font-mono); font-size: var(--text-step--2);
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--color-fg-muted);
  }

  .ask-group { border: 0; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.75rem; }
  /* Stepper mode only — with JS off every group stays in the flow. */
  .ask-form.is-stepped .ask-group { display: none; }
  .ask-form.is-stepped .ask-group.is-active { display: flex; animation: mvRise var(--motion-dur-base) var(--ease-out-expo) both; }

  .ask-q {
    font-family: var(--font-display); font-weight: 350;
    font-size: var(--text-step-3);
    line-height: 1.04; letter-spacing: -0.025em;
    color: var(--color-navy);
    max-width: 22ch;
    font-variation-settings: "opsz" 144;
    text-wrap: balance;
    padding: 0; margin: 0 0 0.25rem;
  }
  .ask-help {
    margin: 0 0 0.75rem;
    font-family: var(--font-display); font-weight: 300;
    font-size: var(--text-step-1); color: var(--color-fg-muted);
    max-width: 46ch;
    font-variation-settings: "opsz" 60;
  }

  .ask-pair { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 720px) { .ask-pair { grid-template-columns: 1fr 1fr; } }

  /* Underlined inputs rather than boxes — the question is the heading here,
     so a boxed field would compete with it. Textarea keeps its box. */
  .ask-line {
    font-family: var(--font-sans);
    font-size: var(--text-step-1);
    color: var(--color-fg);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--color-line-strong);
    border-radius: 0;
    padding: 0.7rem 0.15rem;
    transition: border-color 200ms var(--ease-soft);
  }
  .ask-line:focus { outline: none; border-bottom-color: var(--color-blue); }
  .ask-group textarea {
    font-family: var(--font-sans);
    font-size: var(--text-step-0);
    line-height: 1.6;
    color: var(--color-fg);
    background: var(--color-bg-soft);
    border: 1px solid var(--color-line);
    border-radius: 12px;
    padding: 1.1rem 1.15rem;
    resize: vertical; min-height: 9rem;
    transition: border-color 200ms var(--ease-soft), background 200ms var(--ease-soft), box-shadow 200ms var(--ease-soft);
  }
  .ask-group textarea:focus {
    outline: none;
    background: var(--color-paper);
    border-color: var(--color-blue);
    box-shadow: 0 0 0 3px rgb(20 70 103 / 0.12);
  }

  .ask-radios { display: flex; flex-direction: column; gap: 0.75rem; }

  .ask-foot {
    display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap;
    padding-top: 0.5rem;
  }
  .ask-submit { min-width: 180px; justify-content: center; position: relative; }
  .ask-back {
    font-family: var(--font-mono); font-size: var(--text-step--2);
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--color-fg-muted);
    transition: color 200ms var(--ease-soft);
  }
  .ask-back:hover { color: var(--color-blue); }
  .ask-back[disabled] { opacity: 0.35; cursor: default; }
  .ask-hint {
    margin-left: auto;
    font-family: var(--font-mono); font-size: var(--text-step--2);
    letter-spacing: 0.06em; color: var(--color-fg-muted);
  }

  .ask-email {
    margin-top: 2.5rem; padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
    display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; flex-wrap: wrap;
  }
  .ask-email-l {
    font-family: var(--font-mono); font-size: var(--text-step--2);
    letter-spacing: 0.06em; color: var(--color-fg-muted);
  }
  .ask-email-a {
    font-family: var(--font-display); font-weight: 350; font-style: italic;
    font-size: var(--text-step-1); color: var(--color-blue);
    border-bottom: 1px solid var(--color-line-strong);
    padding-bottom: 2px;
    font-variation-settings: "opsz" 60;
    transition: border-color 200ms var(--ease-soft);
  }
  .ask-email-a:hover { border-bottom-color: var(--color-blue); }

  /* ---- Facts band -------------------------------------------------- */
  /* Soft ground with white cards, so this reads as its own plane between
     the marquee and the ink footer rather than more of the form page. */
  .section-facts { background: var(--color-bg-soft); border-bottom: 1px solid var(--color-hairline); }
  .facts { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  @media (min-width: 800px) { .facts { grid-template-columns: repeat(3, 1fr); } }
  .section-facts .aside-card { background: var(--color-paper); }

  /* ---- Shared bits carried over from the previous /contact ---------- */
  .field { display: flex; flex-direction: column; gap: 0.5rem; }
  .field-label {
    font-family: var(--font-mono); font-size: var(--text-step--2);
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--color-fg-muted); font-weight: 500;
  }
  .req-marker { color: var(--color-blue); margin-left: 0.15em; }

  .radio {
    display: flex; gap: 0.85rem; align-items: flex-start;
    padding: 1rem 1.1rem;
    border: 1px solid var(--color-line); border-radius: 10px;
    background: var(--color-paper); cursor: pointer;
    transition: border-color 200ms var(--ease-soft), background 200ms var(--ease-soft), box-shadow 200ms var(--ease-soft);
  }
  .radio:hover { border-color: var(--color-line-strong); background: var(--color-bg-soft); }
  .radio:has(input:checked) { border-color: var(--color-navy); background: var(--color-paper); box-shadow: 0 0 0 3px rgb(20 70 103 / 0.10); }
  .radio input {
    appearance: none; -webkit-appearance: none;
    width: 18px; height: 18px; flex-shrink: 0; margin-top: 2px;
    border: 1.5px solid var(--color-line-strong); border-radius: 50%;
    position: relative; cursor: pointer;
    transition: border-color 200ms var(--ease-soft);
  }
  .radio input:checked { border-color: var(--color-blue); }
  .radio input:checked::after {
    content: ""; position: absolute;
    width: 9px; height: 9px; border-radius: 50%;
    background: var(--color-blue);
    left: 50%; top: 50%; transform: translate(-50%, -50%);
  }
  .radio-content { display: flex; flex-direction: column; gap: 0.2rem; }
  .radio-h {
    font-family: var(--font-display); font-weight: 400;
    font-size: var(--text-step-0); color: var(--color-fg);
    font-variation-settings: "opsz" 60;
  }
  .radio-d {
    font-family: var(--font-mono); font-size: var(--text-step--2);
    letter-spacing: 0.04em; color: var(--color-fg-muted);
  }

  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .form-error {
    margin: 0; padding: 0.9rem 1.1rem;
    border: 1px solid #c2786a; border-left-width: 3px; border-radius: 8px;
    background: rgb(194 120 106 / 0.06); color: #8f4436;
    font-size: var(--text-step--1); line-height: 1.5;
  }
  .ask-submit[aria-busy="true"] { background: var(--color-blue); cursor: progress; }
  .submit-arrow, .submit-spinner { transition: opacity 200ms var(--ease-soft); }
  .submit-spinner {
    opacity: 0; position: absolute; right: 1.25rem;
    width: 14px; height: 14px;
    border: 1.5px solid rgb(255 255 255 / 0.3);
    border-top-color: var(--color-paper);
    border-radius: 50%;
    animation: spin 700ms linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .form-success { display: flex; flex-direction: column; gap: 1rem; animation: mvSoften var(--motion-dur-slow) var(--ease-out-expo) both; }
  .success-icon { color: var(--color-blue); margin-bottom: 0.5rem; }
  .success-h { font-size: var(--text-step-4); margin: 0; color: var(--color-navy); }
  .success-p {
    margin: 0; max-width: 50ch;
    font-family: var(--font-display); font-weight: 300;
    font-size: var(--text-step-1); line-height: 1.45;
    color: var(--color-fg-soft);
    font-variation-settings: "opsz" 60;
  }
  .success-p strong { color: var(--color-fg); font-weight: 500; }
  .success-meta {
    margin: 0;
    font-family: var(--font-mono); font-size: var(--text-step--2);
    letter-spacing: 0.06em; color: var(--color-fg-muted);
  }
  .success-meta strong { color: var(--color-blue); font-weight: 500; }
  .success-actions {
    display: flex; gap: 2rem; flex-wrap: wrap;
    padding-top: 1.5rem; margin-top: 0.5rem;
    border-top: 1px solid var(--color-line);
  }
  .success-actions .link-arrow { background: none; border: 0; padding: 0; border-bottom: 1px solid var(--color-line-strong); }

  .aside-card {
    padding: 1.5rem;
    border: 1px solid var(--color-line); border-radius: 12px;
    background: var(--color-bg-soft);
    display: flex; flex-direction: column; gap: 0.5rem;
    transition: border-color 280ms var(--ease-soft), transform 280ms var(--ease-soft);
  }
  .aside-card:hover { border-color: var(--color-navy); transform: translateY(-2px); }
  .aside-label {
    font-family: var(--font-mono); font-size: var(--text-step--2);
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-fg-muted);
  }
  .aside-val {
    font-family: var(--font-display); font-weight: 400;
    font-size: var(--text-step-1); color: var(--color-navy);
    letter-spacing: -0.01em; line-height: 1.2;
    font-variation-settings: "opsz" 60;
    display: inline-flex; align-items: center; gap: 0.5rem;
  }
  .aside-val .status-dot { width: 8px; height: 8px; border-radius: 50%; background: #2bb673; flex-shrink: 0; }
  .aside-help { font-size: var(--text-step--1); color: var(--color-fg-muted); line-height: 1.5; }
</style>

<script is:inline>
  (() => {
    const form = document.getElementById('askForm');
    const success = document.querySelector('.form-success');
    if (!form || !success) return;

    /* ---- Stepper ---------------------------------------------------- */
    const groups = [...form.querySelectorAll('.ask-group')];
    const stepBtns = [...document.querySelectorAll('.ask-step')];
    const barFill = document.getElementById('askBarFill');
    const counter = document.getElementById('askCounter');
    const backBtn = document.getElementById('askBack');
    const hint = document.getElementById('askHint');
    const submitText = form.querySelector('.submit-text');
    const total = groups.length;
    let step = 1;

    // Reveal the stepper chrome only now that JS is confirmed alive.
    document.querySelectorAll('[data-stepper-only]').forEach((el) => { el.hidden = false; });
    form.classList.add('is-stepped');

    const render = () => {
      groups.forEach((g) => g.classList.toggle('is-active', Number(g.dataset.step) === step));
      stepBtns.forEach((b, i) => {
        const n = i + 1;
        b.classList.toggle('is-done', n < step);
        if (n === step) b.setAttribute('aria-current', 'step');
        else b.removeAttribute('aria-current');
      });
      barFill.style.width = (step / total) * 100 + '%';
      counter.textContent = 'Question 0' + step + ' of 0' + total;
      backBtn.disabled = step === 1;
      submitText.textContent = step === total ? 'Send inquiry' : 'Continue';
      hint.textContent = step === 3 ? 'Pick one to continue' : 'Press Enter to continue';
      const first = groups[step - 1].querySelector('input, textarea');
      if (first && first.type !== 'radio') first.focus({ preventScroll: true });
    };

    // Only the fields on screen are validated — the later ones aren't
    // answered yet, so reportValidity() on the whole form would fight the user.
    const stepValid = () => {
      const fields = [...groups[step - 1].querySelectorAll('input, textarea')];
      for (const f of fields) {
        if (!f.checkValidity()) { f.reportValidity(); return false; }
      }
      return true;
    };

    const go = (n) => {
      if (n > step && !stepValid()) return;
      step = Math.min(total, Math.max(1, n));
      render();
    };

    backBtn.addEventListener('click', () => go(step - 1));
    stepBtns.forEach((b) => b.addEventListener('click', () => go(Number(b.dataset.goto))));

    // Enter advances instead of submitting, except on the last step.
    form.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' || e.target.tagName === 'TEXTAREA') return;
      if (step < total) { e.preventDefault(); go(step + 1); }
    });

    render();

    /* ---- Submit ----------------------------------------------------- */
    const btn = form.querySelector('.ask-submit');
    const submitArrow = btn.querySelector('.submit-arrow');
    const submitSpinner = btn.querySelector('.submit-spinner');
    const successEmailEl = document.getElementById('successEmail');
    const successResetBtn = document.getElementById('successReset');
    const errEl = document.getElementById('formError');
    const replyByEl = document.getElementById('successReplyBy');

    const setBusy = (busy) => {
      btn.disabled = busy;
      if (busy) btn.setAttribute('aria-busy', 'true'); else btn.removeAttribute('aria-busy');
      submitText.textContent = busy ? 'Sending…' : (step === total ? 'Send inquiry' : 'Continue');
      submitArrow.style.opacity = busy ? '0' : '1';
      submitSpinner.style.opacity = busy ? '1' : '0';
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      // Mid-flow the button means "continue", not "send".
      if (step < total) { go(step + 1); return; }
      if (!form.checkValidity()) { form.reportValidity(); return; }
      errEl.hidden = true;
      setBusy(true);

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const out = await res.json().catch(() => ({}));

        if (!res.ok || !out.ok) {
          // Never pretend this worked — say so, and give them a way through.
          errEl.textContent = (out.error || 'Something went wrong sending that.')
            + ' You can email us directly at fwddesignconsulting@gmail.com.';
          errEl.hidden = false;
          setBusy(false);
          return;
        }

        successEmailEl.textContent = new FormData(form).get('email') || 'your email';
        if (out.replyBy) replyByEl.textContent = out.replyBy;
        form.style.opacity = '0';
        form.style.transform = 'translateY(-8px)';
        setTimeout(() => {
          form.hidden = true;
          document.querySelector('.ask-progress').hidden = true;
          success.hidden = false;
        }, 320);
      } catch {
        errEl.textContent = 'We couldn’t reach the server. Check your connection, '
          + 'or email us directly at fwddesignconsulting@gmail.com.';
        errEl.hidden = false;
        setBusy(false);
      }
    });

    successResetBtn?.addEventListener('click', () => {
      form.reset();
      success.hidden = true;
      form.hidden = false;
      document.querySelector('.ask-progress').hidden = false;
      form.style.opacity = '1';
      form.style.transform = 'translateY(0)';
      errEl.hidden = true;
      setBusy(false);
      step = 1;
      render();
    });
  })();
</script>
