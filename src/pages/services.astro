---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaClose from "../components/CtaClose.astro";
import BrandMark from "../components/BrandMark.astro";

// The timeline is 20 business days. Each phase owns a contiguous run of day
// cells, so the calendar itself carries the sequence and the buttons below are
// just labels. Ranges use hyphens, never en-dashes.
const PHASES = [
  { day: "Day 1", label: "Inquiry", from: 1, to: 1 },
  { day: "Day 2-3", label: "Intro call", from: 2, to: 3 },
  { day: "Day 4", label: "Proposal", from: 4, to: 4 },
  { day: "Day 5-19", label: "Build", from: 5, to: 19 },
  { day: "Day 20", label: "Launch", from: 20, to: 20 },
];

const DAYS = Array.from({ length: 20 }, (_, i) => {
  const n = i + 1;
  const phase = PHASES.findIndex((p) => n >= p.from && n <= p.to);
  return { n, phase, start: n === PHASES[phase].from, end: n === PHASES[phase].to };
});
---

<BaseLayout title="Services & pricing - Forward Design Consulting">
  <!-- ============ HERO — editorial split with a spec index card ============ -->
  <section class="svc-hero">
    <div class="full svc-hero-grid">
      {/* No eyebrow here: the h1 says what the page is, and the page's
          eyebrow budget goes to the timeline and the close. */}
      <div class="svc-hero-copy mv-rise" data-mv-watch>
        <h1 class="display svc-hero-title">One way to <em>get online</em>. One flat fee.</h1>
        <p class="lede svc-hero-lede">No retainers, no scope creep, no hidden hourlies. One fixed price, one fixed timeline.</p>
        <div class="svc-hero-actions">
          <a href="/contact" class="btn btn-primary">Start a project <span class="arrow" aria-hidden="true">→</span></a>
          <a href="#offer" class="btn btn-ghost">See what's included</a>
        </div>
      </div>

      {/* The old spec card restated the bento 400px below it. This shows the
          one promise the bento states but never pictures: eight pages, drawn
          from the same wireframe primitives the hero showcase uses. Exactly
          eight children, which is where .mv-stagger's nth-child list ends. */}
      <figure class="svc-pages-fig">
        <div class="svc-pages mv-stagger" data-mv-watch aria-hidden="true">
          {Array.from({ length: 8 }, () => (
            <span class="pg">
              <span class="pg-nav">
                <span class="pg-logo"></span>
                <span class="pg-links"><span></span><span></span><span></span></span>
              </span>
              <span class="pg-bar"></span>
              <span class="pg-bar pg-bar-2"></span>
              <span class="pg-line"></span>
              <span class="pg-media"></span>
              <span class="pg-pill"></span>
            </span>
          ))}
        </div>
        <figcaption class="svc-pages-cap">Up to eight pages, designed as one system</figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ THE OFFER — bento spec sheet (mirrors homepage) ============ -->
  <section id="offer" class="section section-offer">
    <div class="full">
      <div class="section-head mv-rise" data-mv-watch>
        <h2 class="display section-title">A whole website, <em>one number</em>.</h2>
        <p class="section-sub">Same foundation, every time. The scope is fixed and the price is fixed, so the only thing left to decide is what your site needs to say.</p>
      </div>

      <div class="offer-bento mv-stagger" data-mv-watch>
        <!-- Centerpiece: the offer + price + CTA -->
        <article class="bento-card bento-headline" data-tilt>
          <span class="tier-sheen" aria-hidden="true"></span>
          <div class="bh-top">
            <span class="bh-eyebrow"><span class="live-dot" aria-hidden="true"></span>The offer</span>
            <span class="bh-meta">20 business days · up to 8 pages</span>
          </div>
          <div class="bh-body">
            <h3 class="bh-title">Full <em>Site</em></h3>
            <div class="bh-price">
              <span class="bh-dollar">$</span><span class="bh-amount" id="svcAmount" data-target="4000">4,000</span>
            </div>
            <p class="bh-note">Flat fee. Three rounds of revisions. You own everything when we're done.</p>
          </div>
          <div class="bh-foot">
            <a href="/contact" class="bh-cta">
              <span>Start a project</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
            <div class="bh-ticker" aria-hidden="true">
              <div class="bh-ticker-track">
                <span>Flat fee</span><span class="dot">●</span>
                <span>No retainers</span><span class="dot">●</span>
                <span>3 revision rounds</span><span class="dot">●</span>
                <span>You own it all</span><span class="dot">●</span>
                <span>Flat fee</span><span class="dot">●</span>
                <span>No retainers</span><span class="dot">●</span>
                <span>3 revision rounds</span><span class="dot">●</span>
                <span>You own it all</span><span class="dot">●</span>
              </div>
            </div>
          </div>
        </article>

        <!-- Feature tiles — each its own spotlight -->
        <article class="bento-card bento-feature" data-tilt>
          <span class="tier-sheen" aria-hidden="true"></span>
          <span class="bf-num">i.</span>
          <h4 class="bf-title">Up to <em>8 pages</em></h4>
          <p class="bf-body">Designed cohesively around your brand and content.</p>
        </article>

        <article class="bento-card bento-feature" data-tilt>
          <span class="tier-sheen" aria-hidden="true"></span>
          <span class="bf-num">ii.</span>
          <h4 class="bf-title">Design <em>system</em></h4>
          <p class="bf-body">Type, color, and components — built to last past launch.</p>
        </article>

        <article class="bento-card bento-feature" data-tilt>
          <span class="tier-sheen" aria-hidden="true"></span>
          <span class="bf-num">iii.</span>
          <h4 class="bf-title">Lead <em>capture</em></h4>
          <p class="bf-body">Forms wired to your inbox the day the site goes live.</p>
        </article>

        <article class="bento-card bento-feature" data-tilt>
          <span class="tier-sheen" aria-hidden="true"></span>
          <span class="bf-num">iv.</span>
          <h4 class="bf-title">Mobile + <em>SEO</em></h4>
          <p class="bf-body">Optimized at every breakpoint, on-page SEO baked in.</p>
        </article>

        <article class="bento-card bento-feature" data-tilt>
          <span class="tier-sheen" aria-hidden="true"></span>
          <span class="bf-num">v.</span>
          <h4 class="bf-title">Hosting + <em>domain</em></h4>
          <p class="bf-body">Set up, connected, and included from launch day.</p>
        </article>

        <article class="bento-card bento-feature" data-tilt>
          <span class="tier-sheen" aria-hidden="true"></span>
          <span class="bf-num">vi.</span>
          <h4 class="bf-title">Handoff <em>doc</em></h4>
          <p class="bf-body">So anyone on your team can update content later.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ WALKTHROUGH — animated day-by-day (kept) ============ -->
  <section class="walkthrough">
    <div class="walkthrough-inner">
      <div class="walkthrough-head mv-rise" data-mv-watch>
        <div class="walkthrough-head-copy">
          <span class="walkthrough-eyebrow"><span class="walkthrough-eyebrow-bar"></span>The timeline</span>
          <h2 class="walkthrough-h">What happens, <em>day by day</em>.</h2>
        </div>
        <div class="walkthrough-controls">
          <button id="wtPrev" type="button" aria-label="Previous step">‹ Prev</button>
          <button id="wtAuto" type="button" aria-pressed="true">Auto</button>
          <button id="wtNext" type="button" aria-label="Next step">Next ›</button>
        </div>
      </div>

      {/* Twenty business days as an actual calendar. Each phase owns a run of
          cells and lights up when its panel is active, so the shape of the
          project is visible before you read a word of it. */}
      <div class="walkthrough-track" data-step="0" id="wtTrack">
        <div class="wt-cal">
          <div class="wt-cal-dow" aria-hidden="true">
            <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span>
          </div>
          <div class="wt-cal-grid" aria-hidden="true">
            {DAYS.map((d) => (
              <span
                class:list={["wt-day", d.start && "is-start", d.end && "is-end"]}
                data-phase={d.phase}
                style={`--n:${d.n}`}
              >{d.n}</span>
            ))}
          </div>
        </div>

        <div class="wt-phases" role="tablist" aria-label="Project timeline">
          {PHASES.map((p, i) => (
            <button
              class="walkthrough-marker"
              data-step={i}
              aria-pressed={i === 0 ? "true" : "false"}
              role="tab"
              aria-controls={`wt-panel-${i}`}
            >
              <span class="day">{p.day}</span><span class="lbl">{p.label}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="walkthrough-panel" id="wtPanel" aria-live="polite">
        <div class="walkthrough-step is-active" data-step="0" id="wt-panel-0" role="tabpanel">
          <span class="when">Day 1 · The inquiry lands</span>
          <h4>An inquiry comes in. <em>We answer it</em>.</h4>
          <p>One of us reads every inquiry the day it arrives. You get a written reply with a couple of clarifying questions and a proposed time for a short call.</p>
          <span class="deliv">Reply within 24 hours, every day</span>
        </div>
        <div class="walkthrough-step" data-step="1" id="wt-panel-1" role="tabpanel">
          <span class="when">Day 2 to 3 · The intro call</span>
          <h4>15 minutes, <em>the whole studio</em>, no slide deck.</h4>
          <p>You meet everyone at once. We ask what you do, who you serve, and what the site needs to do for you. You ask whatever you need to. No follow-up sequences.</p>
          <span class="deliv">No prep required from you</span>
        </div>
        <div class="walkthrough-step" data-step="2" id="wt-panel-2" role="tabpanel">
          <span class="when">Day 4 · Proposal and deposit</span>
          <h4>One page. Plain language. <em>50% deposit</em>.</h4>
          <p>A flat-fee proposal and the deposit invoice, together. There is no long contract: one page, one number, one timeline. Once the deposit lands, the clock starts.</p>
          <span class="deliv">Pay by card, bank transfer, or wire</span>
        </div>
        <div class="walkthrough-step" data-step="3" id="wt-panel-3" role="tabpanel">
          <span class="when">Day 5 to 19 · Design, draft, revise</span>
          <h4>First draft live in your browser by <em>end of week one</em>.</h4>
          <p>We build the first version and share a real URL you can open on your phone, not a Figma file. You mark up the changes you want. We revise. Three rounds are included, and everything stays async until you want a call.</p>
          <span class="deliv">Average response on revisions: 1 business day</span>
        </div>
        <div class="walkthrough-step" data-step="4" id="wt-panel-4" role="tabpanel">
          <span class="when">Day 20 · Live</span>
          <h4>Your domain points to the new site. <em>Final invoice sent</em>.</h4>
          <p>We connect DNS, install the SSL cert, run a final QA pass, and hand over a written doc so you can update content yourself. The remaining balance invoice lands the same day. You own all of it: the domain, the hosting account, the code.</p>
          <span class="deliv">Live in 20 business days</span>
        </div>
      </div>
    </div>
  </section>


  <!-- ============ FAQ ============ -->
  <section class="section section-faq">
    <div class="full">
      <div class="section-head mv-rise" data-mv-watch>
        <h2 class="display section-title">Questions we get a <em>lot</em>.</h2>
        <p class="section-sub">If yours is not here, <a class="link-arrow" href="/contact">ask us<span class="arrow">→</span></a>. We add to this list as new ones come up.</p>
      </div>

      {/* The list is paired with the thing it actually is: questions arriving.
          Bubbles reuse the margin-comment treatment from the homepage's
          revision step. Labels are "You" and "fwd.", never a person's name. */}
      <div class="faq-split">
        <aside class="faq-thread mv-stagger" data-mv-watch aria-hidden="true">
          <div class="fq-msg">
            <span class="fq-avatar">You</span>
            <span class="fq-bubble">
              <span class="fq-meta"><b>You</b><i>2m</i></span>
              <span class="fq-text">Can you redesign a site we already have?</span>
            </span>
          </div>
          <div class="fq-msg is-reply">
            <span class="fq-avatar is-mark"><BrandMark class="fq-mark" decorative={true} /></span>
            <span class="fq-bubble">
              <span class="fq-meta"><b>forward</b><i>1m</i></span>
              <span class="fq-text">Yes. Most of our work is redesigns.</span>
            </span>
          </div>
          <div class="fq-msg">
            <span class="fq-avatar">You</span>
            <span class="fq-bubble">
              <span class="fq-meta"><b>You</b><i>just now</i></span>
              <span class="fq-text">Does the price change?</span>
            </span>
          </div>
          <div class="fq-msg is-reply">
            <span class="fq-avatar is-mark"><BrandMark class="fq-mark" decorative={true} /></span>
            <span class="fq-bubble">
              <span class="fq-meta"><b>forward</b><i>now</i></span>
              <span class="fq-text">No. Same flat fee, same 20 days.</span>
            </span>
          </div>
        </aside>

        {/* Cards in a two-column grid rather than stacked hairline rows: a
            list read as a second column of the chat beside it. Classes are
            fq-card-* rather than faq-item so the old global list rules do not
            apply. Still <details>, so it works with no JS. */}
        <div class="fq-cards mv-stagger" data-mv-watch>
          <details class="fq-card" open>
            <summary class="fq-card-q"><span>What if I only need a single landing page?</span><span class="fq-card-icon" aria-hidden="true"></span></summary>
            <div class="fq-card-a"><p>Email us. Smaller projects come up regularly and we quote them at a reduced flat fee within a day, sized to the scope. The $4,000 number is for a full site of up to eight pages.</p></div>
          </details>
          <details class="fq-card">
            <summary class="fq-card-q"><span>What counts as a "small change" after launch?</span><span class="fq-card-icon" aria-hidden="true"></span></summary>
            <div class="fq-card-a"><p>Text fixes, photo swaps, link updates, hours changes. Anything you could send us in a single email and we could ship in an afternoon. Larger changes become a new engagement at a flat fee.</p></div>
          </details>
          <details class="fq-card">
            <summary class="fq-card-q"><span>Who hosts the site after launch?</span><span class="fq-card-icon" aria-hidden="true"></span></summary>
            <div class="fq-card-a"><p>You do. We set up hosting on a platform you own, usually Cloudflare Pages or Netlify, both free at our scale. We connect your domain, set up DNS, and show you how to make a content change. There is no ongoing fee to us.</p></div>
          </details>
          <details class="fq-card">
            <summary class="fq-card-q"><span>Can you redesign an existing site?</span><span class="fq-card-icon" aria-hidden="true"></span></summary>
            <div class="fq-card-a"><p>Yes. Most of our work is redesigns, and the flat-fee structure stays the same. We preserve any SEO that is working, port your existing content, and keep your domain authority intact.</p></div>
          </details>
          <details class="fq-card">
            <summary class="fq-card-q"><span>How do payments work?</span><span class="fq-card-icon" aria-hidden="true"></span></summary>
            <div class="fq-card-a"><p>50% on signed proposal, 50% on launch. Card, bank transfer, or wire, whichever is easiest. One of us sends every invoice and handles every receipt. There are no recurring charges.</p></div>
          </details>
          <details class="fq-card">
            <summary class="fq-card-q"><span>Can I keep updating the site myself?</span><span class="fq-card-icon" aria-hidden="true"></span></summary>
            <div class="fq-card-a"><p>Every project ships with a handoff doc: screenshots and exact file paths, written so non-developers can change text, swap photos, and add new pages without touching code we wrote.</p></div>
          </details>
        </div>
      </div>
    </div>
  </section>

  {/* The FAQ above this is also --color-bg-soft, so the two surfaces meet with
      no tone change. The seam is drawn as a hairline on .section-faq instead. */}
  <CtaClose
    tone="light"
    eyebrow="One number, no surprises"
    lead="Ready to"
    tail="begin?"
    lede="Tell us what you are working on. We will get back to you within a day with a flat-fee proposal."
    note="Flat-fee proposal within a day"
    ticker={["Up to 8 pages", "About 4 weeks", "Hosting included", "You own everything"]}
  />
</BaseLayout>

<style>
  /* ============================================================
     HERO — editorial split. Copy on the left, a light "spec
     index card" on the right that teases the essentials and
     drops the eye down into the offer.
     ============================================================ */
  .svc-hero {
    position: relative;
    padding-block: clamp(3.5rem, 8vh, 6rem) clamp(3rem, 7vh, 5.5rem);
    border-bottom: 1px solid var(--color-hairline);
    overflow: hidden;
  }
  .svc-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }
  @media (min-width: 940px) {
    .svc-hero-grid { grid-template-columns: 1.25fr 0.9fr; }
  }
  .svc-hero-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 1.5rem; }
  /* "get online" is italic and carries a g. .display runs line-height 0.98,
     which clips it at this size. Overridden here rather than in global.css,
     which the locked homepage shares. */
  /* step-5, not step-6: at step-6 this headline runs to three lines at
     desktop in a 1.25fr column. Two is the cap. */
  .svc-hero-title {
    font-size: var(--text-step-5); margin: 0; max-width: 16ch;
    line-height: 1.1; padding-bottom: 0.06em;
  }
  .svc-hero-lede { max-width: 46ch; margin: 0; }
  .svc-hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 0.5rem; }

  /* ============================================================
     HERO VISUAL — eight page thumbnails, built from the same
     wireframe primitives the hero showcase uses on the homepage.
     ============================================================ */
  .svc-pages-fig { margin: 0; display: flex; flex-direction: column; gap: 1.1rem; }
  .svc-pages { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(0.5rem, 1vw, 0.85rem); }
  .pg {
    aspect-ratio: 3 / 4;
    display: flex; flex-direction: column; gap: 5px;
    padding: 8px;
    border-radius: 8px;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    box-shadow: 0 14px 30px -20px rgb(7 23 34 / 0.30);
  }
  .pg-nav { display: flex; align-items: center; gap: 6px; margin-bottom: 1px; }
  .pg-logo { width: 14px; height: 4px; border-radius: 2px; background: rgb(13 47 69 / 0.16); }
  .pg-links { display: flex; gap: 3px; margin-left: auto; }
  .pg-links span { width: 7px; height: 3px; border-radius: 1px; background: rgb(13 47 69 / 0.12); }
  .pg-bar { width: 84%; height: 7px; border-radius: 2px; background: rgb(13 47 69 / 0.18); }
  .pg-bar-2 { width: 58%; }
  .pg-line { width: 70%; height: 3px; border-radius: 1px; background: rgb(13 47 69 / 0.12); }
  .pg-media {
    flex: 1; min-height: 0; margin-top: 1px;
    border-radius: 4px;
    border: 1px dashed rgb(13 47 69 / 0.20);
    background: repeating-linear-gradient(135deg, rgb(13 47 69 / 0.09) 0 6px, transparent 6px 12px);
  }
  .pg-pill { width: 26px; height: 8px; border-radius: 999px; background: var(--color-periwinkle); opacity: 0.55; margin-top: auto; }
  /* Slight variation so eight thumbnails read as eight pages, not a tiled texture. */
  .pg:nth-child(3n) .pg-bar { width: 66%; }
  .pg:nth-child(3n) .pg-bar-2 { width: 44%; }
  .pg:nth-child(4n) .pg-line { width: 52%; }
  .svc-pages-cap {
    font-family: var(--font-mono); font-size: var(--text-step--2);
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--color-fg-muted);
  }
  @media (max-width: 620px) {
    .svc-pages { grid-template-columns: repeat(4, 1fr); gap: 0.4rem; }
    .pg { padding: 5px; gap: 3px; border-radius: 6px; }
    .pg-media { display: none; }
  }

  /* ============================================================
     THE OFFER — bento spec sheet. Mirrors the homepage services
     section: a dark centerpiece (price + CTA) and six annotation
     tiles, each with its own mouse-spotlight sheen.
     ============================================================ */
  .section-offer { padding-block: clamp(4rem, 9vh, 7rem); }
  .section-offer .section-head { margin-bottom: clamp(2.5rem, 5vh, 4rem); }

  .offer-bento {
    display: grid;
    grid-template-columns: 1fr;
    grid-auto-rows: minmax(0, auto);
    gap: 1rem;
  }
  @media (min-width: 760px) {
    .offer-bento { grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  }
  @media (min-width: 1000px) {
    .offer-bento {
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: repeat(3, minmax(180px, 1fr));
      gap: 1.5rem;
    }
  }

  .bento-card {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    --bg: #fff;
    --fg: var(--color-navy);
    --fg-soft: var(--color-fg-soft);
    --fg-muted: var(--color-fg-muted);
    --line: var(--color-line);
    --accent: var(--color-blue);
    --sheen: rgb(13 47 69 / 0.10);
    background: var(--bg);
    color: var(--fg);
    border: 1px solid var(--line);
    border-radius: 14px;
    transition: transform 360ms var(--ease-soft), box-shadow 360ms var(--ease-soft), border-color 360ms var(--ease-soft);
  }
  .bento-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 30px 60px -28px rgb(7 23 34 / 0.28);
  }
  .bento-card .tier-sheen {
    position: absolute; inset: 0;
    pointer-events: none; z-index: 0;
    border-radius: inherit;
    opacity: 0;
    transition: opacity 360ms var(--ease-soft);
    background: radial-gradient(260px circle at var(--mx, 50%) var(--my, 50%), var(--sheen), transparent 60%);
  }
  .bento-card:hover .tier-sheen { opacity: 1; }
  .bento-card > :not(.tier-sheen) { position: relative; z-index: 1; }

  /* Centerpiece — dark "spec card" with price + CTA + ticker */
  .bento-headline {
    --bg: var(--color-navy);
    --fg: #fff;
    --fg-soft: rgba(255,255,255,0.82);
    --fg-muted: rgba(255,255,255,0.55);
    --line: rgba(255,255,255,0.14);
    --accent: var(--color-periwinkle);
    --sheen: rgb(255 255 255 / 0.14);
    display: flex;
    flex-direction: column;
    padding: clamp(2rem, 3.2vw, 2.75rem);
    min-height: 480px;
  }
  @media (min-width: 1000px) {
    .bento-headline { grid-column: 1 / span 2; grid-row: 1 / span 3; min-height: 0; }
  }
  .bh-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .bh-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--font-mono); font-size: var(--text-step--2);
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--fg-muted);
  }
  .bh-eyebrow .live-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--color-periwinkle);
    box-shadow: 0 0 0 0 rgba(142, 148, 184, 0.6);
