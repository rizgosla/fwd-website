---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaClose from "../components/CtaClose.astro";
import BrandMark from "../components/BrandMark.astro";

// The timeline is 20 business days. Each phase owns a contiguous run of day
// cells, so the calendar itself carries the sequence and the buttons below are
// just labels. Ranges use hyphens, never en-dashes.
const PHASES = [
  { day: "Day 1", label: "Inquiry", from: 1, to: 1 },
  { day: "Day 2-3", label: "Intro call", from: 2, to: 3 },
  { day: "Day 4", label: "Proposal", from: 4, to: 4 },
  { day: "Day 5-19", label: "Build", from: 5, to: 19 },
  { day: "Day 20", label: "Launch", from: 20, to: 20 },
];

const DAYS = Array.from({ length: 20 }, (_, i) => {
  const n = i + 1;
  const phase = PHASES.findIndex((p) => n >= p.from && n <= p.to);
  return { n, phase, start: n === PHASES[phase].from, end: n === PHASES[phase].to };
});

// One source for both the rendered <details> list and the FAQPage schema
// below it. Google requires the structured data to match the visible answer
// word for word, so the two cannot be maintained separately.
const FAQS = [
  {
    q: "What if I only need a single landing page?",
    a: "Email us. Smaller projects come up regularly and we quote them at a reduced flat fee within a day, sized to the scope. The $6,000 number is for a full site of up to eight pages.",
  },
  {
    q: 'What counts as a "small change" after launch?',
    a: "Text fixes, photo swaps, link updates, hours changes. Anything you could send us in a single email and we could ship in an afternoon. Larger changes become a new engagement at a flat fee.",
  },
  {
    q: "Who hosts the site after launch?",
    a: "You do. We set up hosting on a platform you own, usually Cloudflare Pages or Netlify, both free at our scale. We connect your domain, set up DNS, and show you how to make a content change. There is no ongoing fee to us.",
  },
  {
    q: "Can you redesign an existing site?",
    a: "Yes. Most of our work is redesigns, and the flat-fee structure stays the same. We preserve any SEO that is working, port your existing content, and keep your domain authority intact.",
  },
  {
    q: "How do payments work?",
    a: "50% on signed proposal, 50% on launch. One of us sends every invoice and handles every receipt. There are no recurring charges.",
  },
  {
    q: "Who updates the site after launch?",
    a: "Send us an email with what you need changed and we will take care of it, subject to our availability. You also get a written handoff doc at launch, in plain language, if you would rather do it yourself.",
  },
  {
    q: "Do you work with businesses outside Orange County?",
    a: "Most of our clients are in Orange County — we are based here too — but we are happy to work with people anywhere in North America. The process is the same either way. Being nearby just means we can meet in person if you would rather.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQS.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};
---

<BaseLayout
  title="Flat-Fee Web Design, $6,000 | Orange County | Forward Design"
  description="Full website design for $6,000 flat — up to eight pages in about four weeks. No retainers, no hourly billing. Serving Irvine and all of Orange County."
  ogImage="/og/services.jpg"
>
  <!-- ============ HERO — editorial split with a spec index card ============ -->
  <section class="svc-hero">
    <div class="full svc-hero-grid">
      {/* No eyebrow here: the h1 says what the page is, and the page's
          eyebrow budget goes to the timeline and the close. */}
      <div class="svc-hero-copy mv-rise" data-mv-watch>
        <h1 class="display svc-hero-title">One way to <em>get online</em>. One flat fee.</h1>
        <p class="lede svc-hero-lede">No retainers, no scope creep, no hidden hourlies. One fixed price, one fixed timeline.</p>
        <div class="svc-hero-actions">
          <a href="/contact" class="btn btn-primary">Start a project <span class="arrow" aria-hidden="true">→</span></a>
          <a href="#offer" class="btn btn-ghost">See what's included</a>
        </div>
      </div>

      {/* The old spec card restated the bento 400px below it. This shows the
          one promise the bento states but never pictures: eight pages, drawn
          from the same wireframe primitives the hero showcase uses. Exactly
          eight children, which is where .mv-stagger's nth-child list ends.

          Each .pg stacks TWO layers in one grid cell:
            .pg-wire — the blank wireframe this block used to be. It is now the
                       "pre-load" state: a page nobody has designed yet.
            .pg-art  — a design specific to that page type, which resolves in
                       on top of the wireframe once the block scrolls into
                       view (see the transition rules in the style block).
          --i is the child's index. Both layers read it to stagger the reveal
          in step with .mv-stagger's own nth-child delays, so each page
          finishes rising before its design lands. The wireframe layer is
          written out per page rather than looped because the eight designs
          have to sit next to their own pre-load state to stay readable.

          Every .pg-art runs FOUR BANDS: nav → primary band → secondary band →
          footer. The footer is the load-bearing one. Before it existed each
          card was nav → content → the content ran out, and a page with a
          header and no bottom reads as a screenshot that got cropped rather
          than as a whole page. Nothing here floats: content bottoms out on the
          footer on all eight, at every width. Keep both properties if you add
          or edit a page. */}
      <figure class="svc-pages-fig">
        <div class="svc-pages mv-stagger" data-mv-watch aria-hidden="true">
          {/* 01 · HOME — photo hero carrying the headline and CTA, three feature cards under it. */}
          <span class="pg" style="--i:0">
            <span class="pg-wire">
              <span class="pg-nav"><span class="pg-logo"></span><span class="pg-links"><span></span><span></span><span></span></span></span>
              <span class="pg-bar"></span><span class="pg-bar pg-bar-2"></span><span class="pg-line"></span>
              <span class="pg-media"></span><span class="pg-pill"></span>
            </span>
            <span class="pg-art pg-home">
              <span class="a-nav"><span class="a-logo"></span><span class="a-links"><span></span><span></span><span></span></span><span class="a-navcta"></span></span>
              <span class="a-hero">
                <span class="a-h" style="width:78%"></span>
                <span class="a-h" style="width:46%"></span>
                <span class="a-l" style="width:64%"></span>
                <span class="a-cta"></span>
              </span>
              {/* The feature cards were three empty outlines. Their marks are
                  --a-ink-mid, NOT the accent: the accent is already spent on
                  the nav CTA and the hero CTA, and a third and fourth
                  appearance is what the note above warns turns it into a
                  second brand colour. */}
              <span class="a-cards">
                <span class="a-card"><span class="a-card-mark"></span><span class="a-l" style="width:86%"></span><span class="a-l" style="width:58%"></span></span>
                <span class="a-card"><span class="a-card-mark"></span><span class="a-l" style="width:78%"></span><span class="a-l" style="width:64%"></span></span>
                <span class="a-card"><span class="a-card-mark"></span><span class="a-l" style="width:90%"></span><span class="a-l" style="width:52%"></span></span>
              </span>
              <span class="a-strip"><span></span><span></span><span></span><span></span></span>
              <span class="a-foot"><span class="a-foot-mark"></span><span class="a-foot-links"><span></span><span></span><span></span></span></span>
            </span>
          </span>

          {/* 02 · SERVICES — page title over three offer rows, the middle one selected. */}
          <span class="pg" style="--i:1">
            <span class="pg-wire">
              <span class="pg-nav"><span class="pg-logo"></span><span class="pg-links"><span></span><span></span><span></span></span></span>
              <span class="pg-bar"></span><span class="pg-bar pg-bar-2"></span><span class="pg-line"></span>
              <span class="pg-media"></span><span class="pg-pill"></span>
            </span>
            <span class="pg-art pg-svc">
              <span class="a-nav"><span class="a-logo"></span><span class="a-links"><span></span><span></span><span></span></span><span class="a-navcta"></span></span>
              <span class="a-h" style="width:56%"></span>
              {/* Each row carries an offer NAME over a description line, not one
                  anonymous bar. Two weights in a row is what separates a
                  services list from a checklist. */}
              <span class="a-list">
                <span class="a-item"><span class="a-sq"></span><span class="a-item-copy"><span class="a-h-sm" style="width:58%"></span><span class="a-l" style="width:92%"></span></span></span>
                <span class="a-item is-on"><span class="a-sq"></span><span class="a-item-copy"><span class="a-h-sm" style="width:72%"></span><span class="a-l" style="width:86%"></span></span></span>
                <span class="a-item"><span class="a-sq"></span><span class="a-item-copy"><span class="a-h-sm" style="width:64%"></span><span class="a-l" style="width:96%"></span></span></span>
              </span>
              <span class="a-foot"><span class="a-foot-mark"></span><span class="a-foot-links"><span></span><span></span><span></span></span></span>
            </span>
          </span>

          {/* 03 · ABOUT — a squarish portrait beside its opening paragraph, a
              stats row, then a closing section. The portrait used to run the
              whole height of the card, which made it a tall flat slab of one
              colour — the single biggest thing wrong with this page. */}
          <span class="pg" style="--i:2">
            <span class="pg-wire">
              <span class="pg-nav"><span class="pg-logo"></span><span class="pg-links"><span></span><span></span><span></span></span></span>
              <span class="pg-bar"></span><span class="pg-bar pg-bar-2"></span><span class="pg-line"></span>
              <span class="pg-media"></span><span class="pg-pill"></span>
            </span>
            <span class="pg-art pg-about">
              <span class="a-nav"><span class="a-logo"></span><span class="a-links"><span></span><span></span><span></span></span><span class="a-navcta"></span></span>
              <span class="a-h" style="width:58%"></span>
              <span class="a-split">
                <span class="a-img a-portrait"></span>
                <span class="a-copy">
                  <span class="a-h-sm" style="width:72%"></span>
                  {/* A paragraph, not a column of loose lines. The lines sit at
                      --a-gap-tight leading inside .a-p and the sections around
                      it separate at --a-gap; one even pitch for every line on
                      the card is what read as a barcode. */}
                  <span class="a-p">
                    <span class="a-l" style="width:98%"></span><span class="a-l" style="width:92%"></span>
                    <span class="a-l" style="width:100%"></span><span class="a-l" style="width:88%"></span>
                    <span class="a-l" style="width:96%"></span><span class="a-l" style="width:94%"></span>
                    <span class="a-l" style="width:99%"></span><span class="a-l" style="width:61%"></span>
                  </span>
                </span>
              </span>
              {/* Three numbers under a rule — the one band on this card that is
                  neither image nor prose, which is what keeps the two apart. */}
              <span class="a-stats">
                <span class="a-stat"><span class="a-h" style="width:62%"></span><span class="a-l" style="width:90%"></span></span>
                <span class="a-stat"><span class="a-h" style="width:78%"></span><span class="a-l" style="width:82%"></span></span>
                <span class="a-stat"><span class="a-h" style="width:54%"></span><span class="a-l" style="width:94%"></span></span>
              </span>
              <span class="a-close">
                <span class="a-h-sm" style="width:52%"></span>
                <span class="a-p">
                  <span class="a-l" style="width:95%"></span><span class="a-l" style="width:99%"></span>
                  <span class="a-l" style="width:90%"></span><span class="a-l" style="width:97%"></span>
                  <span class="a-l" style="width:93%"></span><span class="a-l" style="width:54%"></span>
                </span>
              </span>
              <span class="a-foot"><span class="a-foot-mark"></span><span class="a-foot-links"><span></span><span></span><span></span></span></span>
            </span>
          </span>

          {/* 04 · CONTACT — labelled fields, a message box, and a submit on a
              real actions row. The one page here whose PALETTE changed too:
              petrol and apricot out, ink and lime in. */}
          <span class="pg" style="--i:3">
            <span class="pg-wire">
              <span class="pg-nav"><span class="pg-logo"></span><span class="pg-links"><span></span><span></span><span></span></span></span>
              <span class="pg-bar"></span><span class="pg-bar pg-bar-2"></span><span class="pg-line"></span>
              <span class="pg-media"></span><span class="pg-pill"></span>
            </span>
            <span class="pg-art pg-contact">
              <span class="a-nav"><span class="a-logo"></span><span class="a-links"><span></span><span></span><span></span></span><span class="a-navcta"></span></span>
              <span class="a-h" style="width:52%"></span>
              {/* The one supporting line in the set. A contact page always has
                  a sentence telling you what to write, and without it the form
                  floats under a lone headline. */}
              <span class="a-l" style="width:72%"></span>
              <span class="a-form">
                {/* Name and email share a row — the standard two-up. Every
                    field now carries a label bar above it: without labels a
                    form is a stack of boxes, and at this size one 2px bar is
                    the entire difference. */}
                <span class="a-row">
                  <span class="a-fieldset"><span class="a-lab" style="width:52%"></span><span class="a-field"></span></span>
                  <span class="a-fieldset"><span class="a-lab" style="width:44%"></span><span class="a-field"></span></span>
                </span>
                <span class="a-fieldset"><span class="a-lab" style="width:26%"></span><span class="a-field"></span></span>
                <span class="a-fieldset a-fieldset-tall"><span class="a-lab" style="width:34%"></span><span class="a-field a-field-tall"></span></span>
                {/* Fine print left, button right — where a submit lives. It
                    used to be a 58%-wide pill hard against the left edge with
                    nothing opposite it. */}
                <span class="a-actions"><span class="a-l" style="width:38%"></span><span class="a-submit"></span></span>
              </span>
              <span class="a-foot"><span class="a-foot-mark"></span><span class="a-foot-links"><span></span><span></span><span></span></span></span>
            </span>
          </span>

          {/* 05 · GALLERY — nine landscape thumbnails on a 3-up grid. Five
              near-square tiles gave every cell a block of flat colour big
              enough to read as "image missing"; nine small ones read as a
              gallery, because the eye registers the repetition. */}
          <span class="pg" style="--i:4">
            <span class="pg-wire">
              <span class="pg-nav"><span class="pg-logo"></span><span class="pg-links"><span></span><span></span><span></span></span></span>
              <span class="pg-bar"></span><span class="pg-bar pg-bar-2"></span><span class="pg-line"></span>
              <span class="pg-media"></span><span class="pg-pill"></span>
            </span>
            <span class="pg-art pg-gallery">
              <span class="a-nav"><span class="a-logo"></span><span class="a-links"><span></span><span></span><span></span></span><span class="a-navcta"></span></span>
              <span class="a-h" style="width:38%"></span>
              <span class="a-l" style="width:64%"></span>
              <span class="a-filters"><span class="is-on"></span><span></span><span></span></span>
              <span class="a-mosaic">
                <span class="a-img"></span><span class="a-img"></span><span class="a-img"></span>
                <span class="a-img"></span><span class="a-img"></span><span class="a-img"></span>
                <span class="a-img"></span><span class="a-img"></span><span class="a-img"></span>
              </span>
              <span class="a-more"></span>
              <span class="a-foot"><span class="a-foot-mark"></span><span class="a-foot-links"><span></span><span></span><span></span></span></span>
            </span>
          </span>

          {/* 06 · PRICING — three plan columns at ~40% of the card, the middle
              one filled and standing proud, with an FAQ accordion filling the
              height the columns used to waste. */}
          <span class="pg" style="--i:5">
            <span class="pg-wire">
              <span class="pg-nav"><span class="pg-logo"></span><span class="pg-links"><span></span><span></span><span></span></span></span>
              <span class="pg-bar"></span><span class="pg-bar pg-bar-2"></span><span class="pg-line"></span>
              <span class="pg-media"></span><span class="pg-pill"></span>
            </span>
            <span class="pg-art pg-pricing">
              <span class="a-nav"><span class="a-logo"></span><span class="a-links"><span></span><span></span><span></span></span><span class="a-navcta"></span></span>
              <span class="a-h" style="width:50%"></span>
              <span class="a-l" style="width:64%"></span>
              {/* Name, price, rule, features, CTA. The rule under the price is
                  what separates the header of the column from its list; without
                  it the price is just the largest bar in one long stack. */}
              <span class="a-plans">
                <span class="a-plan">
                  <span class="a-l" style="width:52%"></span><span class="a-num"></span><span class="a-rule"></span>
                  <span class="a-feats"><span class="a-l"></span><span class="a-l"></span><span class="a-l"></span></span>
                  <span class="a-plan-cta"></span>
                </span>
                <span class="a-plan is-pick">
                  <span class="a-l" style="width:60%"></span><span class="a-num"></span><span class="a-rule"></span>
                  <span class="a-feats"><span class="a-l"></span><span class="a-l"></span><span class="a-l"></span></span>
                  <span class="a-plan-cta"></span>
                </span>
                <span class="a-plan">
                  <span class="a-l" style="width:56%"></span><span class="a-num"></span><span class="a-rule"></span>
                  <span class="a-feats"><span class="a-l"></span><span class="a-l"></span><span class="a-l"></span></span>
                  <span class="a-plan-cta"></span>
                </span>
              </span>
              <span class="a-faq">
                <span class="a-h-sm" style="width:46%"></span>
                <span class="a-qs">
                  <span class="a-q"><span class="a-l" style="width:64%"></span><span class="a-plus"></span></span>
                  <span class="a-q"><span class="a-l" style="width:52%"></span><span class="a-plus"></span></span>
                  <span class="a-q"><span class="a-l" style="width:70%"></span><span class="a-plus"></span></span>
                </span>
              </span>
              <span class="a-foot"><span class="a-foot-mark"></span><span class="a-foot-links"><span></span><span></span><span></span></span></span>
            </span>
          </span>

          {/* 07 · BLOG INDEX — three post rows: a 4:3 cover, a title that wraps,
              and a tagged date. */}
          <span class="pg" style="--i:6">
            <span class="pg-wire">
              <span class="pg-nav"><span class="pg-logo"></span><span class="pg-links"><span></span><span></span><span></span></span></span>
              <span class="pg-bar"></span><span class="pg-bar pg-bar-2"></span><span class="pg-line"></span>
              <span class="pg-media"></span><span class="pg-pill"></span>
            </span>
            <span class="pg-art pg-blog">
              <span class="a-nav"><span class="a-logo"></span><span class="a-links"><span></span><span></span><span></span></span><span class="a-navcta"></span></span>
              <span class="a-h" style="width:42%"></span>
              <span class="a-posts">
                <span class="a-post"><span class="a-img a-thumb"></span><span class="a-post-copy"><span class="a-h-sm" style="width:94%"></span><span class="a-h-sm" style="width:56%"></span><span class="a-post-meta"><span class="a-tag"></span><span class="a-l" style="width:44%"></span></span></span></span>
                <span class="a-post"><span class="a-img a-thumb"></span><span class="a-post-copy"><span class="a-h-sm" style="width:88%"></span><span class="a-h-sm" style="width:44%"></span><span class="a-post-meta"><span class="a-tag"></span><span class="a-l" style="width:44%"></span></span></span></span>
                <span class="a-post"><span class="a-img a-thumb"></span><span class="a-post-copy"><span class="a-h-sm" style="width:92%"></span><span class="a-h-sm" style="width:62%"></span><span class="a-post-meta"><span class="a-tag"></span><span class="a-l" style="width:44%"></span></span></span></span>
              </span>
              <span class="a-foot"><span class="a-foot-mark"></span><span class="a-foot-links"><span></span><span></span><span></span></span></span>
            </span>
          </span>

          {/* 08 · DETAIL — a project or article page: cover, title, tagged byline, body. */}
          <span class="pg" style="--i:7">
            <span class="pg-wire">
              <span class="pg-nav"><span class="pg-logo"></span><span class="pg-links"><span></span><span></span><span></span></span></span>
              <span class="pg-bar"></span><span class="pg-bar pg-bar-2"></span><span class="pg-line"></span>
              <span class="pg-media"></span><span class="pg-pill"></span>
            </span>
            <span class="pg-art pg-detail">
              <span class="a-nav"><span class="a-logo"></span><span class="a-links"><span></span><span></span><span></span></span><span class="a-navcta"></span></span>
              <span class="a-img a-cover"></span>
              {/* Headline, second line and byline are ONE masthead unit at
                  tight leading. As five equal siblings at 5px they read as
                  five unrelated bars. An article headline wraps; two bars, the
                  second short, is the difference between a title and a label. */}
              <span class="a-head">
                <span class="a-h" style="width:82%"></span>
                <span class="a-h" style="width:47%"></span>
                <span class="a-meta"><span class="a-tag"></span><span class="a-l" style="width:32%"></span></span>
              </span>
              <span class="a-body">
                <span class="a-p">
                  <span class="a-l" style="width:98%"></span><span class="a-l" style="width:91%"></span>
                  <span class="a-l" style="width:66%"></span>
                </span>
                {/* The pull quote. Heavier than body, hung off an accent rule —
                    the only place in the set a rule is set in the accent, which
                    is exactly what a magazine spends one on, and what breaks
                    the lower half of this card out of one flat run of texture. */}
                <span class="a-pull"><span class="a-h-sm" style="width:88%"></span><span class="a-h-sm" style="width:54%"></span></span>
                <span class="a-p">
                  <span class="a-l" style="width:94%"></span><span class="a-l" style="width:99%"></span>
                  <span class="a-l" style="width:58%"></span>
                </span>
              </span>
              <span class="a-foot"><span class="a-foot-mark"></span><span class="a-foot-links"><span></span><span></span><span></span></span></span>
            </span>
          </span>
        </div>
        <figcaption class="svc-pages-cap">Up to eight pages, designed as one system</figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ THE OFFER — bento spec sheet (mirrors homepage) ============ -->
  <section id="offer" class="section section-offer">
    <div class="full">
      <div class="section-head mv-rise" data-mv-watch>
        <h2 class="display section-title">A whole website, <em>one number</em>.</h2>
        <p class="section-sub">Same foundation, every time. The scope is fixed and the price is fixed, so the only thing left to decide is what your site needs to say.</p>
      </div>

      <div class="offer-bento mv-stagger" data-mv-watch>
        <!-- Centerpiece: the offer + price + CTA -->
        <article class="bento-card bento-headline" data-tilt>
          <span class="tier-sheen" aria-hidden="true"></span>
          <div class="bh-top">
            <span class="bh-eyebrow"><span class="live-dot" aria-hidden="true"></span>The offer</span>
            <span class="bh-meta">20 business days · up to 8 pages</span>
          </div>
          <div class="bh-body">
            <h3 class="bh-title">Full <em>Site</em></h3>
            <div class="bh-price">
              <span class="bh-dollar">$</span><span class="bh-amount" id="svcAmount" data-target="6000">6,000</span>
            </div>
            <p class="bh-note">Flat fee. Three rounds of revisions. You own everything when we're done.</p>
          </div>
          <div class="bh-foot">
            <a href="/contact" class="bh-cta">
              <span>Start a project</span>
