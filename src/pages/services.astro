---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandMark from "../components/BrandMark.astro";
---

<BaseLayout title="Services & pricing — fwd.">
  <!-- ============ HERO — editorial split with a spec index card ============ -->
  <section class="svc-hero">
    <div class="full svc-hero-grid">
      <div class="svc-hero-copy mv-rise" data-mv-watch>
        <p class="eyebrow"><span>Pricing, in plain sight</span></p>
        <h1 class="display svc-hero-title">No tiers. No asterisks. <em>One price</em>.</h1>
        <p class="lede svc-hero-lede">Most studios make you email for a quote, then bill by the hour and hope you stop counting. We put the number on the page. One fixed price for a full website — designed around your brand, built, and live in about four weeks. Every line of it is yours to keep.</p>
        <div class="svc-hero-actions">
          <a href="/contact" class="btn btn-primary">Start a project <span class="arrow" aria-hidden="true">→</span></a>
          <a href="#offer" class="btn btn-ghost">See what's included</a>
        </div>
      </div>

      <aside class="svc-hero-card mv-soften" data-mv-watch aria-label="The essentials">
        <div class="shc-top">
          <span class="shc-eyebrow"><span class="shc-dot" aria-hidden="true"></span>Full Site</span>
          <span class="shc-flag">Flat fee</span>
        </div>
        <dl class="shc-specs">
          <div class="shc-row"><dt>Turnaround</dt><dd>20 business days</dd></div>
          <div class="shc-row"><dt>Pages</dt><dd>Up to 8</dd></div>
          <div class="shc-row"><dt>Revisions</dt><dd>3 rounds, async</dd></div>
          <div class="shc-row"><dt>Hosting &amp; domain</dt><dd>Set up &amp; included</dd></div>
          <div class="shc-row"><dt>Ownership</dt><dd>Everything's yours</dd></div>
        </dl>
        <a href="#offer" class="shc-foot">
          <span class="shc-foot-label">Total, all in</span>
          <span class="shc-foot-link">See the number <span class="arrow" aria-hidden="true">↓</span></span>
        </a>
      </aside>
    </div>
  </section>

  <!-- ============ THE OFFER — bento spec sheet (mirrors homepage) ============ -->
  <section id="offer" class="section section-offer">
    <div class="full">
      <div class="section-head mv-rise" data-mv-watch>
        <h2 class="display section-title">A whole website, <em>one number</em>.</h2>
        <p class="section-sub">Everything below is in the box — same scope, same price, every project. The only thing that changes from one site to the next is what yours needs to say.</p>
      </div>

      <div class="offer-bento mv-stagger" data-mv-watch>
        <!-- Centerpiece: the offer + price + CTA -->
        <article class="bento-card bento-headline" data-tilt>
          <span class="tier-sheen" aria-hidden="true"></span>
          <div class="bh-top">
            <span class="bh-eyebrow"><span class="live-dot" aria-hidden="true"></span>The offer</span>
            <span class="bh-meta">20 business days · up to 8 pages</span>
          </div>
          <div class="bh-body">
            <h3 class="bh-title">Full <em>Site</em></h3>
            <div class="bh-price">
              <span class="bh-dollar">$</span><span class="bh-amount" id="svcAmount" data-target="4000">4,000</span>
            </div>
            <p class="bh-note">One flat fee, split 50/50. Three rounds of revisions. You walk away with all of it — code, domain, and keys.</p>
          </div>
          <div class="bh-foot">
            <a href="/contact" class="bh-cta">
              <span>Start a project</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
            <div class="bh-ticker" aria-hidden="true">
              <div class="bh-ticker-track">
                <span>Flat fee</span><span class="dot">●</span>
                <span>No retainers</span><span class="dot">●</span>
                <span>3 revision rounds</span><span class="dot">●</span>
                <span>You own it all</span><span class="dot">●</span>
                <span>Flat fee</span><span class="dot">●</span>
                <span>No retainers</span><span class="dot">●</span>
                <span>3 revision rounds</span><span class="dot">●</span>
                <span>You own it all</span><span class="dot">●</span>
              </div>
            </div>
          </div>
        </article>

        <!-- Feature tiles — each its own spotlight -->
        <article class="bento-card bento-feature" data-tilt>
          <span class="tier-sheen" aria-hidden="true"></span>
          <span class="bf-num">i.</span>
          <h4 class="bf-title">Up to <em>8 pages</em></h4>
          <p class="bf-body">Home, about, services, contact — built around your brand, not a template.</p>
        </article>

        <article class="bento-card bento-feature" data-tilt>
          <span class="tier-sheen" aria-hidden="true"></span>
          <span class="bf-num">ii.</span>
          <h4 class="bf-title">Design <em>system</em></h4>
          <p class="bf-body">Type, color, and components that still make sense a year from now.</p>
        </article>

        <article class="bento-card bento-feature" data-tilt>
          <span class="tier-sheen" aria-hidden="true"></span>
          <span class="bf-num">iii.</span>
          <h4 class="bf-title">Lead <em>capture</em></h4>
          <p class="bf-body">A contact form wired straight to your inbox from day one.</p>
        </article>

        <article class="bento-card bento-feature" data-tilt>
          <span class="tier-sheen" aria-hidden="true"></span>
          <span class="bf-num">iv.</span>
          <h4 class="bf-title">Mobile + <em>SEO</em></h4>
          <p class="bf-body">Sharp on every screen size, with on-page SEO sorted before launch.</p>
        </article>

        <article class="bento-card bento-feature" data-tilt>
          <span class="tier-sheen" aria-hidden="true"></span>
          <span class="bf-num">v.</span>
          <h4 class="bf-title">Hosting + <em>domain</em></h4>
          <p class="bf-body">We set it up, point your domain, and hand you the keys.</p>
        </article>

        <article class="bento-card bento-feature" data-tilt>
          <span class="tier-sheen" aria-hidden="true"></span>
          <span class="bf-num">vi.</span>
          <h4 class="bf-title">Handoff <em>doc</em></h4>
          <p class="bf-body">Plain-English notes so you can edit copy without calling us.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ WALKTHROUGH — animated day-by-day (kept) ============ -->
  <section class="walkthrough">
    <div class="walkthrough-inner">
      <div class="walkthrough-head mv-rise" data-mv-watch>
        <div class="walkthrough-head-copy">
          <span class="walkthrough-eyebrow"><span class="walkthrough-eyebrow-bar"></span>The timeline</span>
          <h2 class="walkthrough-h">What happens, <em>day by day</em>.</h2>
        </div>
        <div class="walkthrough-controls">
          <button id="wtPrev" type="button" aria-label="Previous step">‹ Prev</button>
          <button id="wtAuto" type="button" aria-pressed="true">Auto</button>
          <button id="wtNext" type="button" aria-label="Next step">Next ›</button>
        </div>
      </div>

      <div class="walkthrough-track" data-step="0" id="wtTrack" role="tablist" aria-label="Project timeline">
        <button class="walkthrough-marker" data-step="0" aria-pressed="true" role="tab" aria-controls="wt-panel-0"><span class="day">Day 0</span><span class="lbl">Inquiry</span></button>
        <button class="walkthrough-marker" data-step="1" aria-pressed="false" role="tab" aria-controls="wt-panel-1"><span class="day">Day 1–2</span><span class="lbl">Intro call</span></button>
        <button class="walkthrough-marker" data-step="2" aria-pressed="false" role="tab" aria-controls="wt-panel-2"><span class="day">Day 3</span><span class="lbl">Proposal</span></button>
        <button class="walkthrough-marker" data-step="3" aria-pressed="false" role="tab" aria-controls="wt-panel-3"><span class="day">Week 1–3</span><span class="lbl">Draft &amp; revise</span></button>
        <button class="walkthrough-marker" data-step="4" aria-pressed="false" role="tab" aria-controls="wt-panel-4"><span class="day">Day 20</span><span class="lbl">Launch</span></button>
      </div>

      <div class="walkthrough-panel" id="wtPanel" aria-live="polite">
        <div class="walkthrough-step is-active" data-step="0" id="wt-panel-0" role="tabpanel">
          <span class="when">Day 0 · You send the contact form</span>
          <h4>An inquiry comes in. <em>Jaiden replies</em>.</h4>
          <p>One of us reads every inquiry the day it arrives. Jaiden writes back within a day with a couple of clarifying questions and a proposed time for a short call.</p>
          <span class="deliv">— Reply within 24 hours, every day</span>
        </div>
        <div class="walkthrough-step" data-step="1" id="wt-panel-1" role="tabpanel">
          <span class="when">Day 1–2 · The intro call</span>
          <h4>15 minutes, <em>all three of us</em>, no slide deck.</h4>
          <p>You meet the whole studio at once. We ask what you do, who you serve, and what the site needs to do for you. You ask whatever you need to. No follow-up sequences.</p>
          <span class="deliv">— No prep required from you</span>
        </div>
        <div class="walkthrough-step" data-step="2" id="wt-panel-2" role="tabpanel">
          <span class="when">Day 3 · Proposal &amp; deposit</span>
          <h4>One-page proposal. Plain language. <em>50% deposit</em>.</h4>
          <p>Alex sends a flat-fee proposal and the deposit invoice. There is no long contract — one page, one number, one timeline. Once the deposit lands, the clock starts.</p>
          <span class="deliv">— Pay by card, bank transfer, or wire</span>
        </div>
        <div class="walkthrough-step" data-step="3" id="wt-panel-3" role="tabpanel">
          <span class="when">Week 1 → Week 3 · Design, draft, revise</span>
          <h4>First draft live in your browser by <em>end of week one</em>.</h4>
          <p>Riz builds the first version and shares a real URL on your phone, not a Figma file. You mark up the changes you want. We revise. Three rounds are included, and everything stays async until you want a call.</p>
          <span class="deliv">— Average response on revisions: 1 business day</span>
        </div>
        <div class="walkthrough-step" data-step="4" id="wt-panel-4" role="tabpanel">
          <span class="when">Launch day · Live</span>
          <h4>Your domain points to the new site.<em> Final invoice sent</em>.</h4>
          <p>We connect DNS, install the SSL cert, run a final QA pass, and hand over a written doc so you can update content yourself. The remaining balance invoice lands the same day. You own everything — the domain, the hosting account, the code.</p>
          <span class="deliv">— Live in 20 business days</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ NOT INCLUDED ============ -->
  <section class="not-included mv-rise" data-mv-watch>
    <div class="full">
      <div class="section-head">
        <h2 class="display section-title">Not included. <em>Honest about it</em>.</h2>
        <p class="section-sub">Three things we keep out of the flat fee on purpose. Two of them can be added if you need them, billed separately so you can see exactly what they cost.</p>
      </div>

      <div class="ni-grid">
        <article class="ni-card">
          <span class="tag">Out of scope</span>
          <h3>Ongoing maintenance</h3>
          <p>Small content changes after launch are on us. Larger maintenance work — feature additions, redesigns, monthly updates — is a separate engagement.</p>
        </article>

        <article class="ni-card">
          <span class="tag">Add-on available</span>
          <h3>Copywriting</h3>
          <p>By default you write the copy and we polish it. If you need us to draft from scratch — service descriptions, about page, tone — we can roll it in.</p>
          <span class="addon">Quoted per project</span>
        </article>

        <article class="ni-card">
          <span class="tag">Add-on available</span>
          <h3>Photography</h3>
          <p>If you have your own photos, we will design around them. If you do not, we coordinate a shoot with a photographer we trust, or design with carefully-sourced stock.</p>
          <span class="addon">Quoted per project</span>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="section section-faq">
    <div class="full">
      <div class="section-head mv-rise" data-mv-watch>
        <h2 class="display section-title">Questions we get a <em>lot</em>.</h2>
        <p class="section-sub">If yours is not here, <a class="link-arrow" href="/contact">ask us<span class="arrow">→</span></a> — we add to this list as new ones come up.</p>
      </div>

      <div class="faq-list mv-stagger" data-mv-watch>
        <details class="faq-item" open>
          <summary><span class="faq-q">What if I only need a single landing page?</span><span class="faq-icon" aria-hidden="true"></span></summary>
          <div class="faq-a"><p>Email us. Smaller projects come up regularly and we quote them at a reduced flat fee within a day, sized to the scope. The $4,000 number is for a full site of up to eight pages.</p></div>
        </details>
        <details class="faq-item">
          <summary><span class="faq-q">What counts as a "small change" after launch?</span><span class="faq-icon" aria-hidden="true"></span></summary>
          <div class="faq-a"><p>Text fixes, photo swaps, link updates, hours changes — anything you could send us in a single email and we could ship in an afternoon. Larger changes (new sections, new pages, new features) become a new engagement at a flat fee.</p></div>
        </details>
        <details class="faq-item">
          <summary><span class="faq-q">Who hosts the site after launch?</span><span class="faq-icon" aria-hidden="true"></span></summary>
          <div class="faq-a"><p>You do. We set up hosting on a platform you own — usually Cloudflare Pages or Netlify, both free at our scale. We connect your domain, set up DNS, and walk you through how to make a content change. There is no ongoing fee to us.</p></div>
        </details>
        <details class="faq-item">
          <summary><span class="faq-q">Can you redesign an existing site?</span><span class="faq-icon" aria-hidden="true"></span></summary>
          <div class="faq-a"><p>Yes — most of our work is redesigns. The flat-fee structure stays the same. We preserve any SEO that is working, port your existing content, and keep your domain authority intact.</p></div>
        </details>
        <details class="faq-item">
          <summary><span class="faq-q">How do payments work?</span><span class="faq-icon" aria-hidden="true"></span></summary>
          <div class="faq-a"><p>50% on signed proposal, 50% on launch. Card, bank transfer, or wire — whatever is easiest. Alex sends every invoice and handles every receipt. There are no recurring charges.</p></div>
        </details>
        <details class="faq-item">
          <summary><span class="faq-q">What if I want to keep updating the site myself?</span><span class="faq-icon" aria-hidden="true"></span></summary>
          <div class="faq-a"><p>Every project ships with a handoff doc — screenshots and exact file paths, written so non-developers can change text, swap photos, and add new pages without touching code we wrote.</p></div>
        </details>
      </div>
    </div>
  </section>

  <section class="cta-band cta-band-marks mv-soften" data-mv-watch>
    <div class="cta-band-bg" aria-hidden="true">
      <div class="cta-band-bg-marks">
        <BrandMark class="cb-mark" decorative={true} />
        <BrandMark class="cb-mark" decorative={true} />
        <BrandMark class="cb-mark" decorative={true} />
        <BrandMark class="cb-mark" decorative={true} />
        <BrandMark class="cb-mark" decorative={true} />
        <BrandMark class="cb-mark" decorative={true} />
        <BrandMark class="cb-mark" decorative={true} />
        <BrandMark class="cb-mark" decorative={true} />
      </div>
    </div>
    <div class="cta-band-inner">
      <h2 class="display">Enough reading. <em>Let's build it</em>.</h2>
      <div>
        <p>Tell us what you're working on. You'll hear back within a day — one page, one number, no sales call.</p>
        <a href="/contact" class="btn btn-primary">Start a project <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ============================================================
     HERO — editorial split. Copy on the left, a light "spec
     index card" on the right that teases the essentials and
     drops the eye down into the offer.
     ============================================================ */
  .svc-hero {
    position: relative;
    padding-block: clamp(3.5rem, 9vh, 7rem) clamp(3rem, 7vh, 5.5rem);
    border-bottom: 1px solid var(--color-hairline);
    overflow: hidden;
  }
  .svc-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }
  @media (min-width: 940px) {
    .svc-hero-grid { grid-template-columns: 1.25fr 0.9fr; }
  }
  .svc-hero-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 1.5rem; }
  .svc-hero-copy .eyebrow { margin-bottom: 0.25rem; }
  .svc-hero-title { font-size: var(--text-step-6); margin: 0; max-width: 15ch; }
  .svc-hero-lede { max-width: 46ch; margin: 0; }
  .svc-hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 0.5rem; }

  /* Spec index card — light, hairlined, editorial */
  .svc-hero-card {
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: 16px;
    padding: clamp(1.5rem, 2.4vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    box-shadow:
      0 40px 90px -50px rgb(7 23 34 / 0.35),
      0 12px 30px -18px rgb(7 23 34 / 0.14);
    position: relative;
    isolation: isolate;
  }
  .shc-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .shc-eyebrow {
    display: inline-flex; align-items: center; gap: 0.55rem;
    font-family: var(--font-display); font-weight: 400;
    font-size: var(--text-step-1); letter-spacing: -0.01em;
    color: var(--color-navy); font-variation-settings: "opsz" 72;
  }
  .shc-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--color-periwinkle);
    box-shadow: 0 0 0 0 rgba(142,148,184,0.55);
    animation: mvPulseRing 2.4s var(--ease-soft) infinite;
  }
  .shc-flag {
    font-family: var(--font-mono); font-size: var(--text-step--2);
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--color-blue);
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-bg-soft);
  }
  .shc-specs { margin: 0; display: flex; flex-direction: column; }
  .shc-row {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 1rem;
    padding-block: 0.8rem;
    border-top: 1px solid var(--color-line);
  }
  .shc-row:first-child { border-top: 0; }
  .shc-row dt {
    font-family: var(--font-mono); font-size: var(--text-step--2);
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--color-fg-muted);
  }
  .shc-row dd {
    margin: 0; text-align: right;
    font-family: var(--font-display); font-weight: 400;
    font-size: var(--text-step-0);
    color: var(--color-fg); letter-spacing: -0.01em;
    font-variation-settings: "opsz" 40;
  }
  .shc-foot {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1rem;
    margin-top: 0.25rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--color-line-strong);
  }
  .shc-foot-label {
    font-family: var(--font-mono); font-size: var(--text-step--2);
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--color-fg-muted);
  }
  .shc-foot-link {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-family: var(--font-sans); font-weight: 500;
    font-size: var(--text-step--1); color: var(--color-blue);
  }
  .shc-foot .arrow { transition: transform 320ms var(--ease-soft); }
  .svc-hero-card:hover .shc-foot .arrow { transform: translateY(3px); }

  /* ============================================================
     THE OFFER — bento spec sheet. Mirrors the homepage services
     section: a dark centerpiece (price + CTA) and six annotation
     tiles, each with its own mouse-spotlight sheen.
     ============================================================ */
  .section-offer { padding-block: clamp(4rem, 9vh, 7rem); }
  .section-offer .section-head { margin-bottom: clamp(2.5rem, 5vh, 4rem); }

  .offer-bento {
    display: grid;
    grid-template-columns: 1fr;
    grid-auto-rows: minmax(0, auto);
    gap: 1rem;
  }
  @media (min-width: 760px) {
    .offer-bento { grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  }
  @media (min-width: 1000px) {
    .offer-bento {
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: repeat(3, minmax(180px, 1fr));
      gap: 1.5rem;
    }
  }

  .bento-card {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    --bg: #fff;
    --fg: var(--color-navy);
    --fg-soft: var(--color-fg-soft);
    --fg-muted: var(--color-fg-muted);
    --line: var(--color-line);
    --accent: var(--color-blue);
    --sheen: rgb(13 47 69 / 0.10);
    background: var(--bg);
    color: var(--fg);
    border: 1px solid var(--line);
    border-radius: 14px;
    transition: transform 360ms var(--ease-soft), box-shadow 360ms var(--ease-soft), border-color 360ms var(--ease-soft);
  }
  .bento-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 30px 60px -28px rgb(7 23 34 / 0.28);
  }
  .bento-card .tier-sheen {
    position: absolute; inset: 0;
    pointer-events: none; z-index: 0;
    border-radius: inherit;
    opacity: 0;
    transition: opacity 360ms var(--ease-soft);
    background: radial-gradient(260px circle at var(--mx, 50%) var(--my, 50%), var(--sheen), transparent 60%);
  }
  .bento-card:hover .tier-sheen { opacity: 1; }
  .bento-card > :not(.tier-sheen) { position: relative; z-index: 1; }

  /* Centerpiece — dark "spec card" with price + CTA + ticker */
  .bento-headline {
    --bg: var(--color-navy);
    --fg: #fff;
    --fg-soft: rgba(255,255,255,0.82);
    --fg-muted: rgba(255,255,255,0.55);
    --line: rgba(255,255,255,0.14);
    --accent: var(--color-periwinkle);
    --sheen: rgb(255 255 255 / 0.14);
    display: flex;
    flex-direction: column;
    padding: clamp(2rem, 3.2vw, 2.75rem);
    min-height: 480px;
  }
  @media (min-width: 1000px) {
    .bento-headline { grid-column: 1 / span 2; grid-row: 1 / span 3; min-height: 0; }
  }
  .bh-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .bh-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--font-mono); font-size: var(--text-step--2);
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--fg-muted);
  }
  .bh-eyebrow .live-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--color-periwinkle);
    box-shadow: 0 0 0 0 rgba(142, 148, 184, 0.6);
    animation: bhPulse 2.4s var(--ease-soft) infinite;
  }
  @keyframes bhPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(142, 148, 184, 0.55); }
    50% { box-shadow: 0 0 0 7px rgba(142, 148, 184, 0); }
  }
  .bh-meta {
