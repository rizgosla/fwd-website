<script is:inline>
  // Offer bento — count up the headline price when it enters the viewport.
  (() => {
    const el = document.getElementById('svcAmount');
    if (!el) return;
    const target = parseInt(el.dataset.target, 10) || 4000;
    const fmt = (n) => n.toLocaleString('en-US');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) { el.textContent = fmt(target); return; }
    const run = () => {
      const dur = 1400;
      const start = performance.now();
      el.textContent = '0';
      const step = (ts) => {
        const t = Math.min((ts - start) / dur, 1);
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = fmt(Math.round(eased * target));
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { io.disconnect(); run(); } });
      }, { threshold: 0.4 });
      io.observe(el);
    } else { run(); }
  })();

  // Walkthrough — auto-advance + manual nav
  (() => {
    const track = document.getElementById('wtTrack');
    const panel = document.getElementById('wtPanel');
    if (!track || !panel) return;
    const markers = track.querySelectorAll('.walkthrough-marker');
    const steps = panel.querySelectorAll('.walkthrough-step');
    const prevBtn = document.getElementById('wtPrev');
    const nextBtn = document.getElementById('wtNext');
    const autoBtn = document.getElementById('wtAuto');
    const total = markers.length;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0;
    let auto = !reduce;
    let timer = null;
    let started = false;

    const setStep = (n) => {
      i = ((n % total) + total) % total;
      track.dataset.step = i;
      markers.forEach((m, idx) => m.setAttribute('aria-pressed', idx === i ? 'true' : 'false'));
      steps.forEach((s, idx) => s.classList.toggle('is-active', idx === i));
    };
    const scheduleNext = () => {
      clearTimeout(timer);
      if (!auto) return;
      timer = setTimeout(() => { setStep(i + 1); scheduleNext(); }, 4200);
    };
    const stopAuto = () => { auto = false; autoBtn.setAttribute('aria-pressed', 'false'); clearTimeout(timer); };
    const startAuto = () => { auto = true; autoBtn.setAttribute('aria-pressed', 'true'); scheduleNext(); };

    markers.forEach((m) => m.addEventListener('click', () => { stopAuto(); setStep(parseInt(m.dataset.step, 10)); }));
    prevBtn.addEventListener('click', () => { stopAuto(); setStep(i - 1); });
    nextBtn.addEventListener('click', () => { stopAuto(); setStep(i + 1); });
    autoBtn.addEventListener('click', () => { auto ? stopAuto() : startAuto(); });

    const pauseOnInteraction = () => { if (auto) { clearTimeout(timer); } };
    const resumeOnInteractionEnd = () => { if (auto) scheduleNext(); };
    [track, panel].forEach((el) => {
      el.addEventListener('mouseenter', pauseOnInteraction);
      el.addEventListener('mouseleave', resumeOnInteractionEnd);
      el.addEventListener('focusin', pauseOnInteraction);
      el.addEventListener('focusout', resumeOnInteractionEnd);
    });

    if (reduce) {
      autoBtn.setAttribute('aria-pressed', 'false');
      return;
    }

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting && !started) { started = true; scheduleNext(); }
        });
      }, { threshold: 0.3 });
      io.observe(track);
    } else { scheduleNext(); }
  })();
</script>
