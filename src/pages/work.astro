---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/work/ProjectCard.astro";
import CtaClose from "../components/CtaClose.astro";

const projects = (await getCollection("work")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title="Selected work - Forward Design Consulting">
  <section class="work-hero">
    <div class="full work-hero-grid">
      {/* No eyebrow: the h1 already names the section, and the page's one
          eyebrow allowance is spent on the closing CTA. */}
      <div class="work-hero-text mv-rise" data-mv-watch>
        <h1 class="display work-hero-title">A small studio. <em>Real projects</em>.</h1>
        <p class="lede work-hero-lede">
          Every card here links straight through to the live site, so you can judge the
          work the way a visitor would rather than the way a case study would like you to.
        </p>
      </div>

      {/* Three browser frames that start stacked and settle into a fan.
          Chrome vocabulary is the hero showcase's; the spread-by-index
          geometry is the studio fold's. Neither one's motion is reused: this
          plays once on entry and stops. */}
      <div class="wh-fan" data-mv-watch aria-hidden="true">
        {[0, 1, 2].map((i) => (
          <span class="wh-pane" style={`--i:${i}`}>
            <span class="wh-chrome">
              <span class="wh-dots"><span></span><span></span><span></span></span>
              <span class="wh-url"></span>
            </span>
            <span class="wh-body">
              <span class="wh-nav">
                <span class="wh-logo"></span>
                <span class="wh-links"><span></span><span></span><span></span></span>
              </span>
              <span class="wh-bar"></span>
              <span class="wh-bar wh-bar-2"></span>
              <span class="wh-line"></span>
              <span class="wh-pill"></span>
            </span>
          </span>
        ))}
      </div>
    </div>
  </section>

  {/* Stats live here rather than in the hero: a trust strip inside the hero
      pushes the stack past four elements and floats the CTA down the page.
      Mirrors the homepage meta-strip. */}
  <section class="work-meta">
    <div class="full">
      <div class="work-meta-grid mv-stagger" data-mv-watch>
        <div class="work-meta-cell">
          <span class="work-meta-key">Shipped</span>
          <strong class="work-meta-val">{projects.length.toString().padStart(2, "0")} projects</strong>
        </div>
        <div class="work-meta-cell">
          <span class="work-meta-key">Pricing model</span>
          <strong class="work-meta-val">Flat fee, no retainers</strong>
        </div>
        <div class="work-meta-cell">
          <span class="work-meta-key">Studio year</span>
          <strong class="work-meta-val">Since 2026</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-projects">
    <div class="full">
      <div class="section-head mv-rise" data-mv-watch>
        <h2 class="display section-title">What we've <em>built</em>.</h2>
        <p class="section-sub">
          We keep the studio small on purpose, so this page fills up slowly. One careful
          project at a time, written up in a paragraph rather than a brochure.
        </p>
      </div>

      <ul class="project-grid mv-stagger" data-mv-watch>
        {projects.map((entry) => (
          <ProjectCard
            title={entry.data.title}
            url={entry.data.url}
            blurb={entry.data.summary}
            image={entry.data.image}
          />
        ))}
      </ul>
    </div>
  </section>

  <CtaClose
    tone="light"
    eyebrow="The next slot is open"
    lead="Want your site to be the"
    swap={["next one here?", "one we ship next?", "next launch?", "one people bookmark?"]}
    lede="Tell us what you are working on. We reply to every inquiry, usually within a day."
    note="Flat-fee proposal within a day"
    ticker={["Flat fee", "No retainers", "About 4 weeks", "You own it all"]}
  />
</BaseLayout>

<style>
  .work-hero {
    position: relative;
    background: var(--color-paper);
    padding-block: clamp(3.5rem, 8vh, 6rem) clamp(3rem, 8vh, 5.5rem);
    border-bottom: 1px solid var(--color-line);
    overflow: hidden;
  }
  .work-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(3rem, 6vw, 5rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .work-hero-grid { grid-template-columns: 1fr 1fr; }
  }

  .work-hero-text { display: flex; flex-direction: column; align-items: flex-start; }
  /* "projects" is italic and carries both a p and a j. At line-height 1 the
     descenders clip against the lede below, so this runs 1.1 with a reserve
     rather than inheriting .display's 0.98. */
  .work-hero-title {
    font-size: var(--text-step-5); margin: 0;
    line-height: 1.1; padding-bottom: 0.08em;
    letter-spacing: -0.03em; color: var(--color-navy); max-width: 14ch;
  }
  .work-hero-title em { font-style: italic; color: var(--color-blue); }
  .work-hero-lede { margin: 1.5rem 0 0; color: var(--color-fg-soft); max-width: 46ch; font-size: var(--text-step-1); }

  /* ============================================================
     META STRIP — same pattern as the homepage's, one row down.
     ============================================================ */
  .work-meta {
    background: var(--color-bg-soft);
    border-bottom: 1px solid var(--color-line);
    padding-block: clamp(2rem, 4vh, 3.5rem);
  }
  .work-meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem 2.5rem;
  }
  .work-meta-cell { display: flex; flex-direction: column; gap: 0.35rem; }
  .work-meta-key {
    font-family: var(--font-mono); font-size: var(--text-step--2);
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--color-fg-muted);
  }
  .work-meta-val {
    font-family: var(--font-display); font-weight: 400;
    font-size: var(--text-step-1); font-variation-settings: "opsz" 60;
    color: var(--color-fg); letter-spacing: -0.01em;
  }

  /* ============================================================
     HERO VISUAL — three browser frames fanning out on entry.
     ============================================================ */
  .wh-fan {
    position: relative;
    height: clamp(260px, 34vw, 400px);
    display: flex; align-items: center; justify-content: center;
  }
  /* The container animates its children rather than itself, so it has to
     opt out of the [data-mv-watch] opacity hold. */
  .wh-fan[data-mv-watch] { opacity: 1; }

  .wh-pane {
    position: absolute;
    top: 50%; left: 50%;
    width: clamp(210px, 27vw, 320px);
    margin: calc(clamp(150px, 19vw, 224px) / -2) 0 0 calc(clamp(210px, 27vw, 320px) / -2);
    height: clamp(150px, 19vw, 224px);
    display: flex; flex-direction: column;
    border-radius: 14px;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    overflow: hidden;
    box-shadow:
      0 40px 90px -40px rgb(7 23 34 / 0.32),
      0 14px 30px -14px rgb(7 23 34 / 0.18);
    --spread: calc((var(--i) - 1) * clamp(30px, 4.5vw, 62px));
    --rot: calc((var(--i) - 1) * 3.2deg);
    /* Start stacked square-on, settle out into the fan. */
    transform: translate(0, 16px) rotate(0deg);
    opacity: 0;
    transition:
      transform 1100ms var(--ease-out-expo),
      opacity 700ms var(--ease-soft);
    transition-delay: calc(var(--i) * 150ms);
    z-index: calc(var(--i) + 1);
  }
  .wh-fan.is-inview .wh-pane {
    transform: translate(var(--spread), 0) rotate(var(--rot));
    opacity: 1;
  }

  .wh-chrome {
    display: flex; align-items: center; gap: 10px;
    padding: 8px 11px;
    background: #f5f6f8;
    border-bottom: 1px solid var(--color-line);
  }
  .wh-dots { display: flex; gap: 4px; }
  .wh-dots span { width: 7px; height: 7px; border-radius: 50%; background: rgba(13, 47, 69, 0.18); }
  .wh-url { flex: 1; height: 16px; border-radius: 5px; background: #fff; border: 1px solid var(--color-line); }

  .wh-body { flex: 1; display: flex; flex-direction: column; gap: 9px; padding: 14px 16px; }
  .wh-nav { display: flex; align-items: center; gap: 12px; margin-bottom: 4px; }
  .wh-logo { width: 34px; height: 9px; border-radius: 3px; background: rgba(13, 47, 69, 0.16); }
  .wh-links { display: flex; gap: 7px; margin-left: auto; }
  .wh-links span { width: 18px; height: 5px; border-radius: 2px; background: rgba(13, 47, 69, 0.12); }
  .wh-bar { width: 84%; height: 15px; border-radius: 4px; background: rgba(13, 47, 69, 0.18); }
  .wh-bar-2 { width: 56%; }
  .wh-line { width: 70%; height: 6px; border-radius: 2px; background: rgba(13, 47, 69, 0.12); }
  .wh-pill { width: 62px; height: 18px; border-radius: 999px; background: var(--color-periwinkle); opacity: 0.55; margin-top: auto; }

  @media (prefers-reduced-motion: reduce) {
    .wh-pane {
      transform: translate(var(--spread), 0) rotate(var(--rot));
      opacity: 1;
    }
  }

  /* ============================================================
     PROJECT GRID
     ============================================================ */
  .section-projects { padding-block: clamp(4rem, 9vh, 7rem); }
  .section-head { display: grid; gap: 1rem; grid-template-columns: 1fr; align-items: end; margin-bottom: clamp(2.5rem, 5vh, 3.5rem); }
  @media (min-width: 760px) { .section-head { grid-template-columns: 1fr 1.1fr; gap: 3rem; } }
  .section-title { font-size: var(--text-step-4); max-width: 18ch; margin: 0; }
  .section-sub { color: var(--color-fg-soft); max-width: 50ch; font-size: var(--text-step-1); margin: 0; text-wrap: pretty; }

  .project-grid {
    list-style: none; padding: 0; margin: 0;
    display: grid; gap: clamp(2.5rem, 5vw, 4rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
  }

  @media (max-width: 899px) {
    .work-hero-title { font-size: clamp(2.6rem, 10vw, 4.2rem); }
  }
</style>
