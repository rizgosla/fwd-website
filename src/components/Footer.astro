---
import BrandWall from "./BrandWall.astro";

// Studio links land on real /studio sections. `/studio#people` was removed —
// the team section it pointed at is being cut, so this goes to the page itself.
const studioLinks = [
  { href: "/studio", label: "The studio" },
  { href: "/studio#values", label: "What we believe" },
  { href: "/work", label: "Selected work" },
];
const serviceLinks = [
  { href: "/services", label: "Full Site, $4,000" },
  { href: "/services#offer", label: "What's included" },
  { href: "/contact", label: "Custom inquiry" },
];
---

{/*
  The closing movement of the page, not a sitemap.

  The ink field stays — it's the only dark surface on /work and /contact. What
  it gains: a periwinkle seam so it stops merging into the ink CtaClose band
  that precedes it, and a display closing line.

  The single large BrandMark that used to sit in the right-hand track is gone.
  CtaClose directly above already renders that exact logo as ASCII, so the page
  ended by showing the same artwork twice in a row. BrandWall says the name as
  a full-width drifting texture instead — rows in outline, alternating
  direction — which closes the page without repeating the mark.

  Motion is on the closing line only. [data-mv-watch] holds elements at
  opacity:0 until JS runs, and this is the last-resort contact surface on every
  page — the link columns stay visible whether the script runs or not.

  Braces, not <!-- -->: Astro emits HTML comments to every page, JSX ones it
  strips at build.
*/}
<footer class="ft" aria-labelledby="ft-contact-heading">
  <span class="ft-seam mv-wipe" data-mv-watch aria-hidden="true"></span>

  <div class="ft-inner">
    <p class="display ft-line mv-rise" data-mv-watch>
      Small studio. Flat fees. Sites we'd <em>put our names on</em>.
    </p>

    <div class="ft-grid">
      <div class="ft-col">
        <h2 class="ft-label">Studio</h2>
        <ul>
          {studioLinks.map((l) => (<li><a href={l.href}>{l.label}</a></li>))}
        </ul>
      </div>

      <div class="ft-col">
        <h2 class="ft-label">Services</h2>
        <ul>
          {serviceLinks.map((l) => (<li><a href={l.href}>{l.label}</a></li>))}
        </ul>
      </div>

      <div class="ft-col">
        <h2 id="ft-contact-heading" class="ft-label">Contact</h2>
        {/*
          Phone, email and place are plain text nodes on purpose — this column
          is the site's NAP block, and a crawler only counts what it can read.
          Nothing here is CSS content or an image.

          The number is formatted for a human, (949) 529-6035, and dialled as
          E.164 in the href so a phone doesn't have to guess the country.

          "Orange County, CA" rather than the city: the business is registered
          in Orange and works across the county, so it's both the truer answer
          and the phrase people actually search.
        */}
        <ul>
          <li><a href="tel:+19495296035">(949) 529-6035</a></li>
          <li><a href="mailto:fwddesignconsulting@gmail.com">fwddesignconsulting@gmail.com</a></li>
          <li><span class="ft-static">Orange County, CA</span></li>
          {/*
            The one social link on the site, and it lives here rather than in a
            row of its own: LinkedIn is how a prospective client checks a studio
            is real, which is the same job as the phone number sitting above it.
            A separate social row would also mean a fourth block competing with
            the legal line for the space under the grid.

            The glyph is aria-hidden and the visible word carries the accessible
            name, so this reads as "LinkedIn" out of context rather than as an
            unnamed link. It paints in currentColor, so it inherits the 0.78
            white and turns periwinkle on hover along with the text.
          */}
          <li>
            <a class="ft-social" href="https://www.linkedin.com/company/forward-design-consulting-llc" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z" />
              </svg>
              LinkedIn
            </a>
          </li>
          <li><a href="/contact">Start a project</a></li>
        </ul>
      </div>
    </div>

    <div class="ft-legal">
      <a href="/privacy">Privacy Policy</a>
      <a href="/terms">Terms of Service</a>
      {/* WCAG 2.2.2 — the wall drifts forever, so it needs a stop that does
          not depend on an OS setting. Sits with the legal line because that is
          the last row of real controls on the page. */}
      <button type="button" class="ft-pause" data-ft-pause>Pause</button>
    </div>
  </div>

  {/* Absolutely positioned inside .ft, behind .ft-inner (which carries
      z-index: 1). It fills the whole footer and masks itself down to the
      right-hand side, so it reads as a graphic occupying the space the old
      logo held — while the links keep the full width of the grid rather than
      being squeezed into a column beside it. */}
  <BrandWall />
</footer>

<style>
  .ft {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-ink);
    color: rgba(255,255,255,0.78);
    padding-block: clamp(2.5rem, 5vh, 3.5rem) clamp(1.75rem, 3.5vh, 2.5rem);
  }
  /* Lights the opposite corner to .cta-band::before (which lights top-centre),
     so two ink bands stacked on each other read as two planes. */
  .ft::before {
    content: "";
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 70% 60% at 10% 100%, rgb(20 70 103 / 0.40), transparent 70%);
    pointer-events: none; z-index: 0;
  }

  /* The seam. 1px of periwinkle is enough to read as deliberate. */
  .ft-seam {
    position: absolute; top: 0; left: 0; right: 0;
    height: 1px; z-index: 3;
    background: linear-gradient(90deg,
      rgb(142 148 184 / 0.15),
      rgb(142 148 184 / 0.55) 22%,
      rgb(142 148 184 / 0.55) 78%,
      rgb(142 148 184 / 0.15));
    transform-origin: left;
  }

  .ft-inner {
    position: relative; z-index: 1;
    width: 100%;
    padding-inline: var(--pad-x);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.75rem, 3.5vh, 2.5rem);
  }
  /* Two tracks, as before the wall existed: everything readable in column one,
     column two left deliberately empty for the graphic. The wall is painted by
     an absolutely positioned sibling rather than placed in this track — but
     the track is what reserves the room, so the two can never overlap however
     long a link label gets.

     The empty track is sized as a PERCENTAGE, because the thing it has to stay
     clear of is itself proportional: the wall's mask starts lifting at 62% of
     the footer's width, so a fixed rem track fell further and further behind
     the fade as the viewport grew (content ran 152px into the field at 1440px
     and 608px at 2560px). 36% pairs with that 62% stop — the content always
     ends before the wall begins to paint, at every width, while still leaving
     the contact column wide enough to keep the email address on one line. */
  @media (min-width: 900px) {
    .ft-inner {
      grid-template-columns: minmax(0, 1fr) 36%;
      column-gap: clamp(2rem, 4vw, 4rem);
    }
    .ft-line,
    .ft-grid,
    .ft-legal { grid-column: 1; }
  }

  .ft-line {
    margin: 0;
    font-size: var(--text-step-3);
    line-height: 1.06;
    color: var(--color-paper);
    max-width: 20ch;
  }
  .ft-line em {
    font-style: italic;
    color: var(--color-periwinkle);
  }

  .ft-grid {
    display: grid; gap: 2.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) {
    .ft-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(2rem, 5vw, 4rem);
    }
  }

  .ft-label {
    font-family: var(--font-mono);
    font-size: var(--text-step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
    font-weight: 500;
    margin: 0 0 0.85rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid rgba(255,255,255,0.10);
  }
  .ft-col ul {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: 0.55rem;
  }
  .ft-col a, .ft-static {
    font-family: var(--font-sans);
    font-size: var(--text-step--1);
    color: rgba(255,255,255,0.78);
    transition: color 200ms var(--ease-soft);
    /* The email is ~28 unbroken characters and the columns get to ~190px
       around 700-800px wide. Without this it clips against .ft's overflow. */
    overflow-wrap: anywhere;
  }
  /* Same underline-wipe the nav links use. */
  .ft-col a { position: relative; width: fit-content; max-width: 100%; }
  .ft-col a::after {
    content: "";
    position: absolute; left: 0; right: 0; bottom: -3px;
    height: 1px; background: var(--color-periwinkle);
    transform: scaleX(0); transform-origin: left;
    transition: transform 380ms var(--ease-out-expo);
  }
  .ft-col a:hover { color: var(--color-periwinkle); }
  .ft-col a:hover::after { transform: scaleX(1); }
  .ft-col a:focus-visible {
    outline: 2px solid var(--color-periwinkle);
    outline-offset: 3px;
    border-radius: 2px;
  }
  .ft-static { color: rgba(255,255,255,0.55); }

  /* Only what's needed to sit a glyph next to a word: inline-flex so the two
     stay on one line, and an em-sized icon so it tracks --text-step--1 instead
     of needing its own number. Everything else — colour, the underline wipe,
     the focus ring — is already inherited from .ft-col a. */
  .ft-social {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .ft-social svg {
    width: 0.95em;
    height: 0.95em;
    flex: none;
  }

  /* Legal line — sits below the link grid, not a fourth column. */
  .ft-legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255,255,255,0.10);
  }
  .ft-legal a {
    position: relative;
    width: fit-content;
    font-family: var(--font-sans);
    font-size: var(--text-step--2);
    color: rgba(255,255,255,0.5);
    transition: color 200ms var(--ease-soft);
  }
  .ft-legal a::after {
    content: "";
    position: absolute; left: 0; right: 0; bottom: -3px;
    height: 1px; background: var(--color-periwinkle);
    transform: scaleX(0); transform-origin: left;
    transition: transform 380ms var(--ease-out-expo);
  }
  .ft-legal a:hover { color: var(--color-periwinkle); }
  .ft-legal a:hover::after { transform: scaleX(1); }
  .ft-legal a:focus-visible {
    outline: 2px solid var(--color-periwinkle);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* Same pill vocabulary as the marquee and CtaClose controls, in the
     footer's own ink tones. Pushed to the end of the line so the two legal
     links stay together as a pair. */
  .ft-pause {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--text-step--2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
    background: transparent;
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    /* PAUSE and PLAY differ in width; a fixed slot stops the pill resizing
       under the cursor when it is clicked. */
    min-width: 7ch;
    text-align: center;
    cursor: pointer;
    transition: color 200ms var(--ease-soft), border-color 200ms var(--ease-soft);
  }
  .ft-pause:hover { color: var(--color-paper); border-color: var(--color-periwinkle); }

  @media (prefers-reduced-motion: reduce) {
    /* Nothing left to pause, so the control would be dead weight. */
    .ft-pause { display: none; }
  }

  @media (max-width: 699px) {
    .ft-line { max-width: 16ch; }
  }
</style>

<script is:inline>
  // The label carries the state instead of aria-pressed: for a pause control
  // the accessible name IS the state, and doing both announces contradictions
  // like "Play, pressed". Matches the marquee and CtaClose controls.
  (() => {
    if (window.__ftPause) return; // one initialiser per page
    window.__ftPause = true;
    document.querySelectorAll("[data-ft-pause]").forEach((btn) => {
      const ft = btn.closest(".ft");
      btn.addEventListener("click", () => {
        btn.textContent = ft.classList.toggle("is-paused") ? "Play" : "Pause";
      });
    });
  })();
</script>
