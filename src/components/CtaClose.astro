---
/* ----------------------------------------------------------------------------
   CtaClose — the shared closing section.

   Replaces three different treatments that all did the same three things
   (heading, paragraph, button): .cta-band-light on home and .cta-band /
   .cta-band-marks on services and studio.

   Type-led on purpose. The pages above this already carry five hand-built
   fake-UI visuals; a sixth immediately before the footer would dilute the
   device rather than extend it. So the weight goes into the headline, with
   one cycling word as the only moving part.

   `swap` is fixed at FOUR words — the keyframe windows below are 25% each.
   Pass the trailing punctuation with each word ("side project?"), not after
   the span: the words share one inline-grid cell so the slot is as wide as
   the longest entry, and keeping the "?" inside means the leftover space
   lands as invisible trailing whitespace at the end of a left-aligned line.
   -------------------------------------------------------------------------- */
interface Props {
  eyebrow?: string;
  /** Text before the cycling word. */
  lead: string;
  /** Exactly four words, each carrying its own trailing punctuation. */
  swap?: string[];
  /** Static ending, used when `swap` is omitted. */
  tail?: string;
  lede: string;
  ctaLabel?: string;
  ctaHref?: string;
  note?: string;
  ticker?: string[];
  tone?: "light" | "ink";
  /** ASCII mark colour. Defaults to the tone's accent; "paper" when the
   *  preceding section already leans on the accent and the mark needs to
   *  separate from it. */
  mark?: "accent" | "paper";
}

const {
  eyebrow,
  lead,
  swap,
  tail,
  lede,
  ctaLabel = "Start a project",
  ctaHref = "/contact",
  note,
  ticker = [],
  tone = "light",
  mark = "accent",
} = Astro.props;

const words = swap?.slice(0, 4) ?? [];

// The ticker scrolls by exactly one copy of `ticker` per cycle, so the strip
// only reads as continuous while the copies that remain to the right of the
// window still cover it: (reps - 1) * copyWidth >= container width. Two copies
// (what this used to render) satisfies that only when a single copy is already
// wider than the viewport, which these four-item lists never are — so the strip
// drained to empty on the way through and snapped back at the loop point.
//
// The section is full-bleed with --pad-x capped at 4rem, so the widest
// container to cover is roughly the widest viewport; 3400px covers ultrawides.
// Copy width is estimated from the text: ~8.5px per character at
// --text-step--2 in the mono face, plus ~48px per item for the dot and the two
// 1.25rem gaps around it. The estimate runs slightly under a real measurement,
// which errs toward one copy too many rather than one too few.
const TICKER_COVER = 3400;
const tickerCopyPx = ticker.reduce((n, t) => n + t.length * 8.5 + 48, 0);
const tickerReps = tickerCopyPx > 0
  ? Math.max(2, Math.ceil(TICKER_COVER / tickerCopyPx) + 1)
  : 0;
// Unique per instance — a fixed id would collide (and break aria-labelledby)
// the moment two of these render on one page, as the preview route does.
const titleId = `ctc-title-${Math.random().toString(36).slice(2, 8)}`;
---

<section class:list={["ctc", `ctc-${tone}`]} aria-labelledby={titleId}>
  <div class="ctc-grid" aria-hidden="true"></div>

  <div class="ctc-inner">
    <div class="ctc-main">
    {eyebrow && (
      <span class="ctc-eyebrow mv-rise" data-mv-watch>
        <span class="ctc-eyebrow-bar"></span>{eyebrow}
      </span>
    )}

    <h2 id={titleId} class="display ctc-title mv-rise" data-mv-watch>
      {lead}{" "}
      {words.length > 0 ? (
        <span class="ctc-swap" style={`--ctc-count:${words.length}`}>
          {words.map((w, i) => (
            <span class="ctc-swap-item" style={`--i:${i}`} aria-hidden={i > 0 ? "true" : undefined}>{w}</span>
          ))}
        </span>
      ) : <span class="ctc-tail">{tail}</span>}
    </h2>

    <p class="ctc-lede mv-rise" data-mv-watch>{lede}</p>

    <div class="ctc-actions mv-rise" data-mv-watch>
      <a href={ctaHref} class="btn btn-primary ctc-btn">
        {ctaLabel} <span class="arrow" aria-hidden="true">→</span>
      </a>
      {note && (
        <span class="ctc-note">
          <span class="ctc-dot" aria-hidden="true"></span>{note}
        </span>
      )}
    </div>
    </div>

    <pre class:list={["ctc-ascii", mark === "paper" && "is-paper"]} data-ascii aria-hidden="true"></pre>

    {/* One row for everything that never stops moving: the ticker, and the
        button that halts it *and* the cycling word above. The button has to be
        a sibling of .ctc-ticker rather than a child — the ticker's edge mask
        would fade the control out along with the text. */}
    {(ticker.length > 0 || words.length > 0) && (
      <div class="ctc-motion" style={`--ctc-reps:${tickerReps}`}>
        {ticker.length > 0 && (
          <div class="ctc-ticker" aria-hidden="true">
            <div class="ctc-ticker-track">
              {Array.from({ length: tickerReps }, () => (
                <div class="ctc-ticker-copy">
                  {ticker.map((t) => (
                    <><span>{t}</span><span class="dot">●</span></>
                  ))}
                </div>
              ))}
            </div>
          </div>
        )}
        <button type="button" class="ctc-pause" data-ctc-pause>Pause</button>
      </div>
    )}
  </div>
</section>

<style>
  .ctc {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    /* Page sections run clamp(4rem, 9vh, 7rem). This is the closing beat, so it
       gets one step more air rather than the 13vh it used to take: at 900px
       tall that was 117px against a neighbouring section's 81px, ~45% taller,
       which read as a gap rather than as emphasis. 10.5vh lands ~15% above its
       neighbours — deliberate, not disconnected. */
    padding-block: clamp(4.5rem, 10.5vh, 7.5rem);
  }
  .ctc-light {
    --ctc-fg: var(--color-navy);
    --ctc-soft: var(--color-fg-soft);
    --ctc-muted: var(--color-fg-muted);
    --ctc-accent: var(--color-blue);
    --ctc-line: var(--color-line);
    --ctc-rule: rgb(20 70 103 / 0.06);
    background: var(--color-bg-soft);
    border-bottom: 1px solid var(--color-line);
  }
  .ctc-ink {
    --ctc-fg: var(--color-paper);
    --ctc-soft: rgba(255,255,255,0.80);
    --ctc-muted: rgba(255,255,255,0.52);
    --ctc-accent: var(--color-periwinkle);
    --ctc-line: rgba(255,255,255,0.14);
    --ctc-rule: rgba(255,255,255,0.05);
    background: var(--color-ink);
    color: var(--ctc-fg);
  }
  .ctc-ink::before {
    content: "";
    position: absolute; inset: 0; z-index: 0;
    background: radial-gradient(ellipse 70% 60% at 85% 0%, rgb(142 148 184 / 0.14), transparent 70%);
    pointer-events: none;
  }

  /* ------------------------------------------------------------------
     ASCII render of the fwd. mark. The logo is rasterised to a character
     grid on the client and then shimmers — a few cells swap to a
     neighbouring ramp character each tick, so it reads as a live terminal
     rather than a static texture. Sits behind the grid and the type.
     Empty until JS fills it, so it degrades to the plain grid.
     ------------------------------------------------------------------ */
  /* Its own grid column below — never underneath the type. Hidden entirely
     under 1100px, where there is no room for a column beside the headline
     (and no cursor to drive the ripple either). */
  .ctc-ascii {
    display: none;
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(9px, 0.93vw, 13.5px);
    line-height: 0.62;
    white-space: pre;
    overflow: hidden;
    color: var(--ctc-accent);
    opacity: 0.30;
    user-select: none;
    -webkit-mask-image: radial-gradient(ellipse 92% 92% at 50% 50%, #000 45%, transparent 92%);
    mask-image: radial-gradient(ellipse 92% 92% at 50% 50%, #000 45%, transparent 92%);
  }
  .ctc-light .ctc-ascii { opacity: 0.20; }
  /* mark="paper" — for pages where the section above already leans on the
     accent, so a periwinkle mark would read as more of the same. */
  .ctc-ascii.is-paper { color: var(--color-paper); opacity: 0.24; }

  /* Faint hairline grid, faded out at the edges — same device as the hero
     showcase panel, at a much lower level so type stays the subject. */
  .ctc-grid {
    position: absolute; inset: 0; z-index: 0;
    background-image:
      linear-gradient(var(--ctc-rule) 1px, transparent 1px),
      linear-gradient(90deg, var(--ctc-rule) 1px, transparent 1px);
    background-size: 46px 46px;
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 30% 50%, #000 10%, transparent 80%);
    mask-image: radial-gradient(ellipse 80% 70% at 30% 50%, #000 10%, transparent 80%);
    pointer-events: none;
  }

  .ctc-inner {
    position: relative; z-index: 1;
    width: 100%;
    padding-inline: var(--pad-x);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .ctc-main {
    display: flex; flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    min-width: 0;
  }
  /* Two tracks: type on the left, the ASCII mark in its own column on the
     right. Structurally impossible for them to overlap at any width. */
  @media (min-width: 1100px) {
    .ctc-inner {
      /* Max stays at the original 36rem — on a wide screen the mark was
         limited by the box's *height*, not this track, so the 4:3 ratio below
         is what makes it bigger and the type column is untouched. The steeper
         vw term is for 1100-1300px, where the track was the limit; min() keeps
         38rem back for the gap and the type so it can't eat the headline. */
      grid-template-columns: minmax(0, 1fr) clamp(17rem, min(49.5vw, 100% - 38rem), 36rem);
      column-gap: clamp(2rem, 4vw, 4.5rem);
      align-items: center;
    }
    .ctc-main { grid-column: 1; grid-row: 1; }
    /* Ratio rather than min-height, and this is what actually made the mark
       bigger. The fit is bounded by both axes of this box; with the old
       square raster and a box that stretched to whatever the type column
       happened to be (~390px), the mark was pinned to that height and used
       barely two thirds of its own column. build() now rasterises the
       wordmark band alone, so a 4:3 box fits it at full width — ~1.5x the old
       mark, with the font-size above scaled to match so the character texture
       scales with it instead of the grid just getting finer.

       The mark still needs slack above and below or the letterforms run into
       the element edge and get clipped; at 4:3 it lands at ~78% of the box
       height, which is the air the square raster used to give it for free.
       Centred, not stretched, so it tracks the type block. */
    .ctc-ascii {
      display: block;
      grid-column: 2; grid-row: 1;
      align-self: center;
      aspect-ratio: 4 / 3;
    }
    .ctc-motion { grid-column: 1 / -1; grid-row: 2; }
  }

  .ctc-eyebrow {
    display: inline-flex; align-items: center; gap: 12px;
    font-family: var(--font-mono);
    font-size: var(--text-step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ctc-muted);
  }
  .ctc-eyebrow-bar { width: 24px; height: 1px; background: var(--ctc-accent); }

  .ctc-title {
    margin: 0;
    font-size: var(--text-step-5);
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: var(--ctc-fg);
    max-width: 17ch;
    /* The swapping word changes the last line's width; balancing would make
       the whole heading re-wrap on every swap. */
    text-wrap: initial;
  }

  /* Static ending carries the same accent the cycling words do, so a page
     without a swap still gets the one-italic-accent-per-headline device. */
  .ctc-tail {
    font-style: italic;
    color: var(--ctc-accent);
    font-variation-settings: "opsz" 144;
  }

  /* All four words share one grid cell, so the slot is as wide as the
     longest and nothing above it reflows when the word changes. */
  .ctc-swap {
    display: inline-grid;
    vertical-align: top;
  }
  .ctc-swap-item {
    grid-area: 1 / 1;
    justify-self: start;
    white-space: nowrap;
    font-style: italic;
    color: var(--ctc-accent);
    font-variation-settings: "opsz" 144;
    opacity: 0;
    animation: ctcSwap 12s var(--ease-soft) infinite;
    animation-delay: calc(var(--i) * 12s / var(--ctc-count));
  }
  @keyframes ctcSwap {
    0%   { opacity: 0; transform: translateY(0.28em); }
    2%   { opacity: 1; transform: translateY(0); }
    23%  { opacity: 1; transform: translateY(0); }
    25%  { opacity: 0; transform: translateY(-0.28em); }
    100% { opacity: 0; transform: translateY(0.28em); }
  }

  .ctc-lede {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 300; font-style: italic;
    font-size: var(--text-step-1);
    line-height: 1.4;
    color: var(--ctc-soft);
    max-width: 46ch;
    text-wrap: pretty;
    font-variation-settings: "opsz" 60;
  }

  .ctc-actions {
    display: flex; align-items: center; flex-wrap: wrap;
    /* No margin-top: the 1.5rem .ctc-main gap already separates this from the
       lede, and the extra 0.5rem on top of it made the button sit at an
       arbitrary 2rem that matched no other step in the section. */
    gap: 1rem 1.5rem;
  }
  .ctc-note {
    display: inline-flex; align-items: center; gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--text-step--2);
    letter-spacing: 0.06em;
    color: var(--ctc-muted);
  }
  .ctc-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: #2bb673;
    animation: mvPulseRing 2.4s var(--ease-soft) infinite;
  }
  .ctc-ink .ctc-btn {
    background: var(--color-paper);
    color: var(--color-navy);
    border-color: var(--color-paper);
  }
  .ctc-ink .ctc-btn:hover {
    background: var(--color-periwinkle);
    border-color: var(--color-periwinkle);
    color: var(--color-navy);
  }

  /* The rule and the spacing above it belong to the row, not the ticker, so
     they still span the full width now that the button shares the line. */
  .ctc-motion {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    width: 100%;
    margin-top: clamp(2rem, 5vh, 3.5rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--ctc-line);
  }
  .ctc-ticker {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 13%, #000 87%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 13%, #000 87%, transparent);
  }
  /* max-content, not inline-flex's shrink-to-fit: the keyframe below is a
     percentage of this box, so the box has to measure the content rather than
     the container it overflows. */
  .ctc-ticker-track {
    display: flex;
    width: max-content;
    animation: ctcTicker 34s linear infinite;
    font-family: var(--font-mono);
    font-size: var(--text-step--2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ctc-muted);
  }
  .ctc-ticker-track .dot { color: var(--ctc-accent); font-size: 0.6em; }
  /* 4 duplicated copies (not 2) so the track reliably overflows the row even
     with a short 4-phrase ticker array — with only 2 copies, one copy's
     width often didn't exceed the row, so the "loop" had nothing to scroll
     through and just slid the too-narrow content sideways and snapped back.
     Shift by 1/4 (one copy width), matching the 4x duplication. */
  @keyframes ctcTicker { to { transform: translateX(-25%); } }
  /* padding-right matches the gap so the join between two copies is spaced
     exactly like every other join inside one. */
  .ctc-ticker-copy {
    display: flex; align-items: center; flex: none;
    gap: 1.25rem;
    padding-right: 1.25rem;
    white-space: nowrap;
  }
  .ctc-ticker-copy .dot { color: var(--ctc-accent); font-size: 0.6em; }

  /* WCAG 2.2.2 — the cycling word and the ticker both run forever, and
     prefers-reduced-motion only covers people who set it. One control stops
     both: they are the only moving parts of this section, so a second button
     would only ask the reader to work out which is which. Sits at the end of
     the ticker line, in the zone the mask has already faded out, so it takes
     nothing away from the strip. Styled after .walkthrough-controls button on
     /services, in this section's tone tokens rather than that band's fixed
     white. Focus ring comes from the global :focus-visible rule. */
  .ctc-pause {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--text-step--2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ctc-muted);
    background: transparent;
    border: 1px solid var(--ctc-line);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    /* PAUSE and PLAY differ in width; a fixed slot stops the pill resizing
       under the cursor when it is clicked. */
    min-width: 7ch;
    text-align: center;
    cursor: pointer;
    transition: color 200ms var(--ease-soft), border-color 200ms var(--ease-soft);
  }
  .ctc-pause:hover { color: var(--ctc-fg); border-color: var(--ctc-accent); }

  /* Freezes both animations mid-flight rather than resetting them, so the word
     showing when you press Pause is the word that stays. */
  .ctc.is-paused .ctc-swap-item,
  .ctc.is-paused .ctc-ticker-track { animation-play-state: paused; }
  /* One copy, exactly — the copies are identical, so 100%/reps is one of them
     whatever they measure. A hard -50% only lands on a copy boundary when
     there are two of them, and even then it is off by the trailing gap.
     Distance travelled per cycle is one copy either way, so the 34s duration
     is the same speed regardless of how many copies get rendered. */
  @keyframes ctcTicker { to { transform: translateX(calc(-100% / var(--ctc-reps))); } }

  /* The global reduce rule collapses animation-duration to 0.01ms, which would
     snap every swap word to its final keyframe — opacity 0 — and leave the
     headline with no ending. Pin the first word visible instead. */
  @media (prefers-reduced-motion: reduce) {
    .ctc-swap-item { animation: none; opacity: 0; transform: none; }
    .ctc-swap-item:first-child { opacity: 1; }
    .ctc-ticker-track { animation: none; }
    .ctc-dot { animation: none; }
    /* Nothing left to pause, so the control would be dead weight. */
    .ctc-pause { display: none; }
  }

  @media (max-width: 700px) {
    .ctc-title { font-size: var(--text-step-4); max-width: 14ch; }
    .ctc-ascii { opacity: 0.13; }
    /* vh-based padding is at its most generous on a tall phone, exactly where
       there is least room for it — 13vh of an 844px viewport was 110px at each
       end against a neighbouring section's 76px. 9.5vh lands at ~80px: still
       the tallest block on the page, without the hole. */
    .ctc { padding-block: clamp(3.5rem, 9.5vh, 6rem); }
    .ctc-main { gap: 1.25rem; }
    .ctc-motion { margin-top: clamp(1.75rem, 4vh, 2.5rem); }
  }

  @media (max-width: 480px) {
    /* The button and the note stack at this width; a 1rem row gap between two
       items of such different weight reads as a stray line, so tighten it and
       let the button own the block. */
    .ctc-actions { gap: 0.85rem 1.25rem; }
    .ctc-btn { width: 100%; justify-content: center; }
    /* Pause pill would otherwise squeeze the ticker to a couple of words. */
    .ctc-motion { gap: 0.75rem; padding-top: 1rem; }
  }
</style>

<script is:inline>
  // Pause control. The label carries the state instead of aria-pressed: for a
  // pause control the accessible name IS the state, and doing both announces
  // contradictions like "Play, pressed". Scoped to the button's own section so
  // two of these on one page (as the preview route renders) stay independent.
  (() => {
    if (window.__ctcPause) return; // one initialiser per page, not per instance
    window.__ctcPause = true;
    document.querySelectorAll("[data-ctc-pause]").forEach((btn) => {
      const section = btn.closest(".ctc");
      btn.addEventListener("click", () => {
        btn.textContent = section.classList.toggle("is-paused") ? "Play" : "Pause";
      });
    });
  })();
</script>

<script is:inline>
  // ASCII render of the brand mark. Rasterises /assets/fwd-logo.svg into a
  // character grid, then composites two things over that base every frame:
  // a slow rolling shimmer, and a ripple that radiates from the cursor.
  //
  // The base grid is immutable and each frame is composed from it, rather
  // than mutating cells in place — a wave needs to read the original density
  // of every cell it passes over, which in-place mutation destroys.
  //
  // No dependencies. Falls back to the plain hairline grid on any failure.
  (() => {
    if (window.__ctcAscii) return; // one initialiser per page, not per instance
    window.__ctcAscii = true;

    const RAMP = " .:-=+*#%@";
    const MAX = RAMP.length - 1;
    const FPS = 24;
    const LIFE = 1150;   // ms a ripple lives for
    const SPEED = 0.055; // characters per ms the ring expands
    const BAND = 4.5;    // half-width of the crest, in characters
    const EMIT = 110;    // min ms between ripples while the cursor moves
    const EMIT_D = 5;    // min characters moved before a new ripple
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const measureCell = (el) => {
      const probe = document.createElement("span");
      probe.textContent = "0".repeat(50);
      probe.style.cssText = "position:absolute;visibility:hidden;white-space:pre;";
      el.appendChild(probe);
      const w = probe.getBoundingClientRect().width / 50;
      probe.remove();
      const lh = parseFloat(getComputedStyle(el).lineHeight);
      return { w, h: lh || w };
    };

    const build = (el, img) => {
      const box = el.getBoundingClientRect();
      const cell = measureCell(el);
      if (!cell.w || !box.width) return null;

      const cols = Math.max(8, Math.floor(box.width / cell.w));
      const rows = Math.max(4, Math.floor(box.height / cell.h));

      // Fit the logo inside the grid, preserving its aspect against the
      // non-square character cell.
      // The element is now its own column, so the mark just fits its own box.
      //
      // Only the wordmark band of the source is rasterised. The artwork is a
      // 160x160 square but the mark itself sits between y 33.6 and y 127.4, so
      // a fifth of the square is empty above and below. Those bands are
      // invisible either way — they rasterise to spaces — but they count
      // against the fit: with them included the mark only reaches full width
      // when the box is as tall as it is wide. Cropping them is what lets a
      // wide, short column render the mark at the column's full width.
      //
      // Cropped by drawing the whole square oversized and offset up, not with
      // drawImage's source-rect form: the svg carries no width/height, so
      // naturalWidth/Height report the 150px default object size rather than
      // the viewBox, and Chrome scales a source rect given in those units into
      // a corner of the destination. The 5-arg form takes no source units and
      // is unaffected.
      const CROP_Y = 0.2038;  // 32.6 / 160
      const CROP_H = 0.5925;  // 94.8 / 160
      const imgAR = img.naturalWidth / (img.naturalHeight * CROP_H);
      const cellAR = cell.w / cell.h;
      let dw = cols;
      let dh = Math.round(dw / imgAR * cellAR);
      if (dh > rows) { dh = rows; dw = Math.round(rows * imgAR / cellAR); }

      const cv = document.createElement("canvas");
      cv.width = dw; cv.height = dh;
      const ctx = cv.getContext("2d", { willReadFrequently: true });
      const fullH = dh / CROP_H;
      ctx.drawImage(img, 0, -CROP_Y * fullH, dw, fullH);
      const data = ctx.getImageData(0, 0, dw, dh).data;

      // Rounded, not floored: the grid is ~50 rows now rather than ~90, so a
      // floored half-row is a visible bias upward against the box's centre.
      const offX = Math.round((cols - dw) / 2);
      const offY = Math.round((rows - dh) / 2);

      // base[] holds the ramp index per cell, -1 for empty. live[] indexes only
      // the cells that are part of the mark, so the per-frame loop touches
      // those and nothing else.
      const base = new Int8Array(rows * cols).fill(-1);
      const live = [];

      for (let y = 0; y < dh; y++) {
        for (let x = 0; x < dw; x++) {
          const a = data[(y * dw + x) * 4 + 3] / 255;
          if (a < 0.08) continue;
          // The mark is a solid shape, so raw alpha would resolve almost every
          // interior cell to the densest character and read as a block. A
          // deterministic per-cell offset breaks the fill into actual texture.
          const dither = ((x * 7 + y * 13) % 5) / 5;
          const v = Math.max(1, Math.min(MAX, Math.round(a * MAX - dither * 2.6)));
          const at = (y + offY) * cols + (x + offX);
          base[at] = v;
          live.push(at);
        }
      }
      return { rows, cols, base, live, cell, buf: new Array(rows * cols).fill(" ") };
    };

    const compose = (el, st, t, ripples) => {
      const { rows, cols, base, live, buf } = st;
      for (let i = 0; i < live.length; i++) {
        const at = live[i];
        const x = at % cols;
        const y = (at / cols) | 0;
        let v = base[at];

        // Slow rolling shimmer — deterministic, so no allocation or timers.
        v += Math.sin(x * 0.42 + y * 0.31 + t * 0.0016) * 0.55;

        // Each ripple is a single expanding ring, not a standing oscillation:
        // radius grows with age, the crest is a narrow band around it, and the
        // whole thing fades out as it travels. Cells outside the band cost one
        // comparison and nothing else.
        for (let k = 0; k < ripples.length; k++) {
          const rp = ripples[k];
          const age = t - rp.born;
          const r = age * SPEED;
          const dx = x - rp.x;
          const dy = y - rp.y;
          const off = Math.sqrt(dx * dx + dy * dy) - r;
          if (off < -BAND || off > BAND) continue;
          const crest = Math.cos((off / BAND) * 1.5707963);
          v += crest * crest * 4.4 * (1 - age / LIFE);
        }

        buf[at] = RAMP[v < 1 ? 1 : v > MAX ? MAX : Math.round(v)];
      }
      let s = "";
      for (let y = 0; y < rows; y++) {
        s += buf.slice(y * cols, (y + 1) * cols).join("");
        if (y < rows - 1) s += "\n";
      }
      el.textContent = s;
    };

    const animate = (el, st, section) => {
      if (!st.live.length) return;
      const ripples = [];
      let lastX = -999, lastY = -999, lastEmit = 0;
      let last = 0;

      // One ring per meaningful movement — throttled by both time and distance
      // so a fast sweep leaves a trail rather than a solid wall of rings.
      const onMove = (e) => {
        const now = performance.now();
        const r = el.getBoundingClientRect();
        const x = (e.clientX - r.left) / st.cell.w;
        const y = (e.clientY - r.top) / st.cell.h;
        const moved = Math.hypot(x - lastX, y - lastY);
        if (now - lastEmit < EMIT || moved < EMIT_D) return;
        lastEmit = now;
        lastX = x; lastY = y;
        ripples.push({ x, y, born: now });
        if (ripples.length > 6) ripples.shift();
      };
      section.addEventListener("mousemove", onMove, { passive: true });

      // Only run while the section is actually on screen. This sits at the
      // bottom of every page, so without this it would burn a frame budget
      // the entire time someone is reading the top of the page.
      let raf = null;
      let settled = false;
      const step = (ts) => {
        if (ts - last > 1000 / FPS) {
          last = ts;
          const now = performance.now();
          while (ripples.length && now - ripples[0].born > LIFE) ripples.shift();
          // Once every ring has died, stop repainting until something happens.
          if (ripples.length || !settled) {
            compose(el, st, ts, ripples);
            settled = ripples.length === 0;
          }
        }
        raf = requestAnimationFrame(step);
      };
      section.addEventListener("mousemove", () => { settled = false; }, { passive: true });

      if ("IntersectionObserver" in window) {
        new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && raf === null) {
              raf = requestAnimationFrame(step);
            } else if (!entry.isIntersecting && raf !== null) {
              cancelAnimationFrame(raf);
              raf = null;
              ripples.length = 0;
            }
          });
        }, { rootMargin: "200px" }).observe(section);
      } else {
        raf = requestAnimationFrame(step);
      }
    };

    const img = new Image();
    img.onload = () => {
      document.querySelectorAll("[data-ascii]").forEach((el) => {
        const section = el.closest(".ctc") || el.parentElement;
        let st = build(el, img);
        if (!st) return;
        compose(el, st, 0, -999, -999, 0);
        if (!reduce) animate(el, st, section);

        // Re-rasterise on resize; the grid is measured in characters, not pixels.
        let t = null;
        window.addEventListener("resize", () => {
          clearTimeout(t);
          t = setTimeout(() => {
            const next = build(el, img);
            if (!next) return;
            st.rows = next.rows; st.cols = next.cols;
            st.base = next.base; st.live = next.live;
            st.cell = next.cell; st.buf = next.buf;
            compose(el, st, performance.now(), -999, -999, 0);
          }, 220);
        }, { passive: true });
      });
    };
    img.src = "/assets/fwd-logo.svg";
  })();
</script>
